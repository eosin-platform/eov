#!/bin/sh
# eov's bundled libraries are found through the RUNPATH that build.sh sets on
# usr/bin/eov ($ORIGIN/../lib) and on every bundled library ($ORIGIN), not
# through LD_LIBRARY_PATH: that would leak into every program eov starts
# (xdg-open, file managers, browsers) and make them load eov's copies.
set -eu

HERE="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"

exec "$HERE/usr/bin/eov" "$@"
