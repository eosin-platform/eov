[submodule "packaging/flatpak/flatpak-builder-tools"]
	path = packaging/flatpak/flatpak-builder-tools
	url = https://github.com/flatpak/flatpak-builder-tools.git
[submodule "plugins/annotations"]
	path = plugins/annotations
	url = https://github.com/eosin-platform/eov-annotations-plugin.git
[submodule "plugins/eovae/HistoVAE"]
	path = plugins/eovae/HistoVAE
	url = https://github.com/sablecrestlabs/HistoVAE.git
[submodule "plugins/eov-gamepad-plugin"]
	path = plugins/gamepad
	url = https://github.com/eosin-platform/eov-gamepad-plugin.git
[submodule "packaging/homebrew-eov"]
	path = packaging/homebrew-eov
	url = https://github.com/eosin-platform/homebrew-eov.git
