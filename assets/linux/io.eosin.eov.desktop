[Desktop Entry]
Type=Application
Version=1.0
Name=eov
GenericName=Whole-slide image viewer
Comment=View whole-slide images with OpenSlide-powered tile rendering
# %U: eov:// links need URLs, and eov decodes the file:// URIs file managers
# pass (GIO turns files on gvfs mounts into file:// URIs of local paths).
Exec=eov %U
Icon=io.eosin.eov
Terminal=false
StartupNotify=true
StartupWMClass=io.eosin.eov
Categories=Science;Graphics;Viewer;
Keywords=whole-slide;wsi;pathology;microscopy;openslide;microbiology
# The slide formats of io.eosin.eov.xml, TIFF and DICOM, and eov:// links.
MimeType=image/x-aperio-svs;image/x-hamamatsu-ndpi;image/x-hamamatsu-vms;image/x-hamamatsu-vmu;image/x-leica-scn;image/x-mirax;image/x-sakura-svslide;image/x-ventana-bif;image/x-zeiss-czi;image/tiff;application/dicom;image/x-bigtiff;x-scheme-handler/eov;
