#: app/src/processing_text.rs:79
msgctxt "Stain"
msgid "Elastic"
msgstr "Fibre elastiche"

#. Translators: a staining method of histology (for mucins).
#: app/src/processing_text.rs:81
msgctxt "Stain"
msgid "Alcian blue"
msgstr "Alcian blu"

#. Translators: a staining method of histology (for iron), named
#. after a person.
#: app/src/processing_text.rs:84
msgctxt "Stain"
