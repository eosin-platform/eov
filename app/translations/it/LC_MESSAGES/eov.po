#: app/src/quantify_panel.rs:319
msgid "H-score (0–300)"
msgstr "H-score (0–300)"

#: app/src/quantify_panel.rs:321
msgid "Mean {} concentration"
msgstr "Concentrazione media di {}"

#: app/src/quantify_panel.rs:349
msgid "Open a slide to quantify a stain"
msgstr "Apri un vetrino per quantificare una colorazione"

#. Translators: R is the key of the region-of-interest tool.
#: app/src/quantify_panel.rs:355
msgid "Draw a region of interest first (R), then quantify the stain in it"
msgstr ""
"Disegna prima una regione di interesse (R), poi quantifica la colorazione al "
"suo interno"

#. Translators: the region's size in level-0 pixels, then the
#. pyramid level it is read at, its size there and the pixel size.
#: app/src/quantify_panel.rs:436
msgid ""
"The region of interest, {width} × {height} px, read at level {level} "
"({level_width} × {level_height} px, {mpp} µm/px)."
msgstr ""
"La regione di interesse, {width} × {height} px, letta al livello {level} "
"({level_width} × {level_height} px, {mpp} µm/px)."

#: app/src/quantify_panel.rs:445
msgid ""
"The region of interest, {width} × {height} px, read at level {level} "
"({level_width} × {level_height} px)."
msgstr ""
"La regione di interesse, {width} × {height} px, letta al livello {level} "
"({level_width} × {level_height} px)."

#: app/src/quantify_panel.rs:453
msgid "Quantify Stain · {}"
msgstr "Quantifica colorazione · {}"

#: app/src/quantify_panel.rs:474
msgid "Reading the region…"
msgstr "Lettura della regione…"

#: app/src/quantify_panel.rs:550 app/src/quantify_panel.rs:714
msgid "Could not quantify the stain"
msgstr "Impossibile quantificare la colorazione"

#: app/src/quantify_panel.rs:564
msgid "Quantifying the stain"
msgstr "Quantificazione della colorazione"

#: app/src/quantify_panel.rs:623
msgid ""
"the region is {width} × {height} pixels at the slide's coarsest level "
"{level}; quantify a smaller region"
msgstr ""
"la regione misura {width} × {height} pixel anche al livello a risoluzione "
