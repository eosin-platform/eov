#: app/src/update/plugins.rs:606
msgid ""
"'{id}' is not an official plugin in the eov {version} catalog (official "
"plugins: none)."
msgstr "‏«{id}» افزونهٔ رسمی در فهرست eov {version} نیست (افزونه‌های رسمی: هیچ)."

#. Translators: {plugins} are the ids of the official plugins.
#: app/src/update/plugins.rs:613
msgid ""
"'{id}' is not an official plugin in the eov {version} catalog (official "
"plugins: {plugins})."
msgstr ""
"‏«{id}» افزونهٔ رسمی در فهرست eov {version} نیست (افزونه‌های رسمی: {plugins})."

#. Translators: {tag} is a release, such as v1.2.0.
#: app/src/update/plugins.rs:662
msgid ""
"official plugin {id} release {tag} contains version {version}, expected "
"{expected}"
msgstr ""
"نسخهٔ منتشرشدهٔ {tag} از افزونهٔ رسمی {id} شامل نسخهٔ {version} است، در حالی که "
"{expected} انتظار می‌رفت"

#. Translators: {repository} is a GitHub repository, {tag} a release, such as v1.2.0.
#: app/src/update/plugins.rs:689
msgid "{repository} has no plugin release manifest for {tag}"
msgstr "‏{repository} برای {tag} مانیفست انتشار افزونه ندارد"

#. Translators: {} is a GitHub repository.
#: app/src/update/plugins.rs:695
msgid "{} has no plugin release manifest for its latest release"
msgstr "‏{} برای آخرین نسخهٔ منتشرشده‌اش مانیفست انتشار افزونه ندارد"

#: app/src/update/plugins.rs:709
msgid ""
"the release declares plugin id '{declared}', but '{expected}' was expected"
msgstr ""
"نسخهٔ منتشرشده شناسهٔ افزونه را «{declared}» اعلام می‌کند، اما «{expected}» "
"انتظار می‌رفت"

#. Translators: {} is a GitHub repository. "--id <id>" is an option of eov plugin install: keep it as it is.
#: app/src/update/plugins.rs:721
msgid ""
"the release in {} does not declare a plugin id. Check which plugin it "
"contains and re-run with --id <id>."
msgstr ""
"نسخهٔ منتشرشده در {} شناسهٔ افزونه را اعلام نمی‌کند. بررسی کنید شامل کدام "
"افزونه است و فرمان را با ⁨--id <id>⁩ دوباره اجرا کنید."

#. Translators: {repository} is a GitHub repository, {platform} an operating system and processor, such as linux.x86_64.
#: app/src/update/plugins.rs:731
msgid "{repository} publishes no {platform} package for this release"
msgstr "‏{repository} برای این نسخهٔ منتشرشده بستهٔ {platform} منتشر نمی‌کند"

#. Translators: {tag} and {release} are releases, such as v1.2.0.
#: app/src/update/plugins.rs:744
msgid ""
"the release manifest for {tag} points at an artifact of release {release}"
msgstr "مانیفست انتشار {tag} به آرتیفکتی از نسخهٔ {release} اشاره می‌کند"

#: app/src/update/plugins.rs:809
msgid "GitHub releases response for {} is not a list"
msgstr "پاسخ نسخه‌های منتشرشدهٔ GitHub برای {} یک فهرست نیست"

#: app/src/update/plugins.rs:906 app/src/update/registry.rs:217
#: app/src/update/registry.rs:280 app/src/update/source.rs:121
msgid "could not create {}"
msgstr "ایجاد {} ممکن نشد"

#: app/src/update/plugins.rs:949
msgid "the downloaded package is not valid: {}"
msgstr "بستهٔ بارگیری‌شده معتبر نیست: {}"

#: app/src/update/plugins.rs:957
msgid ""
"the package contains plugin '{contained}', but the release metadata promised "
"'{promised}'"
msgstr ""
"بسته شامل افزونهٔ «{contained}» است، اما فرادادهٔ انتشار «{promised}» را وعده "
"داده بود"

#: app/src/update/plugins.rs:967
msgid ""
"the package contains version {contained}, but the release metadata promised "
"{promised}"
msgstr ""
"بسته شامل نسخهٔ {contained} است، اما فرادادهٔ انتشار نسخهٔ {promised} را وعده "
"داده بود"

#. Translators: {required} and {declared} are ranges of eov versions, such as ">=1.0.0, <2.0.0".
#: app/src/update/plugins.rs:980
msgid ""
"the package requires eov {required}, but the release metadata declared "
"{declared}"
msgstr ""
"بسته به eov {required} نیاز دارد، اما فرادادهٔ انتشار {declared} را اعلام "
"کرده بود"

#. Translators: {reason} says why, as it does after "Failed:" ("requires eov >=2.0.0; this is eov 1.2.0").
#: app/src/update/plugins.rs:993
msgid "plugin {id} {version} does not run with this eov: {reason}"
msgstr "افزونهٔ {id} {version} با این نسخهٔ eov اجرا نمی‌شود: {reason}"

#. Translators: {file} is a plugin package; {other} and {id} are plugin ids.
#: app/src/update/plugins.rs:1039
msgid ""
"{file} contains a different plugin ('{other}'); rename or remove it before "
"installing '{id}'"
msgstr ""
"‏{file} شامل افزونهٔ دیگری («{other}») است؛ پیش از نصب «{id}»، نام آن را تغییر "
"دهید یا آن را حذف کنید"

#: app/src/update/plugins.rs:1072
msgid "could not move the package to {}"
msgstr "انتقال بسته به {} ممکن نشد"

#: app/src/update/plugins.rs:1126
msgid "could not move {} aside"
msgstr "کنار گذاشتن {} ممکن نشد"

#: app/src/update/plugins.rs:1138
msgid "could not restore {original} from {backup}"
msgstr "بازگردانی {original} از {backup} ممکن نشد"

#: app/src/update/plugins.rs:1310 app/src/update/plugins.rs:1521
msgid "plugin '{}' is not installed"
msgstr "افزونهٔ «{}» نصب نشده است"

#. Translators: {reason} says why, as it does after "Failed:" ("requires eov >=2.0.0; this is eov 1.2.0"). "eov update" is a command, on a line of its own: keep it as it is.
#: app/src/update/plugins.rs:1323
msgid ""
"Plugin {id} {version} does not run with this eov: {reason}.\n"
"\n"
"Update eov first:\n"
"    eov update"
msgstr ""
"افزونهٔ {id} {version} با این نسخهٔ eov اجرا نمی‌شود: {reason}.\n"
"\n"
"ابتدا eov را به‌روزرسانی کنید:\n"
"    eov update"

#. Translators: {reason} says why, as it does after "Failed:" ("requires eov >=2.0.0; this is eov 1.2.0").
#: app/src/update/plugins.rs:1331
msgid "Plugin {id} {version} does not run with this eov: {reason}."
msgstr "افزونهٔ {id} {version} با این نسخهٔ eov اجرا نمی‌شود: {reason}."

#. Translators: {} are warnings, one per line. --force is an option of eov plugin install: keep it as it is.
#: app/src/update/plugins.rs:1362
msgid ""
"{}\n"
"Re-run with --force to proceed."
msgstr ""
"‏{}\n"
"برای ادامه، فرمان را با ⁨--force⁩ دوباره اجرا کنید."

#. Translators: {source} is where the package comes from ("github (owner/repository)", "local").
#: app/src/update/plugins.rs:1423
msgid ""
"'{id}' is the id of an official eov plugin. This package ({source}) would "
"replace it."
msgstr ""
"‏«{id}» شناسهٔ یک افزونهٔ رسمی eov است. این بسته ({source}) جایگزین آن می‌شود."

#. Translators: {source} is where the package comes from ("github (owner/repository)", "local"). To shadow: to hide the official plugin, which is then not loaded.
#: app/src/update/plugins.rs:1430
msgid ""
"'{id}' is the id of an official eov plugin. This package ({source}) would "
"shadow it."
msgstr ""
"‏«{id}» شناسهٔ یک افزونهٔ رسمی eov است. این بسته ({source}) آن را پنهان می‌کند و "
"افزونهٔ رسمی دیگر بارگذاری نمی‌شود."

#. Translators: {installed} and {new} are where packages come from ("official", "github (owner/repository)", "local").
#: app/src/update/plugins.rs:1443
msgid ""
"This replaces the installed {id} {version} from {installed} with a package "
"from {new}."
msgstr ""
"این کار {id} {version} نصب‌شده از {installed} را با بسته‌ای از {new} جایگزین "
"می‌کند."

#. Translators: "pinned": eov's release catalog lists each official plugin
#. version with a fixed SHA-256; this version is not listed there.
#. release.toml is a file name: keep it as it is.
#: app/src/update/plugins.rs:1456
msgid ""
"This version is not pinned by the eov release catalog; its SHA-256 comes "
"from the plugin repository's own release.toml."
msgstr ""
"این نسخه در فهرست انتشار eov تثبیت نشده است؛ SHA-256 آن از release.toml خود "
"مخزن افزونه می‌آید."

#: app/src/update/plugins.rs:1531
msgid "managed GitHub plugin has no repository"
msgstr "افزونهٔ مدیریت‌شدهٔ GitHub مخزنی ندارد"

#. Translators: the last line is a command: keep it as it is ({command}).
#: app/src/update/plugins.rs:1538
msgid ""
"Plugin '{id}' was installed from a local package and has no remote update "
"source.\n"
"\n"
"Install a new package explicitly:\n"
"    {command}"
msgstr ""
"افزونهٔ «{id}» از یک بستهٔ محلی نصب شده است و منبع به‌روزرسانی راه دور ندارد.\n"
"\n"
"یک بستهٔ جدید را به‌صراحت نصب کنید:\n"
"    {command}"

#. Translators: {query} is what was asked for, {plugins} plugin ids.
#: app/src/update/plugins.rs:1944
msgid "'{query}' matches several plugins ({plugins}); use the plugin ID"
msgstr ""
"‏«{query}» با چند افزونه ({plugins}) مطابقت دارد؛ از شناسهٔ افزونه استفاده کنید"

#: app/src/update/plugins.rs:1967
msgid "no installed plugin matches '{}'"
msgstr "هیچ افزونهٔ نصب‌شده‌ای با «{}» مطابقت ندارد"

#: app/src/update/policy.rs:101
msgid "invalid policy file: {}"
msgstr "فایل سیاست نامعتبر است: {}"

#: app/src/update/policy.rs:102
msgid "unreadable policy file: {}"
msgstr "فایل سیاست خوانا نیست: {}"

#. Translators: {} is the policy file.
#: app/src/update/policy.rs:268
msgid "Application self-update is disabled by the administrator policy {}."
msgstr "به‌روزرسانی درون‌برنامه‌ای توسط سیاست سرپرست سیستم {} غیرفعال شده است."

#. Translators: {} is the policy file. "eov update --from <dir>" is a command: keep it as it is.
#: app/src/update/policy.rs:298
msgid ""
"Network access is disabled by the administrator policy {}. Use an offline "
"update bundle instead (eov update --from <dir>)."
msgstr ""
"دسترسی به شبکه توسط سیاست سرپرست سیستم {} غیرفعال شده است. به‌جای آن از یک "
"بستهٔ به‌روزرسانی آفلاین استفاده کنید (⁨eov update --from <dir>⁩)."

#. Translators: keep the command "eov model import <FILE> --sha256 <SHA-256>" as it is.
#: app/src/update/policy.rs:314
msgid ""
"Copy the model to this computer and add it with `eov model import <FILE> --"
"sha256 <SHA-256>`."
msgstr ""
"مدل را به این رایانه کپی کنید و آن را با ⁨`eov model import <FILE> --sha256 "
"<SHA-256>`⁩ اضافه کنید."

#. Translators: {policy} is the policy file; {import} says how to add a model by hand.
#: app/src/update/policy.rs:322
msgid ""
"Model downloads are disabled by the administrator policy {policy}. {import}"
msgstr ""
"بارگیری مدل‌ها توسط سیاست سرپرست سیستم {policy} غیرفعال شده است. {import}"

#. Translators: {policy} is the policy file; {import} says how to add a model by hand.
#: app/src/update/policy.rs:332
msgid ""
"Network access is disabled by the administrator policy {policy}, so models "
"cannot be downloaded. {import}"
msgstr ""
"دسترسی به شبکه توسط سیاست سرپرست سیستم {policy} غیرفعال شده است، بنابراین "
"مدل‌ها بارگیری نمی‌شوند. {import}"

#. Translators: {policy} is the policy file; model_url_prefixes is its setting: keep it as it is. {import} says how to add a model by hand.
#: app/src/update/policy.rs:345
msgid ""
"the administrator policy {policy} disables network access and names no model "
"servers (model_url_prefixes), so models cannot be downloaded. {import}"
msgstr ""
"سیاست سرپرست سیستم {policy} دسترسی به شبکه را غیرفعال می‌کند و هیچ سرور مدلی "
"(model_url_prefixes) را مشخص نمی‌کند، بنابراین مدل‌ها بارگیری نمی‌شوند. {import}"

#. Translators: {url} is a model's address, {policy} the policy file, {servers} the addresses it allows.
#: app/src/update/policy.rs:362
msgid ""
"{url} is not on a model server that the administrator policy {policy} allows "
"({servers})."
msgstr ""
"‏{url} روی سرور مدلی نیست که سیاست سرپرست سیستم {policy} مجاز می‌داند "
"({servers})."

#. Translators: {policy} is the policy file.
#: app/src/update/policy.rs:432
msgid ""
"Loading this plugin is not allowed: the administrator policy {policy} only "
"permits official eov plugins."
msgstr ""
"بارگذاری این افزونه مجاز نیست: سیاست سرپرست سیستم {policy} فقط افزونه‌های "
"رسمی eov را مجاز می‌داند."

#. Translators: {policy} is the policy file.
#: app/src/update/policy.rs:437
msgid ""
"Running this plugin is not allowed: the administrator policy {policy} only "
"permits official eov plugins."
msgstr ""
"اجرای این افزونه مجاز نیست: سیاست سرپرست سیستم {policy} فقط افزونه‌های رسمی "
"eov را مجاز می‌داند."

#. Translators: {policy} is the policy file.
#: app/src/update/policy.rs:442
msgid ""
"Installing plugins from GitHub repositories is not allowed: the "
"administrator policy {policy} only permits official eov plugins."
msgstr ""
"نصب افزونه از مخزن‌های GitHub مجاز نیست: سیاست سرپرست سیستم {policy} فقط "
"افزونه‌های رسمی eov را مجاز می‌داند."

#. Translators: {policy} is the policy file.
#: app/src/update/policy.rs:447
msgid ""
"Installing local plugin packages is not allowed: the administrator policy "
"{policy} only permits official eov plugins."
msgstr ""
"نصب بسته‌های افزونهٔ محلی مجاز نیست: سیاست سرپرست سیستم {policy} فقط افزونه‌های "
"رسمی eov را مجاز می‌داند."

#. Translators: {id} is a plugin id, {source} where the lock file says it comes from; {policy} is the policy file.
#: app/src/update/policy.rs:452
msgid ""
"Plugin '{id}' ({source}) is not allowed: the administrator policy {policy} "
"only permits official eov plugins."
msgstr ""
"افزونهٔ «{id}» ({source}) مجاز نیست: سیاست سرپرست سیستم {policy} فقط "
"افزونه‌های رسمی eov را مجاز می‌داند."

#: app/src/update/registry.rs:119
msgid "could not read plugin registry {}"
msgstr "خواندن فهرست ثبت افزونه‌ها ({}) ممکن نشد"

#: app/src/update/registry.rs:122
msgid "could not parse plugin registry {}"
msgstr "تجزیهٔ فهرست ثبت افزونه‌ها ({}) ممکن نشد"

#. Translators: {schema} is the number of the file's format.
#: app/src/update/registry.rs:127
msgid ""
"plugin registry {file} uses schema {schema}, which this eov does not support"
msgstr ""
"فهرست ثبت افزونه‌ها {file} از طرح‌وارهٔ {schema} استفاده می‌کند که این eov از آن "
"پشتیبانی نمی‌کند"

#: app/src/update/registry.rs:204
msgid "could not write plugin registry {}"
msgstr "نوشتن فهرست ثبت افزونه‌ها ({}) ممکن نشد"

#: app/src/update/registry.rs:288
msgid "could not open lock file {}"
msgstr "باز کردن فایل قفل {} ممکن نشد"

#. Translators: {path} is a lock file.
#: app/src/update/registry.rs:308
msgid ""
"another eov process has been holding {path} for over {n} minute; try again "
"later"
msgid_plural ""
"another eov process has been holding {path} for over {n} minutes; try again "
"later"
msgstr[0] ""
"فرایند دیگری از eov بیش از {n} دقیقه است که {path} را در اختیار دارد؛ بعداً "
"دوباره امتحان کنید"
msgstr[1] ""
"فرایند دیگری از eov بیش از {n} دقیقه است که {path} را در اختیار دارد؛ بعداً "
"دوباره امتحان کنید"

#: app/src/update/registry.rs:319
msgid "could not lock {}"
msgstr "قفل کردن {} ممکن نشد"

#. Translators: the signature of a release; {} is the name of the key.
#: app/src/update/signature.rs:53
msgid "verified (key {})"
msgstr "تأییدشده (کلید {})"

#. Translators: the signature of a release.
#: app/src/update/signature.rs:55
msgid "none (this release is not signed)"
msgstr "هیچ (این نسخه امضا نشده است)"

#. Translators: the signature of a release.
#: app/src/update/signature.rs:58
msgid "present, but this eov build has no release keys to verify it"
msgstr "موجود است، اما این نسخهٔ eov کلیدی برای تأیید آن ندارد"

#. Translators: {kind} is "eov" or a plugin, {version} its version; {file} is a file name.
#: app/src/update/signature.rs:138
msgid ""
"the {kind} {version} release manifest declares a signature, but {file} is "
"missing. Nothing was changed."
msgstr ""
"مانیفست انتشار {kind} {version} امضایی را اعلام می‌کند، اما {file} وجود "
"ندارد. هیچ چیز تغییر نکرد."

#. Translators: {kind} is "eov" or a plugin, {version} its version.
#: app/src/update/signature.rs:151
msgid ""
"the {kind} {version} release manifest is not signed, but the administrator "
"policy requires signed release metadata. Nothing was changed."
msgstr ""
"مانیفست انتشار {kind} {version} امضا نشده است، اما سیاست سرپرست سیستم "
"فرادادهٔ انتشار امضاشده را الزامی می‌داند. هیچ چیز تغییر نکرد."

#. Translators: {kind} is "eov" or a plugin, {version} its version.
#: app/src/update/signature.rs:158
msgid ""
"the {kind} {version} release manifest is not signed, but this eov build "
"requires signed release metadata. Nothing was changed."
msgstr ""
"مانیفست انتشار {kind} {version} امضا نشده است، اما این نسخهٔ eov فرادادهٔ "
"انتشار امضاشده را الزامی می‌داند. هیچ چیز تغییر نکرد."

#. Translators: {kind} is "eov" or a plugin, {version} its version; {error} the error of the signature library.
#: app/src/update/signature.rs:173
msgid ""
"the {kind} {version} release manifest has a malformed signature: {error}"
msgstr "مانیفست انتشار {kind} {version} امضای بدشکلی دارد: {error}"

#. Translators: {kind} is "eov" or a plugin, {version} its version.
#: app/src/update/signature.rs:186
msgid ""
"the {kind} {version} release manifest is signed, but this eov build has no "
"release keys and the administrator policy requires verified signatures."
msgstr ""
"مانیفست انتشار {kind} {version} امضا شده است، اما این نسخهٔ eov کلید انتشار "
"ندارد و سیاست سرپرست سیستم امضاهای تأییدشده را الزامی می‌داند."

#. Translators: {kind} is "eov" or a plugin, {version} its version.
#: app/src/update/signature.rs:202
msgid ""
"the signature of the {kind} {version} release manifest does not verify "
"against the trusted eov release keys. The metadata may have been tampered "
"with; nothing was changed."
msgstr ""
"امضای مانیفست انتشار {kind} {version} با کلیدهای انتشار مورد اعتماد eov "
"تأیید نمی‌شود. ممکن است فراداده دست‌کاری شده باشد؛ هیچ چیز تغییر نکرد."

#. Translators: {kind} is "eov" or a plugin, {version} its version.
#: app/src/update/signature.rs:210
msgid ""
"the signature of the {kind} {version} release manifest belongs to a "
"different release"
msgstr "امضای مانیفست انتشار {kind} {version} متعلق به نسخهٔ دیگری است"

#. Translators: the trusted comment is the signed text of a minisign
#. signature; {} is the name of one of its fields: keep it as it is.
#: app/src/update/signature.rs:230
msgid "the signature's trusted comment has no '{}' field"
msgstr "توضیح مورد اعتماد امضا (trusted comment) فیلد «{}» را ندارد"

#. Translators: "it" is a signature; {signed} and {expected} are kinds of release manifest ("eov" or a plugin).
#: app/src/update/signature.rs:237
msgid "it was made for a '{signed}' manifest, not '{expected}'"
msgstr "این امضا برای مانیفست «{signed}» ساخته شده است، نه «{expected}»"

#. Translators: "it" is a signature.
#: app/src/update/signature.rs:247
msgid "it was made for version {}"
msgstr "این امضا برای نسخهٔ {} ساخته شده است"

#. Translators: "it" is a signature.
#: app/src/update/signature.rs:255
msgid "it was made for repository {}"
msgstr "این امضا برای مخزن {} ساخته شده است"

#. Translators: where an eov release comes from; {} is its tag, such as v1.2.0.
#: app/src/update/source.rs:68
msgid "GitHub release {}"
msgstr "نسخهٔ منتشرشدهٔ {} در GitHub"

#. Translators: after "The last eov update completed."; {path} is a folder. "eov update --rollback" is a command: keep it as it is.
#: app/src/update/transaction.rs:385
msgid "The previous version is kept at {path} for `eov update --rollback`."
msgstr "نسخهٔ قبلی برای `eov update --rollback` در {path} نگه داشته شده است."

