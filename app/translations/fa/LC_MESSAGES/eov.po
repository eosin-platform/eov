#. Translators: what separates the items of a list ("Hematoxylin ×1.20,
#. Eosin hidden"): a comma and a space in English.
#: app/src/processing_text.rs:27
msgctxt "List separator"
msgid ", "
msgstr "، "

#. Translators: a histological stain (dye), as in "Isolated stain:
#. Hematoxylin".
#: app/src/processing_text.rs:45
msgctxt "Stain"
msgid "Hematoxylin"
msgstr "هماتوکسیلین"

#. Translators: a histological stain (dye).
#: app/src/processing_text.rs:47
msgctxt "Stain"
msgid "Eosin"
msgstr "ائوزین"

#. Translators: a histological stain (dye) of Masson's trichrome.
#: app/src/processing_text.rs:49
msgctxt "Stain"
msgid "Methyl blue"
msgstr "متیل بلو"

#. Translators: a histological stain (dye) of Masson's trichrome.
#: app/src/processing_text.rs:51
msgctxt "Stain"
msgid "Ponceau-fuchsin"
msgstr "پونسو-فوشین"

#. Translators: a staining method of histology, named after a person.
#: app/src/processing_text.rs:68 app/src/processing_text.rs:111
msgctxt "Stain"
msgid "Masson trichrome"
msgstr "تری‌کروم ماسون"

#. Translators: a staining method of histology, named after a person.
#: app/src/processing_text.rs:70
msgctxt "Stain"
msgid "Giemsa"
msgstr "گیمسا"

#. Translators: a staining method of histology (reticulin fibres).
#: app/src/processing_text.rs:72
msgctxt "Stain"
msgid "Reticulin"
msgstr "رتیکولین"

#. Translators: a staining method of histology (for amyloid).
#: app/src/processing_text.rs:74
msgctxt "Stain"
msgid "Congo red"
msgstr "قرمز کنگو"

#. Translators: a staining method of histology, named after a person.
#: app/src/processing_text.rs:76
msgctxt "Stain"
msgid "Van Gieson"
msgstr "ون گیسون"

#. Translators: a staining method of histology for elastic fibres (such
#. as Verhoeff or orcein): the name of the stain, not of the protein.
#: app/src/processing_text.rs:79
msgctxt "Stain"
msgid "Elastic"
msgstr "الاستیک"

#. Translators: a staining method of histology (for mucins).
#: app/src/processing_text.rs:81
msgctxt "Stain"
msgid "Alcian blue"
msgstr "آلسین بلو"

#. Translators: a staining method of histology (for iron), named
#. after a person.
#: app/src/processing_text.rs:84
msgctxt "Stain"
msgid "Perls' Prussian blue"
msgstr "آبی پروس پرلز"

#. Translators: a staining method of microbiology, named after a
#. person.
#: app/src/processing_text.rs:87
msgctxt "Stain"
msgid "Gram"
msgstr "گرم"

#. Translators: a staining method of histology (for fungi), named
#. after a person.
#: app/src/processing_text.rs:90
msgctxt "Stain"
msgid "Grocott methenamine silver"
msgstr "نقرهٔ متنامین گروکوت"

#. Translators: a staining method of histology (for mucins).
#: app/src/processing_text.rs:92
msgctxt "Stain"
msgid "Mucicarmine"
msgstr "موسیکارمین"

#. Translators: a staining method of microbiology (acid-fast
#. bacteria), named after two people.
#: app/src/processing_text.rs:95
msgctxt "Stain"
msgid "Ziehl–Neelsen"
msgstr "زیل–نلسون"

#. Translators: the stain vectors of hematoxylin and eosin that
#. Macenko et al. published as a reference.
#: app/src/processing_text.rs:109
msgctxt "Stain model"
msgid "H&E (Macenko reference)"
msgstr "مرجع Macenko برای H&E"

#. Translators: a stain model of the user's own stain vectors; {}
#. lists its stains.
#: app/src/processing_text.rs:127
msgid "custom ({})"
msgstr "سفارشی ({})"

#. Translators: on a pane while the slide's stains are still being
#. fitted: the colours shown are NOT normalised yet (waiting, not
#. partly applied); {} is the method (Macenko or Vahadane).
#: app/src/processing_text.rs:146
msgid "Colour normalisation pending ({})"
msgstr "در انتظار نرمال‌سازی رنگ ({})"

#. Translators: the slide's own stains could not be fitted, so
#. generic H&E stain vectors were used instead (a fallback); {} is
#. the method (Macenko or Vahadane).
#: app/src/processing_text.rs:151
msgid "Colour-normalised ({}, fallback stain vectors)"
msgstr "رنگ نرمال‌شده ({}، بردارهای رنگینهٔ جایگزین)"

#. Translators: {} is the method (Macenko or Vahadane).
#: app/src/processing_text.rs:154
msgid "Colour-normalised ({})"
msgstr "رنگ نرمال‌شده ({})"

#. Translators: only this stain is shown, in grey; {} is the stain
#. (Hematoxylin, Eosin, …).
#: app/src/processing_text.rs:160
msgid "Isolated stain: {}"
msgstr "رنگینهٔ جداشده: {}"

#. Translators: the stains' intensities were changed; {} lists the
#. changes ("Hematoxylin ×1.20, Eosin hidden").
#: app/src/processing_text.rs:165
msgid "Stain-adjusted ({})"
msgstr "رنگینه‌های تنظیم‌شده ({})"

#. Translators: a badge, also written on exported images: the pixel
#. tones were changed with gamma, brightness or contrast (not the
#. view's position or zoom).
#: app/src/processing_text.rs:171
msgid "Display-adjusted"
msgstr "نمایش تنظیم‌شده"

#. Translators: the slide is shown sharpened.
#: app/src/processing_text.rs:175
msgid "Sharpened"
msgstr "تیزشده"

#. Translators: some of the colour processing asked for could not
#. be done (the warnings say what and why).
#: app/src/processing_text.rs:180
msgid "Some adjustments not applied"
msgstr "برخی تنظیمات اعمال نشدند"

#. Translators: {} is a stain (Eosin, …) that is not shown.
#: app/src/processing_text.rs:200
msgctxt "Stain"
msgid "{} hidden"
msgstr "‏{} پنهان"

#. Translators: a stain shown at a multiple of its intensity
#. ("Hematoxylin ×1.20").
#: app/src/processing_text.rs:204
msgid "{stain} ×{factor}"
msgstr "{stain} ×{factor}"

#. Translators: {method} is Macenko or Vahadane; {reason} says why
#. the normalisation cannot be applied.
#: app/src/processing_text.rs:218
msgid "{method} stain normalisation ({reason})"
msgstr "نرمال‌سازی رنگ‌آمیزی {method} ({reason})"

#. Translators: {stain} is the number of a stain, {n} how many
#. stains the stain model has.
#: app/src/processing_text.rs:225
msgid "isolating stain {stain} (the stain model has {n} stain)"
msgid_plural "isolating stain {stain} (the stain model has {n} stains)"
msgstr[0] "جداسازی رنگینهٔ {stain} (مدل رنگ‌آمیزی {n} رنگینه دارد)"
msgstr[1] "جداسازی رنگینهٔ {stain} (مدل رنگ‌آمیزی {n} رنگینه دارد)"

#. Translators: an item of "Not applied: …": the stains of some
#. adjustments are not in the stain model; {n} is how many stains
#. the stain model has.
#: app/src/processing_text.rs:234
msgid "adjusting stains the stain model does not have (it has {n} stain)"
msgid_plural ""
"adjusting stains the stain model does not have (it has {n} stains)"
msgstr[0] "تنظیم رنگینه‌هایی که در مدل رنگ‌آمیزی نیستند (مدل {n} رنگینه دارد)"
msgstr[1] "تنظیم رنگینه‌هایی که در مدل رنگ‌آمیزی نیستند (مدل {n} رنگینه دارد)"

#. Translators: the stain normalisation's target has another
#. number of stains ({n}) than the slide's fit ("the source").
#: app/src/processing_text.rs:252
msgid "the normalisation target has {n} stain but the source has {source}"
msgid_plural ""
"the normalisation target has {n} stains but the source has {source}"
msgstr[0] "هدف نرمال‌سازی {n} رنگینه دارد اما منبع {source} رنگینه دارد"
msgstr[1] "هدف نرمال‌سازی {n} رنگینه دارد اما منبع {source} رنگینه دارد"

#. Translators: {index} is the number of a stain, {n} how many
#. stains the stain model ("basis") has.
#: app/src/processing_text.rs:261
msgid "isolated stain {index} does not exist (the basis has {n} stain)"
msgid_plural "isolated stain {index} does not exist (the basis has {n} stains)"
msgstr[0] "رنگینهٔ جداشدهٔ {index} وجود ندارد (پایه {n} رنگینه دارد)"
msgstr[1] "رنگینهٔ جداشدهٔ {index} وجود ندارد (پایه {n} رنگینه دارد)"

#. Translators: {} is a stain model (H-DAB, Masson trichrome, …).
#: app/src/processing_text.rs:290
msgid ""
"Stain normalisation only supports H&E; it is disabled for the {} stain model."
msgstr ""
"نرمال‌سازی رنگ‌آمیزی فقط از H&E پشتیبانی می‌کند؛ برای مدل رنگ‌آمیزی {} غیرفعال "
"است."

#. Translators: {} is the stain the slide's file names ("Ki-67",
#. "IHC").
#: app/src/processing_text.rs:296
msgid ""
"This slide is labelled \"{}\" (immunohistochemistry), but the H&E stain "
"model is selected; DAB and other chromogens will be shown in the wrong "
"colours. Use the H-DAB stain preset instead."
msgstr ""
"این لام با برچسب «{}» (ایمونوهیستوشیمی) مشخص شده است، اما مدل رنگ‌آمیزی H&E "
"انتخاب شده است؛ DAB و دیگر کروموژن‌ها با رنگ‌های نادرست نمایش داده می‌شوند. "
"به‌جای آن از پیش‌تنظیم رنگ‌آمیزی H-DAB استفاده کنید."

#. Translators: {} is a staining method (Giemsa, Congo red, …).
#: app/src/processing_text.rs:301
msgid ""
"This slide is labelled as a {} stain, but the H&E stain model is selected; "
"its colours cannot be represented by hematoxylin and eosin."
msgstr ""
"این لام به‌عنوان رنگ‌آمیزی {} برچسب خورده است، اما مدل رنگ‌آمیزی H&E انتخاب شده "
"است؛ رنگ‌های آن را نمی‌توان با هماتوکسیلین و ائوزین نمایش داد."

#. Translators: {} says what was asked for and why it is not done
#. ("isolating stain 3 (the stain model has 2 stains)").
#: app/src/processing_text.rs:306
msgid "Not applied: {}."
msgstr "اعمال نشد: {}."

#. Translators: a stain fit: the method (Macenko or Vahadane), the
#. pixels it used, how much of them was tissue, and the angle
#. between the fitted stains.
#: app/src/processing_text.rs:325
msgid "{method} fit ({source}; {percent}% tissue; stains {angle}° apart)"
msgstr ""
"برازش {method} ({source}؛ ⁨{percent}%⁩ بافت؛ زاویهٔ بین رنگینه‌ها ⁨{angle}°⁩)"

#. Translators: a stain fit that was not used: the method (Macenko
#. or Vahadane), why, and the pixels it used. The standard
#. ("reference") stain vectors were used instead.
#: app/src/processing_text.rs:335
msgid ""
"{method} fit rejected ({reason}); reference stain vectors used ({source})"
msgstr ""
"برازش {method} رد شد ({reason})؛ از بردارهای رنگینهٔ مرجع استفاده شد "
"({source})"

#. Translators: a stain fit's pixels came from a plugin or a script.
#: app/src/processing_text.rs:347
msgid "supplied pixels"
msgstr "پیکسل‌های ارائه‌شده"

#. Translators: a stain fit read blocks spread over a pyramid
#. level of the slide; {} is the level.
#: app/src/processing_text.rs:355
msgid "slide, sparse sample of level {}"
msgstr "لام، نمونهٔ پراکنده از سطح {}"

#. Translators: a stain fit read a pyramid level of the slide; {} is
#. the level.
#: app/src/processing_text.rs:359
msgid "slide level {}"
msgstr "سطح {} لام"

#. Translators: a stain fit read a region of the slide: its size
#. in pixels and the pyramid level.
#: app/src/processing_text.rs:369
msgid "{width}×{height} px region, level {level}"
msgstr "ناحیهٔ ⁨{width}×{height} px⁩، سطح {level}"

#. Translators: too little of the slide was tissue to fit its
#. stains: how many pixels, and which share of the slide.
#: app/src/processing_text.rs:388
msgid "insufficient tissue ({pixels} px, {percent}%)"
msgstr "بافت ناکافی (⁨{pixels} px⁩، ⁨{percent}%⁩)"

#. Translators: the fitted stains were too alike to tell apart:
#. the angle between them, and the fit's condition number.
#: app/src/processing_text.rs:400
msgid ""
"ill-conditioned fit (stain vectors {angle}° apart, condition {condition})"
msgstr ""
"برازش بدحالت (زاویهٔ بین بردارهای رنگینه ⁨{angle}°⁩، عدد حالت {condition})"

#. Translators: the fitted stains were too far from those of
#. hematoxylin and eosin.
#: app/src/processing_text.rs:408
msgid "implausible stain vectors ({}° from the reference)"
msgstr "بردارهای رنگینهٔ نامحتمل (⁨{}°⁩ اختلاف با مرجع)"

#. Translators: a stain fit failed.
#: app/src/processing_text.rs:412
msgid "the fit did not converge"
msgstr "برازش همگرا نشد"

#: app/src/quantify_panel.rs:194
msgid "The weak threshold must be a positive number"
msgstr "آستانهٔ ضعیف باید عددی مثبت باشد"

#: app/src/quantify_panel.rs:196
msgid "The moderate threshold must be a positive number"
msgstr "آستانهٔ متوسط باید عددی مثبت باشد"

#: app/src/quantify_panel.rs:198
msgid "The strong threshold must be a positive number"
msgstr "آستانهٔ قوی باید عددی مثبت باشد"

#: app/src/quantify_panel.rs:199
msgid "Thresholds must be positive numbers"
msgstr "آستانه‌ها باید اعداد مثبت باشند"

#: app/src/quantify_panel.rs:201
msgid "Thresholds must rise from weak to moderate to strong"
msgstr "آستانه‌ها باید از ضعیف به متوسط و سپس قوی افزایش یابند"

#: app/src/quantify_panel.rs:310
msgid "Tissue pixels analysed"
msgstr "پیکسل‌های بافتی تحلیل‌شده"

#. Translators: the pixels positive for a stain ("DAB-positive").
#: app/src/quantify_panel.rs:312
msgid "{}-positive"
msgstr "‏{}-مثبت"

#. Translators: weak, moderate and strong staining are the 1+, 2+ and
#. 3+ intensity classes of an H-score.
#: app/src/quantify_panel.rs:315
msgid "Weak (1+)"
msgstr "ضعیف (⁨1+⁩)"

#: app/src/quantify_panel.rs:316
msgid "Moderate (2+)"
msgstr "متوسط (⁨2+⁩)"

#: app/src/quantify_panel.rs:317
msgid "Strong (3+)"
msgstr "قوی (⁨3+⁩)"

#. Translators: the H-score of immunohistochemistry, from 0 to 300.
#: app/src/quantify_panel.rs:319
msgid "H-score (0–300)"
msgstr "H-score (0–300)"

#: app/src/quantify_panel.rs:321
msgid "Mean {} concentration"
msgstr "میانگین غلظت {}"

#: app/src/quantify_panel.rs:349
msgid "Open a slide to quantify a stain"
msgstr "برای کمّی‌سازی رنگ‌آمیزی، یک لام باز کنید"

#. Translators: R is the key of the region-of-interest tool.
#: app/src/quantify_panel.rs:355
msgid "Draw a region of interest first (R), then quantify the stain in it"
msgstr ""
"ابتدا یک ناحیهٔ مورد نظر رسم کنید (R)، سپس رنگ‌آمیزی را در آن کمّی‌سازی کنید"

#. Translators: the region's size in level-0 pixels, then the
#. pyramid level it is read at, its size there and the pixel size.
#: app/src/quantify_panel.rs:436
msgid ""
"The region of interest, {width} × {height} px, read at level {level} "
"({level_width} × {level_height} px, {mpp} µm/px)."
msgstr ""
"ناحیهٔ مورد نظر، ⁨{width} × {height} px⁩، در سطح {level} خوانده شد "
"(⁨{level_width} × {level_height} px⁩، ⁨{mpp} µm/px⁩)."

#: app/src/quantify_panel.rs:445
msgid ""
"The region of interest, {width} × {height} px, read at level {level} "
"({level_width} × {level_height} px)."
msgstr ""
"ناحیهٔ مورد نظر، ⁨{width} × {height} px⁩، در سطح {level} خوانده شد "
"(⁨{level_width} × {level_height} px⁩)."

#: app/src/quantify_panel.rs:453
msgid "Quantify Stain · {}"
msgstr "کمّی‌سازی رنگ‌آمیزی · {}"

#: app/src/quantify_panel.rs:474
msgid "Reading the region…"
msgstr "در حال خواندن ناحیه…"

#: app/src/quantify_panel.rs:550 app/src/quantify_panel.rs:714
msgid "Could not quantify the stain"
msgstr "کمّی‌سازی رنگ‌آمیزی ممکن نشد"

#: app/src/quantify_panel.rs:564
msgid "Quantifying the stain"
msgstr "در حال کمّی‌سازی رنگ‌آمیزی"

#: app/src/quantify_panel.rs:623
msgid ""
"the region is {width} × {height} pixels at the slide's coarsest level "
"{level}; quantify a smaller region"
msgstr ""
"ناحیه در درشت‌ترین سطح لام ({level}) ⁨{width} × {height}⁩ پیکسل است؛ ناحیهٔ "
"کوچک‌تری را کمّی‌سازی کنید"

#: app/src/quantify_panel.rs:739
msgid "Copied the results"
msgstr "نتایج کپی شد"

#. Translators: the first line of the results copied as text: the
#. slide, the stain measured, the stain model and the thresholds
#. of weak, moderate and strong staining. The thresholds are
#. decimal numbers with your language's decimal separator
#. ("0,15" in German): keep a separator between them that cannot
#. be taken for it (not a comma).
#: app/src/quantify_panel.rs:762
msgid ""
"{name}: {stain} in the region of interest ({model} model; thresholds "
"{weak} / {moderate} / {strong})"
msgstr ""
"‏{name}: {stain} در ناحیهٔ مورد نظر (مدل {model}؛ آستانه‌ها ⁨{weak} / "
"{moderate} / {strong}⁩)"

#: app/src/render.rs:957
msgid "The GPU renderer failed; slides are drawn by the CPU renderer"
msgstr "موتور رندر GPU از کار افتاد؛ لام‌ها با موتور رندر CPU رسم می‌شوند"

#. Translators: the size of the copy, its pyramid levels, the size of
#. its tiles and its pixel size.
#: app/src/save_copy.rs:164
msgid "{width} × {height} px in {n} level of {tile}-px tiles at {mpp} µm/px."
msgid_plural ""
"{width} × {height} px in {n} levels of {tile}-px tiles at {mpp} µm/px."
msgstr[0] ""
"تصویر ⁨{width} × {height} px⁩ در {n} سطح، با کاشی‌های ⁨{tile} px⁩ و اندازهٔ پیکسل "
"⁨{mpp} µm/px⁩."
msgstr[1] ""
"تصویر ⁨{width} × {height} px⁩ در {n} سطح، با کاشی‌های ⁨{tile} px⁩ و اندازهٔ پیکسل "
"⁨{mpp} µm/px⁩."

#: app/src/save_copy.rs:174
msgid ""
"{width} × {height} px in {n} level of {tile}-px tiles; the slide records no "
"pixel size."
msgid_plural ""
"{width} × {height} px in {n} levels of {tile}-px tiles; the slide records no "
"pixel size."
msgstr[0] ""
"تصویر ⁨{width} × {height} px⁩ در {n} سطح، با کاشی‌های ⁨{tile} px⁩؛ اندازهٔ پیکسل "
"در لام ثبت نشده است."
