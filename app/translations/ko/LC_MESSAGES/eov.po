#: app/src/quantify_panel.rs:315
msgid "Weak (1+)"
msgstr "약함(1+)"

#: app/src/quantify_panel.rs:316
msgid "Moderate (2+)"
msgstr "중등도(2+)"

#: app/src/quantify_panel.rs:317
msgid "Strong (3+)"
msgstr "강함(3+)"

