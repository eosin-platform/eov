msgstr "verificada (clave {})"

#. Translators: the signature of a release.
#: app/src/update/signature.rs:55
msgid "none (this release is not signed)"
msgstr "ninguna (esta versión no está firmada)"

#. Translators: the signature of a release.
#: app/src/update/signature.rs:58
