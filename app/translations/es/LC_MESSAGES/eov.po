#. lists its stains.
#: app/src/processing_text.rs:127
msgid "custom ({})"
msgstr "personalizado ({})"

#. Translators: on a pane while the slide's stains are still being
#. fitted: the colours shown are NOT normalised yet (waiting, not
#. partly applied); {} is the method (Macenko or Vahadane).
#: app/src/processing_text.rs:146
msgid "Colour normalisation pending ({})"
msgstr "Normalización del color pendiente ({})"

#. Translators: the slide's own stains could not be fitted, so
#. generic H&E stain vectors were used instead (a fallback); {} is
#. the method (Macenko or Vahadane).
#: app/src/processing_text.rs:151
msgid "Colour-normalised ({}, fallback stain vectors)"
msgstr "Con normalización del color ({}, vectores de tinción de respaldo)"

#. Translators: {} is the method (Macenko or Vahadane).
#: app/src/processing_text.rs:154
msgid "Colour-normalised ({})"
msgstr "Con normalización del color ({})"

#. Translators: only this stain is shown, in grey; {} is the stain
#. (Hematoxylin, Eosin, …).
#: app/src/processing_text.rs:160
msgid "Isolated stain: {}"
msgstr "Tinción aislada: {}"

#. Translators: the stains' intensities were changed; {} lists the
#. changes ("Hematoxylin ×1.20, Eosin hidden").
#: app/src/processing_text.rs:165
msgid "Stain-adjusted ({})"
msgstr "Con tinciones ajustadas ({})"

#. Translators: a badge, also written on exported images: the pixel
#. tones were changed with gamma, brightness or contrast (not the
#. view's position or zoom).
#: app/src/processing_text.rs:171
msgid "Display-adjusted"
msgstr "Con visualización ajustada"

#. Translators: the slide is shown sharpened.
#: app/src/processing_text.rs:175
msgid "Sharpened"
msgstr "Con nitidez realzada"

#. Translators: some of the colour processing asked for could not
#. be done (the warnings say what and why).
#: app/src/processing_text.rs:180
msgid "Some adjustments not applied"
msgstr "Algunos ajustes no se aplicaron"

#. Translators: {} is a stain (Eosin, …) that is not shown.
#: app/src/processing_text.rs:200
msgctxt "Stain"
msgid "{} hidden"
msgstr "{} sin mostrar"

#. Translators: a stain shown at a multiple of its intensity
#. ("Hematoxylin ×1.20").
#: app/src/processing_text.rs:204
msgid "{stain} ×{factor}"
msgstr "{stain} ×{factor}"

#. Translators: {method} is Macenko or Vahadane; {reason} says why
#. the normalisation cannot be applied.
#: app/src/processing_text.rs:218
msgid "{method} stain normalisation ({reason})"
msgstr "normalización de la tinción con {method} ({reason})"

#. Translators: {stain} is the number of a stain, {n} how many
#. stains the stain model has.
#: app/src/processing_text.rs:225
msgid "isolating stain {stain} (the stain model has {n} stain)"
msgid_plural "isolating stain {stain} (the stain model has {n} stains)"
msgstr[0] ""
"aislamiento de la tinción {stain} (el modelo de tinción tiene {n} tinción)"
msgstr[1] ""
"aislamiento de la tinción {stain} (el modelo de tinción tiene {n} tinciones)"

#. Translators: an item of "Not applied: …": the stains of some
#. adjustments are not in the stain model; {n} is how many stains
#. the stain model has.
#: app/src/processing_text.rs:234
msgid "adjusting stains the stain model does not have (it has {n} stain)"
msgid_plural ""
"adjusting stains the stain model does not have (it has {n} stains)"
msgstr[0] ""
"ajuste de tinciones que el modelo de tinción no tiene (tiene {n} tinción)"
msgstr[1] ""
"ajuste de tinciones que el modelo de tinción no tiene (tiene {n} tinciones)"

#. Translators: the stain normalisation's target has another
#. number of stains ({n}) than the slide's fit ("the source").
#: app/src/processing_text.rs:252
msgid "the normalisation target has {n} stain but the source has {source}"
msgid_plural ""
"the normalisation target has {n} stains but the source has {source}"
msgstr[0] ""
"la referencia de normalización tiene {n} tinción, pero el ajuste de la "
"preparación tiene {source}"
msgstr[1] ""
"la referencia de normalización tiene {n} tinciones, pero el ajuste de la "
"preparación tiene {source}"

#. Translators: {index} is the number of a stain, {n} how many
#. stains the stain model ("basis") has.
#: app/src/processing_text.rs:261
msgid "isolated stain {index} does not exist (the basis has {n} stain)"
msgid_plural "isolated stain {index} does not exist (the basis has {n} stains)"
msgstr[0] ""
"la tinción aislada {index} no existe (el modelo de tinción tiene {n} tinción)"
msgstr[1] ""
"la tinción aislada {index} no existe (el modelo de tinción tiene {n} "
"tinciones)"

#. Translators: {} is a stain model (H-DAB, Masson trichrome, …).
#: app/src/processing_text.rs:290
msgid ""
"Stain normalisation only supports H&E; it is disabled for the {} stain model."
msgstr ""
"La normalización de la tinción solo admite H&E; está desactivada para el "
"modelo de tinción {}."

#. Translators: {} is the stain the slide's file names ("Ki-67",
#. "IHC").
#: app/src/processing_text.rs:296
msgid ""
"This slide is labelled \"{}\" (immunohistochemistry), but the H&E stain "
"model is selected; DAB and other chromogens will be shown in the wrong "
"colours. Use the H-DAB stain preset instead."
msgstr ""
"Esta preparación está etiquetada como “{}” (inmunohistoquímica), pero está "
"seleccionado el modelo de tinción H&E; la DAB y otros cromógenos se "
"mostrarán con colores incorrectos. Use en su lugar el modelo de tinción "
"predefinido H-DAB."

#. Translators: {} is a staining method (Giemsa, Congo red, …).
#: app/src/processing_text.rs:301
msgid ""
"This slide is labelled as a {} stain, but the H&E stain model is selected; "
"its colours cannot be represented by hematoxylin and eosin."
msgstr ""
"Esta preparación está etiquetada como tinción de {}, pero está seleccionado "
"el modelo de tinción H&E; sus colores no se pueden representar con "
"hematoxilina y eosina."

#. Translators: {} says what was asked for and why it is not done
#. ("isolating stain 3 (the stain model has 2 stains)").
#: app/src/processing_text.rs:306
msgid "Not applied: {}."
msgstr "No aplicado: {}."

#. Translators: a stain fit: the method (Macenko or Vahadane), the
#. pixels it used, how much of them was tissue, and the angle
#. between the fitted stains.
#: app/src/processing_text.rs:325
msgid "{method} fit ({source}; {percent}% tissue; stains {angle}° apart)"
msgstr ""
"Ajuste de {method} ({source}; {percent} % de tejido; tinciones separadas "
"{angle}°)"

#. Translators: a stain fit that was not used: the method (Macenko
#. or Vahadane), why, and the pixels it used. The standard
#. ("reference") stain vectors were used instead.
#: app/src/processing_text.rs:335
msgid ""
"{method} fit rejected ({reason}); reference stain vectors used ({source})"
msgstr ""
"Ajuste de {method} rechazado ({reason}); se usaron los vectores de tinción "
"de referencia ({source})"

#. Translators: a stain fit's pixels came from a plugin or a script.
#: app/src/processing_text.rs:347
msgid "supplied pixels"
msgstr "píxeles proporcionados"

#. Translators: a stain fit read blocks spread over a pyramid
#. level of the slide; {} is the level.
#: app/src/processing_text.rs:355
msgid "slide, sparse sample of level {}"
msgstr "preparación, muestra dispersa del nivel {}"

#. Translators: a stain fit read a pyramid level of the slide; {} is
#. the level.
#: app/src/processing_text.rs:359
msgid "slide level {}"
msgstr "nivel {} de la preparación"

#. Translators: a stain fit read a region of the slide: its size
#. in pixels and the pyramid level.
#: app/src/processing_text.rs:369
msgid "{width}×{height} px region, level {level}"
msgstr "región de {width}×{height} px, nivel {level}"

#. Translators: too little of the slide was tissue to fit its
#. stains: how many pixels, and which share of the slide.
#: app/src/processing_text.rs:388
msgid "insufficient tissue ({pixels} px, {percent}%)"
msgstr "tejido insuficiente ({pixels} px, {percent} %)"

#. Translators: the fitted stains were too alike to tell apart:
#. the angle between them, and the fit's condition number.
#: app/src/processing_text.rs:400
msgid ""
"ill-conditioned fit (stain vectors {angle}° apart, condition {condition})"
msgstr ""
"ajuste mal condicionado (vectores de tinción separados {angle}°, número de "
"condición {condition})"

#. Translators: the fitted stains were too far from those of
#. hematoxylin and eosin.
#: app/src/processing_text.rs:408
msgid "implausible stain vectors ({}° from the reference)"
msgstr "vectores de tinción poco plausibles (a {}° de la referencia)"

#. Translators: a stain fit failed.
#: app/src/processing_text.rs:412
msgid "the fit did not converge"
msgstr "el ajuste no convergió"

