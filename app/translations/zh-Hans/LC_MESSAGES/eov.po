msgid_plural ""
"{width} × {height} px in {n} levels of {tile}-px tiles at {mpp} µm/px."
msgstr[0] "{width} × {height} px，{n} 个层级，图块 {tile} px，{mpp} µm/px。"

#: app/src/save_copy.rs:170
msgid ""
"{width} × {height} px in {n} level of {tile}-px tiles; the slide records no "
"pixel size."
msgid_plural ""
"{width} × {height} px in {n} levels of {tile}-px tiles; the slide records no "
