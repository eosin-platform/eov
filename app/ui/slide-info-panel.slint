import { Theme } from "theme.slint";
import { PropertyRow } from "types.slint";

// One associated image (label, macro, overview) with a caption.
component AssociatedImageCard inherits Rectangle {
    in property <string> caption;
    in property <image> source;
    in property <bool> available: false;
    // The label carries patient identifiers: it can be hidden.
    in property <bool> hidden: false;
    in property <string> hidden-text: "Hidden";

    height: 150px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    background: #0a0a0a;
    clip: true;

    if root.available && !root.hidden: Image {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: parent.height - 30px;
        source: root.source;
        image-fit: contain;
    }

    if root.available && root.hidden: Text {
        y: (parent.height - 24px - self.height) / 2;
        width: 100%;
        text: root.hidden-text;
        color: Theme.text-secondary;
        font-size: 11px;
        horizontal-alignment: center;
    }

    if !root.available: Text {
        y: (parent.height - 24px - self.height) / 2;
        width: 100%;
        text: "None";
        color: Theme.text-secondary;
        font-size: 11px;
        horizontal-alignment: center;
    }

    Text {
        y: parent.height - 20px;
        width: 100%;
        text: root.caption;
        color: Theme.text-primary;
        font-size: 11px;
        horizontal-alignment: center;
    }
}

// The slide's label, macro and overview images and every property
// (AUDIT §14.1: identity check, QC and provenance).
export component SlideInfoPanel inherits Rectangle {
    in property <string> title;
    in property <image> label-image;
    in property <bool> has-label: false;
    in property <image> macro-image;
    in property <bool> has-macro: false;
    in property <image> overview-image;
    in property <bool> has-overview: false;
    in property <bool> hide-label: false;
    in property <[PropertyRow]> rows: [];
    in property <int> total-rows: 0;
    in-out property <string> filter: "";
    // Pixel size: what applies and where it comes from, and whether it was
    // set by hand (AUDIT §14.1 manual calibration).
    in property <string> pixel-size-text;
    in property <bool> pixel-size-manual: false;
    in-out property <string> pixel-size-input: "";
    callback close-requested();
    callback hide-label-toggled(bool);
    callback filter-edited(string);
    callback copy-all-requested();
    callback copy-row-requested(int);
    callback pixel-size-set(string);
    callback pixel-size-cleared();
    callback save-copy-requested();

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: #00000088;

    TouchArea {
        clicked => {
            root.close-requested();
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width - 40px, 820px);
        height: min(parent.height - 40px, 640px);
        background: Theme.surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;

        TouchArea { }

        VerticalLayout {
            padding: 18px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;

                Text {
                    horizontal-stretch: 1;
                    text: root.title;
                    color: Theme.text-primary;
                    font-size: 15px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle {
                    width: save-text.preferred-width + 16px;
                    height: 26px;
                    border-radius: 4px;
                    background: save-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;

                    save-text := Text {
                        text: "Save a Copy…";
                        color: Theme.text-primary;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    save-touch := TouchArea {
                        clicked => {
                            root.save-copy-requested();
                        }
                    }
                }

                Rectangle {
                    width: hide-text.preferred-width + 16px;
                    height: 26px;
                    border-radius: 4px;
                    background: hide-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: root.hide-label ? Theme.accent : Theme.border;

                    hide-text := Text {
                        text: root.hide-label ? "Show label" : "Hide label";
                        color: Theme.text-primary;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    hide-touch := TouchArea {
                        clicked => {
                            root.hide-label-toggled(!root.hide-label);
                        }
                    }
                }

                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 4px;
                    background: close-touch.has-hover ? Theme.surface-hover : transparent;

                    Text {
                        text: "×";
                        color: Theme.text-secondary;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        clicked => {
                            root.close-requested();
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;

                AssociatedImageCard {
                    horizontal-stretch: 1;
                    caption: "Label";
                    source: root.label-image;
                    available: root.has-label;
                    hidden: root.hide-label;
                    hidden-text: "Label hidden";
                }

                // The macro photo of the glass usually shows the label too.
                AssociatedImageCard {
                    horizontal-stretch: 2;
                    caption: "Macro";
                    source: root.macro-image;
                    available: root.has-macro;
                    hidden: root.hide-label;
                    hidden-text: "Hidden (shows the label)";
                }

                AssociatedImageCard {
                    horizontal-stretch: 1;
                    caption: "Overview";
                    source: root.overview-image;
                    available: root.has-overview;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                height: 28px;

                Text {
                    text: "Pixel size: " + root.pixel-size-text;
                    color: Theme.text-primary;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                Rectangle {
                    width: 110px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: pixel-input.has-focus ? Theme.accent : Theme.border;
                    background: #0a0c10;

                    pixel-input := TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        text <=> root.pixel-size-input;
                        color: Theme.text-primary;
                        font-size: 12px;
                        vertical-alignment: center;
                        accepted => {
                            root.pixel-size-set(self.text);
                        }
                    }

                    if root.pixel-size-input == "": Text {
                        x: 8px;
                        text: "µm/px";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: set-text.preferred-width + 16px;
                    border-radius: 4px;
                    background: set-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;

                    set-text := Text {
                        text: "Set";
                        color: Theme.text-primary;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    set-touch := TouchArea {
                        clicked => {
                            root.pixel-size-set(root.pixel-size-input);
                        }
                    }
                }

                if root.pixel-size-manual: Rectangle {
                    width: clear-text.preferred-width + 16px;
                    border-radius: 4px;
                    background: clear-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;

                    clear-text := Text {
                        text: "Use the file's";
                        color: Theme.text-primary;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    clear-touch := TouchArea {
                        clicked => {
                            root.pixel-size-cleared();
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                height: 28px;

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: filter-input.has-focus ? Theme.accent : Theme.border;
                    background: #0a0c10;

                    filter-input := TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        text <=> root.filter;
                        color: Theme.text-primary;
                        font-size: 12px;
                        vertical-alignment: center;
                        edited => {
                            root.filter-edited(self.text);
                        }
                    }

                    if root.filter == "": Text {
                        x: 8px;
                        text: "Filter properties";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.rows.length + " of " + root.total-rows;
                    color: Theme.text-secondary;
                    font-size: 11px;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: copy-text.preferred-width + 16px;
                    border-radius: 4px;
                    background: copy-touch.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;

                    copy-text := Text {
                        text: "Copy all";
                        color: Theme.text-primary;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    copy-touch := TouchArea {
                        clicked => {
                            root.copy-all-requested();
                        }
                    }
                }
            }

            Flickable {
                vertical-stretch: 1;
                viewport-height: table.preferred-height;

                table := VerticalLayout {
                    spacing: 0px;

                    for row[index] in root.rows: Rectangle {
                        height: 22px;
                        background: row-touch.has-hover ? Theme.surface-hover : Math.mod(index, 2) == 0 ? transparent : #ffffff06;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 12px;

                            Text {
                                width: 40%;
                                text: row.key;
                                color: Theme.text-secondary;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: row.value;
                                color: Theme.text-primary;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        row-touch := TouchArea {
                            clicked => {
                                root.copy-row-requested(index);
                            }
                        }
                    }
                }
            }

            Text {
                text: "Click a row to copy its value. Properties are shown as the scanner wrote them.";
                color: Theme.text-secondary;
                font-size: 10px;
            }
        }
    }
}
