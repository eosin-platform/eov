        TouchArea { }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.plugin-modal-width * 1px;
            height: root.plugin-modal-height * 1px;
            background: transparent;
            border-radius: 10px;
            clip: true;

            TouchArea { }

            FocusScope {
                width: parent.width;
                height: parent.height;
                focus-on-click: false;
                key-pressed(e) => {
                    if root.plugin-modal-captures-keyboard && e.text != Key.Escape {
                        accept
                    }
                    reject
                }
                key-released(e) => {
                    if root.plugin-modal-captures-keyboard && e.text != Key.Escape {
                        accept
                    }
                    reject
                }

                ComponentContainer {
                    width: parent.width;
                    height: parent.height;
                    component-factory: root.plugin-modal-factory;
                }
            }
        }
    }

