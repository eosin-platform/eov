    property <length> toolbar-height: 40px;
    // As panes.slint lays the panes out (and PANE_GAP in state.rs).
    property <length> pane-gap: 6px;
    property <length> plugin-sidebar-width-length: plugin-sidebar-width * 1px;
    property <length> content-panel-gap: show-plugin-sidebar ? pane-gap : 0px;
    property <int> pane-count: max(1, panes.length);
    property <length> pane-region-width: content-area.width - (show-plugin-sidebar ? plugin-sidebar-width-length + content-panel-gap : 0px);
    property <length> pane-width: (pane-region-width - max(0px, (pane-count - 1) * pane-gap)) / pane-count;
    property <length> pane-stride: pane-width + pane-gap;

    out property <float> content-area-width: pane-region-width / 1px;
    out property <float> content-area-height: pane-region.height / 1px;

    property <bool> tab-tooltip-visible: false;
    property <string> tab-tooltip-text: "";
    property <length> tab-tooltip-x: 0px;
    property <length> tab-tooltip-y: 0px;

    function update-drop-target(abs-x: length, abs-y: length) {
        if panes.length == 0 {
            self.drop-target-pane = -1;
            self.split-drop-side = -1;
            return;
        }
        if abs-x < pane-region.absolute-position.x || abs-x > pane-region.absolute-position.x + pane-region.width {
            self.drop-target-pane = -1;
            self.split-drop-side = -1;
            return;
        }
        let local-abs-x = abs-x - pane-region.absolute-position.x;
        let raw-pane = Math.floor(local-abs-x / self.pane-stride);
        self.drop-target-pane = Math.max(0, Math.min(self.panes.length - 1, raw-pane));
        self.split-drop-side = -1;
        let drop-top = toolbar-height + 35px;
        let drop-bottom = self.height;
        if abs-y >= drop-top && abs-y <= drop-bottom {
            let local-x = local-abs-x - self.drop-target-pane * self.pane-stride;
            let edge-width = self.pane-width * 0.28;
            if local-x <= edge-width {
                self.split-drop-side = 0;
            } else if local-x >= self.pane-width - edge-width {
                self.split-drop-side = 1;
            }
        }
    }

    public function update-os-file-hover(abs-x: float, abs-y: float) {
        if panes.length == 0 {
            self.os-file-hover-pane = -1;
            self.os-file-hover-side = -1;
            return;
        }
        let pane-left = pane-region.absolute-position.x / 1px;
        let pane-right = (pane-region.absolute-position.x + pane-region.width) / 1px;
        if abs-x < pane-left || abs-x > pane-right {
            self.os-file-hover-pane = -1;
            self.os-file-hover-side = -1;
            return;
        }
        let local-abs-x = abs-x - pane-left;
        let raw-pane = Math.floor(local-abs-x * 1px / self.pane-stride);
        self.os-file-hover-pane = Math.max(0, Math.min(self.panes.length - 1, raw-pane));
        self.os-file-hover-side = -1;
        let drop-top = (toolbar-height + 35px) / 1px;
        let drop-bottom = self.height / 1px;
        if abs-y >= drop-top && abs-y <= drop-bottom {
            let local-x = local-abs-x - self.os-file-hover-pane * self.pane-stride / 1px;
            let edge-width = self.pane-width / 1px * 0.20;
            if local-x <= edge-width {
                self.os-file-hover-side = 0;
            } else if local-x >= self.pane-width / 1px - edge-width {
                self.os-file-hover-side = 1;
            }
        }
    }

    public function clear-os-file-hover() {
        self.os-file-hover-pane = -1;
        self.os-file-hover-side = -1;
    }

    public function focus-keyboard() {
        global-keys.focus();
    }

    // The dialogs and panels that take the keyboard while they are open
    // (the heat map panel's sliders and fields do when used) give it back
    // to the window when they close.
    property <bool> keyboard-surface-open: root.export-dialog-visible || root.dataset-export-dialog-visible
        || root.slide-info-visible || root.save-copy-dialog-visible || root.plugin-confirm-visible
        || root.lanczos-confirm-visible || root.plugins-panel-visible || root.bookmark-dialog-visible
        || root.shortcuts-panel-visible || root.measurements-panel-visible || root.quantify-visible
        || root.channels-panel-visible || root.show-plugin-modal || HeatMapPanel.visible;
    changed keyboard-surface-open => {
        if !self.keyboard-surface-open {
            global-keys.focus();
        }
    }

    function cancel-lanczos-confirm() {
        root.lanczos-confirm-visible = false;
        root.lanczos-confirm-cancelled();
        root.lanczos-confirm-from-backend-switch = false;
    }

    global-keys := FocusScope {
        width: 100%;
        height: 100%;

        // Menus and pop-ups close on Escape whatever has the keyboard (the
        // slide would take it otherwise).
        capture-key-pressed(e) => {
            if e.text == Key.Escape && root.context-menu-visible {
                root.context-menu-visible = false;
                root.context-menu-series-path = "";
                return accept;
            }
            if e.text == Key.Escape && root.filter-popup-visible {
                root.filter-popup-visible = false;
                return accept;
            }
            if e.text == Key.Escape && root.notifications-visible {
                root.notifications-visible = false;
                return accept;
            }
            reject
        }

        key-pressed(e) => {
            if e.text == Key.Escape && root.save-copy-dialog-visible {
                root.save-copy-dialog-visible = false;
                accept
            }
            if e.text == Key.Escape && root.slide-info-visible {
                root.slide-info-visible = false;
                accept
            }
            if e.text == Key.Escape && root.dataset-export-dialog-visible {
                root.dataset-export-dialog-visible = false;
                root.dataset-export-cancel-requested();
                accept
            }
            if e.text == Key.Escape && root.export-dialog-visible {
                root.export-dialog-visible = false;
                root.export-dialog-cancel-requested();
                accept
            }
            if e.text == Key.Escape && root.plugin-confirm-visible {
                root.plugin-confirm-visible = false;
                root.plugin-confirm-cancelled();
                accept
            }
            if e.text == Key.Escape && root.lanczos-confirm-visible {
                root.cancel-lanczos-confirm();
                accept
            }
            if e.text == Key.Escape && root.bookmark-dialog-visible {
                root.bookmark-dialog-cancelled();
                accept
            }
            if e.text == Key.Escape && root.shortcuts-panel-visible {
                root.shortcuts-panel-visible = false;
                accept
            }
            if e.text == Key.Escape && root.measurements-panel-visible {
                root.measurements-panel-visible = false;
                accept
            }
            if e.text == Key.Escape && root.channels-panel-visible {
                root.channels-panel-visible = false;
                root.channels-closed();
                accept
            }
            if e.text == Key.Escape && root.quantify-visible {
                root.quantify-close();
                accept
            }
            if e.text == Key.Escape && root.show-plugin-modal {
                root.plugin-modal-dismiss-requested();
                accept
            }
            if e.text == Key.Escape && root.plugins-panel-visible {
                root.plugins-panel-visible = false;
                accept
            }
            if e.text == Key.Escape && HeatMapPanel.visible {
                HeatMapPanel.close-requested();
                accept
            }
            if e.text == Key.Escape && root.notifications-visible {
                root.notifications-visible = false;
                accept
            }
            if e.text == Key.Escape && root.context-menu-visible {
                root.context-menu-visible = false;
                accept
            }
            // Modal surfaces own the keyboard (UI-7).
            if root.export-dialog-visible || root.dataset-export-dialog-visible || root.slide-info-visible
                || root.save-copy-dialog-visible
                || root.plugin-confirm-visible || root.show-plugin-modal || root.lanczos-confirm-visible || root.plugins-panel-visible
                || root.bookmark-dialog-visible || root.shortcuts-panel-visible || root.measurements-panel-visible
                || root.quantify-visible || root.channels-panel-visible {
                reject
            }
            if root.global-key(e.text, e.modifiers.shift, e.modifiers.control, e.modifiers.alt, e.modifiers.meta, true, e.repeat) {
                accept
            }
            reject
        }

        key-released(e) => {
            if root.global-key(e.text, e.modifiers.shift, e.modifiers.control, e.modifiers.alt, e.modifiers.meta, false, false) {
                accept
            }
            reject
        }

        VerticalLayout {
            toolbar := WindowToolbar {
            current-tool: root.current-tool;
            render-mode: root.render-mode;
            gpu-rendering-available: root.gpu-rendering-available;
            filtering-mode: root.filtering-mode;
            filter-popup-visible <=> root.filter-popup-visible;
            show-minimap: root.show-minimap;
            show-series-bar: root.show-series-bar;
            show-metadata: root.show-metadata;
            show-scale-bar: root.show-scale-bar;
            viewport-lock-enabled: root.viewport-lock-enabled;
            slide-link-enabled: root.slide-link-enabled;
            alignment-adjust-enabled: root.alignment-adjust-enabled;
            use-native-window-controls: root.use-native-window-controls;
            shortcuts: root.shortcut-labels;
            undo-enabled: root.undo-enabled;
            redo-enabled: root.redo-enabled;
            undo-label: root.undo-label;
            redo-label: root.redo-label;
            measure-mode-label: root.measure-mode-label;
            plugin-count: root.plugin-count;
            plugin-problems: root.plugin-problems;
            plugin-buttons: root.plugin-buttons;
            open-file-requested => {
                root.open-file-requested();
            }
            open-recent-menu-requested(x, y) => {
                root.open-recent-menu-requested(x, y);
            }
            toggle-series-bar-requested => {
                root.toggle-series-bar-requested();
            }
            toggle-minimap-requested => {
                root.toggle-minimap-requested();
            }
            toggle-metadata-requested => {
                root.toggle-metadata-requested();
            }
            toggle-scale-bar-requested => {
                root.toggle-scale-bar-requested();
            }
            toggle-viewport-lock-requested => {
                root.toggle-viewport-lock-requested();
            }
            toggle-slide-link-requested => {
                root.toggle-slide-link-requested();
            }
            toggle-alignment-adjust-requested => {
                root.toggle-alignment-adjust-requested();
            }
            tool-selected(tool) => {
                root.tool-selected(tool);
            }
            render-backend-selected(mode) => {
                root.render-backend-selected(mode);
            }
            filtering-mode-selected(mode) => {
                root.filtering-mode-selected(mode);
            }
            dataset-export-requested => {
                root.dataset-export-open-dialog();
            }
            plugin-button-clicked(plugin-id, button-id, is-tool) => {
                root.plugin-button-clicked(plugin-id, button-id, is-tool);
            }
            undo-requested => {
                root.undo-requested();
            }
            redo-requested => {
                root.redo-requested();
            }
            measure-mode-menu-requested(x, y) => {
                root.measure-mode-menu-requested(x, y);
            }
            plugins-panel-requested => {
                root.plugins-panel-requested();
            }
            window-minimize => {
                root.window-minimize();
            }
            window-maximize => {
                root.window-maximize();
            }
            window-close => {
                root.window-close();
            }
        }

        content-area := Rectangle {
            vertical-stretch: 1;

            if root.show-plugin-sidebar: Rectangle {
                x: 0px;
                y: 0px;
                width: root.plugin-sidebar-width-length;
                height: parent.height;
                background: Theme.surface;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: parent.height;
                    background: Theme.border;
                }

                // Keys typed into the plugin's fields stay there instead of
                // reaching eov's shortcuts (SurfaceSpec::capture_keyboard).
                FocusScope {
                    width: parent.width;
                    height: parent.height;
                    focus-on-click: false;
                    key-pressed(e) => {
                        if root.plugin-sidebar-captures-keyboard && e.text != Key.Escape {
                            accept
                        }
                        reject
                    }
                    key-released(e) => {
                        if root.plugin-sidebar-captures-keyboard && e.text != Key.Escape {
                            accept
                        }
                        reject
                    }

                    ComponentContainer {
                        width: parent.width;
                        height: parent.height;
                        component-factory: root.plugin-sidebar-factory;
                    }
                }
            }

            pane-region := Rectangle {
                x: root.show-plugin-sidebar ? root.plugin-sidebar-width-length + root.content-panel-gap : 0px;
                y: 0px;
                width: content-area.width - (root.show-plugin-sidebar ? root.plugin-sidebar-width-length + root.content-panel-gap : 0px);
                height: content-area.height - root.bottom-panel-height * 1px;
                background: Theme.background;

                split-pane := SplitPaneContainer {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    visible: root.panes.length > 0;
                    panes: root.panes;
                    status-text: root.status-text;
                    show-minimap: root.show-minimap;
                    show-metadata: root.show-metadata;
                    show-scale-bar: root.show-scale-bar;
                    split-enabled: root.split-enabled;
                    focused-pane: root.focused-pane;
                    debug-mode: root.debug-mode;
                    fps: root.fps;
                    recent-files: root.recent-files;
                    dragging-tab-id: root.dragging-tab-id;
                    drag-source-pane: root.drag-source-pane;
                    drag-source-index: root.drag-source-index;
                    dragging-tab-title: root.dragging-tab-title;
                    drop-target-pane: root.drop-target-pane;
                    split-drop-side: root.split-drop-side;
                    drag-abs-x: root.drag-abs-x;
                    os-file-hover-pane: root.os-file-hover-pane;
                    os-file-hover-side: root.os-file-hover-side;

                    tab-activated(pane, id) => {
                        root.tab-activated(pane, id);
                    }
                    tab-close-requested(pane, id) => {
                        root.tab-close-requested(pane, id);
                    }
                    new-tab-requested(pane) => {
                        root.new-tab-requested(pane);
                    }
                    open-file-requested => {
                        root.open-file-requested();
                    }
                    open-recent-file(path) => {
                        root.open-recent-file(path);
                    }
                    tab-context-menu(pane, id, x, y) => {
                        root.context-menu-tab-id = id;
                        root.context-menu-x = x;
                        root.context-menu-y = y;
                        root.context-menu-items = [
                            {
                                id: "close",
                                label: "Close",
                                icon: "",
                                shortcut: root.shortcut-labels.close-tab,
                                enabled: true,
                                separator-after: false
                            },
                            {
                                id: "close-others",
                                label: "Close Others",
                                icon: "",
                                shortcut: "",
                                enabled: pane >= 0 && pane < root.panes.length ? root.panes[pane].tabs.length > 1 : false,
                                separator-after: false
                            },
                            {
                                id: "close-right",
                                label: "Close to the Right",
                                icon: "",
                                shortcut: "",
                                enabled: true,
                                separator-after: false
                            },
                            {
                                id: "close-all",
                                label: "Close All",
                                icon: "",
                                shortcut: "",
                                enabled: true,
                                separator-after: true
                            },
                            {
                                id: "open-folder",
                                label: "Open Containing Folder",
                                icon: "",
                                shortcut: "",
                                enabled: true,
                                separator-after: false
                            },
                            {
                                id: "copy-path",
                                label: "Copy Path",
                                icon: "",
                                shortcut: "",
                                enabled: true,
                                separator-after: false
                            },
                            {
                                id: "slide-info",
                                label: "Slide Information",
                                icon: "",
                                shortcut: root.shortcut-labels.slide-info,
                                enabled: true,
                                separator-after: false
                            },
                            {
                                id: "save-copy",
                                label: "Save a Copy of the Slide…",
                                icon: "",
                                shortcut: "",
                                enabled: true,
                                separator-after: true
                            },
                            {
                                id: "split-right",
                                label: "Split Right",
                                icon: "",
                                shortcut: "",
                                enabled: true,
                                separator-after: false
                            },
                        ];
                        root.drag-source-pane = pane;
                        root.context-menu-visible = true;
                    }
                    viewport-fit-to-view => {
                        root.viewport-fit-to-view();
                    }
                    viewport-pointer(pane, kind, button, x, y, wx, wy, shift, control, alt, meta) => {
                        root.viewport-pointer(pane, kind, button, x, y, wx, wy, shift, control, alt, meta);
                    }
                    viewport-wheel(pane, dx, dy, x, y, shift, control, alt, meta) => {
                        root.viewport-wheel(pane, dx, dy, x, y, shift, control, alt, meta);
                    }
                    viewport-pinch(pane, scale, x, y, active) => {
                        root.viewport-pinch(pane, scale, x, y, active);
                    }
                    viewport-key(pane, text, shift, control, alt, meta, pressed, repeat) => {
                        root.viewport-key(pane, text, shift, control, alt, meta, pressed, repeat)
                    }
                    minimap-navigate(nx, ny) => {
                        root.minimap-navigate(nx, ny);
                    }
                    minimap-drag-start => {
                        root.minimap-drag-start();
                    }
                    minimap-drag-end => {
                        root.minimap-drag-end();
                    }
                    viewport-interaction-started(pane-id) => {
                        root.viewport-interaction-started(pane-id);
                    }
                    pane-focused(pane) => {
                        root.pane-focused(pane);
                    }
                    tab-drag-started(id, pane, title, index, abs-x, abs-y) => {
                        root.dragging-tab-id = id;
                        root.drag-source-pane = pane;
                        root.drag-source-index = index;
                        root.dragging-tab-title = title;
                        root.focused-pane = pane;
                        root.drag-abs-x = abs-x;
                        root.drag-abs-y = abs-y;
                        root.update-drop-target(abs-x, abs-y);
                    }
                    tab-drag-moved(abs-x, abs-y) => {
                        root.drag-abs-x = abs-x;
                        root.drag-abs-y = abs-y;
                        root.update-drop-target(abs-x, abs-y);
                    }
                    tab-drag-ended(abs-x, abs-y) => {
                        root.drag-abs-x = abs-x;
                        root.drag-abs-y = abs-y;
                        root.update-drop-target(abs-x, abs-y);
                        if root.drop-target-pane != -1 && root.split-drop-side != -1 {
                            let insert-at = root.split-drop-side == 0 ? root.drop-target-pane : root.drop-target-pane + 1;
                            root.focused-pane = insert-at;
                            root.split-tab-by-drop(root.dragging-tab-id, insert-at);
                        } else if root.drop-target-pane == -1 {
                            // Dropped outside the panes: the tab stays.
                        } else if root.drop-target-pane != root.drag-source-pane {
                            root.move-tab-to-pane(root.dragging-tab-id, root.drag-source-pane, root.drop-target-pane);
                        } else if split-pane.active-drop-index >= 0 {
                            root.reorder-tab(root.drop-target-pane, root.dragging-tab-id, split-pane.active-drop-index);
                        }
                        root.dragging-tab-id = -1;
                        root.drag-source-pane = -1;
                        root.drag-source-index = -1;
                        root.dragging-tab-title = "";
                        root.drop-target-pane = -1;
                        root.split-drop-side = -1;
                    }
                    move-tab-to-pane(id, from, to) => {
                        root.focused-pane = to;
                        root.move-tab-to-pane(id, from, to);
                    }
                    split-tab-by-drop(id, to) => {
                        root.focused-pane = to;
                        root.split-tab-by-drop(id, to);
                    }
                    reorder-tab(pane, id, new-index) => {
                        root.reorder-tab(pane, id, new-index);
                    }
                    clear-tab-drag => {
                        root.dragging-tab-id = -1;
                        root.drag-source-pane = -1;
                        root.drag-source-index = -1;
                        root.dragging-tab-title = "";
                        root.drop-target-pane = -1;
                        root.split-drop-side = -1;
                    }
                    zoom-slider-changed(pane, value) => {
                        root.zoom-slider-changed(pane, value);
                    }
                    tab-tooltip-changed(visible, text, cx, ty) => {
                        root.tab-tooltip-visible = visible;
                        root.tab-tooltip-text = text;
                        root.tab-tooltip-x = cx - root.absolute-position.x;
                        root.tab-tooltip-y = ty - root.absolute-position.y;
                    }
                    hud-toggle-dropdown(pane) => {
                        root.hud-toggle-dropdown(pane);
                    }
                    hud-sharpness-changed(pane, v) => {
                        root.hud-sharpness-changed(pane, v);
                    }
                    hud-gamma-changed(pane, v) => {
                        root.hud-gamma-changed(pane, v);
                    }
                    hud-brightness-changed(pane, v) => {
                        root.hud-brightness-changed(pane, v);
                    }
                    hud-contrast-changed(pane, v) => {
                        root.hud-contrast-changed(pane, v);
                    }
                    hud-measurement-unit-changed(pane, u) => {
                        root.hud-measurement-unit-changed(pane, u);
                    }
                    hud-stain-normalization-changed(pane, s) => {
                        root.hud-stain-normalization-changed(pane, s);
                    }
                    hud-reset-adjustments(pane) => {
                        root.hud-reset-adjustments(pane);
                    }
                    hud-zoom-input(pane, v) => {
                        root.hud-zoom-input(pane, v);
                    }
                    hud-zoom-in(pane) => {
                        root.hud-zoom-in(pane);
                    }
                    hud-orientation-changed(pane, action) => {
                        root.hud-orientation-changed(pane, action);
                    }
                    hud-zoom-out(pane) => {
                        root.hud-zoom-out(pane);
                    }
                    hud-deconv-h-intensity-changed(pane, v) => {
                        root.hud-deconv-h-intensity-changed(pane, v);
                    }
                    hud-deconv-e-intensity-changed(pane, v) => {
                        root.hud-deconv-e-intensity-changed(pane, v);
                    }
                    hud-deconv-h-visibility-toggled(pane) => {
                        root.hud-deconv-h-visibility-toggled(pane);
                    }
                    hud-deconv-e-visibility-toggled(pane) => {
                        root.hud-deconv-e-visibility-toggled(pane);
                    }
                    hud-deconv-h-view-toggled(pane) => {
                        root.hud-deconv-h-view-toggled(pane);
                    }
                    hud-deconv-e-view-toggled(pane) => {
                        root.hud-deconv-e-view-toggled(pane);
                    }
                    hud-plugin-button-clicked(pane, plugin-id, button-id, item-id) => {
                        root.hud-plugin-button-clicked(pane, plugin-id, button-id, item-id);
                    }
                }

                if panes.length == 0: HomeScreen {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    recent-files: root.recent-files;
                    open-file-requested => {
                        root.open-file-requested();
                    }
                    open-recent-file(path) => {
                        root.open-recent-file(path);
                    }
                }
            }

            bottom-panel := BottomPanel {
                x: root.show-plugin-sidebar ? root.plugin-sidebar-width-length + root.content-panel-gap : 0px;
                y: content-area.height - self.height;
                width: content-area.width - (root.show-plugin-sidebar ? root.plugin-sidebar-width-length + root.content-panel-gap : 0px);
                visible-panel: root.bottom-panel-height > 0;
                panel-height: root.bottom-panel-height * 1px;
                panel-kind: root.bottom-panel-kind;
                series-items: root.series-items;
                series-selected-path: root.series-selected-path;
                series-can-go-back: root.series-can-go-back;
                series-can-go-forward: root.series-can-go-forward;
                series-can-go-up: root.series-can-go-up;
                series-filter <=> root.series-filter;
                series-sort-label: root.series-sort-label;
                series-filter-edited(text) => {
                    root.series-filter-edited(text);
                }
                series-sort-cycled => {
                    root.series-sort-cycled();
                }
                status-left: root.bottom-panel-status-left;
                status-right: root.bottom-panel-status-right;
                open-folder-requested => {
                    root.open-folder-requested();
                }
                open-folder-menu-requested(x, y) => {
                    root.series-open-folder-menu-requested(x, y);
                }
                series-go-back => {
                    root.series-go-back();
                }
                series-go-forward => {
                    root.series-go-forward();
                }
                series-go-up => {
                    root.series-go-up();
                }
                hide-series-bar-requested => {
                    root.toggle-series-bar-requested();
                }
                series-item-activated(path) => {
                    root.series-item-activated(path);
                }
                series-item-context-menu(path, x, y) => {
                    root.context-menu-tab-id = -1;
                    root.context-menu-series-path = path;
                    root.context-menu-x = x;
                    root.context-menu-y = y;
                    root.context-menu-items = [
                        {
                            id: "series-open",
                            label: "Open",
                            icon: "",
                            shortcut: "",
                            enabled: true,
                            separator-after: false
                        },
                        {
                            id: "series-open-new-tab",
                            label: "Open in New Tab",
                            icon: "",
                            shortcut: "",
                            enabled: true,
                            separator-after: false
                        },
                        {
                            id: "series-open-folder",
                            label: "Open Containing Folder",
                            icon: "",
                            shortcut: "",
                            enabled: true,
                            separator-after: false
                        },
                        {
                            id: "series-copy-path",
                            label: "Copy Path",
                            icon: "",
                            shortcut: "",
                            enabled: true,
                            separator-after: false
                        },
                    ];
                    root.context-menu-visible = true;
                }
            }
        }

            status-bar := StatusBar {
                status-text: root.status-text;
                plugin-status-text: root.plugin-status-text;
                jobs: root.jobs;
                unread-notifications: root.unread-notifications;
                unread-errors: root.unread-errors;
                notifications-open: root.notifications-visible;
                job-cancel-requested(id) => {
                    root.job-cancel-requested(id);
                }
                notifications-toggled => {
                    root.notifications-visible = !root.notifications-visible;
                    if root.notifications-visible {
                        root.notifications-opened();
                    }
                }
            }
        }

    if root.notifications-visible: NotificationsPopup {
        x: root.width - self.width - 6px;
        y: root.height - self.height - 30px;
        items: root.notifications;
        cleared => {
            root.notifications-cleared();
        }
        dismissed => {
            root.notifications-visible = false;
        }
        log-folder-requested => {
            root.log-folder-requested();
        }
    }

    if root.hover-tooltip-text != "": Rectangle {
        x: max(4px, min(root.width - self.width - 4px, root.hover-tooltip-x * 1px + 14px));
        y: max(4px, min(root.height - self.height - 4px, root.hover-tooltip-y * 1px + 18px));
        width: min(360px, hover-tooltip.preferred-width + 12px);
        height: hover-tooltip.preferred-height + 6px;
        background: #111111ee;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;

        hover-tooltip := Text {
            x: 6px;
            y: 3px;
            width: parent.width - 12px;
            text: root.hover-tooltip-text;
            color: white;
            font-size: 11px;
            wrap: word-wrap;
        }
    }

    if toolbar.hovered-tooltip-visible: Rectangle {
        x: max(4px, min(root.width - self.width - 4px, toolbar.hovered-tooltip-center-x - self.width / 2));
        y: toolbar.hovered-tooltip-top-y;
        width: toolbar-tooltip.preferred-width + 12px;
        height: toolbar-tooltip.preferred-height + 6px;
        background: #111111ee;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;

        toolbar-tooltip := Text {
            x: 6px;
            y: 3px;
            text: toolbar.hovered-tooltip-text;
            color: white;
            font-size: 11px;
        }
    }

    Rectangle {
        opacity: root.tab-tooltip-visible && !root.context-menu-visible ? 1.0 : 0.0;
        animate opacity { duration: 200ms; }
        x: max(4px, min(root.width - self.width - 4px, root.tab-tooltip-x - self.width / 2));
        y: root.tab-tooltip-y;
        width: tab-path-tooltip.preferred-width + 12px;
        height: tab-path-tooltip.preferred-height + 6px;
        background: #111111ee;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;

        tab-path-tooltip := Text {
            x: 6px;
            y: 3px;
            text: root.tab-tooltip-text;
            color: white;
            font-size: 11px;
        }
    }

    ContextMenu {
        items: context-menu-items;
        is-visible: context-menu-visible;
        menu-x: max(0px, min(root.width - 244px, context-menu-x));
        height-limit: root.height - 8px;
        menu-y: max(4px, min(root.height - min(context-menu-items.length * 28px, root.height - 8px) - 4px, context-menu-y));

        item-clicked(id) => {
            root.context-menu-visible = false;
            if id == "dismiss" {
                root.context-menu-series-path = "";
                return;
            }
            if root.context-menu-tab-id != -1 {
                if id == "close" {
                    root.tab-close-requested(root.drag-source-pane, root.context-menu-tab-id);
                } else if id == "close-others" {
                    root.close-other-tabs(root.drag-source-pane, root.context-menu-tab-id);
                } else if id == "close-right" {
                    root.close-tabs-to-right(root.drag-source-pane, root.context-menu-tab-id);
                } else if id == "close-all" {
                    // The tab menu's Close All means this pane's tabs.
                    root.close-pane-tabs(root.drag-source-pane);
                } else if id == "open-folder" {
                    root.open-containing-folder(root.context-menu-tab-id);
                } else if id == "copy-path" {
                    root.copy-path(root.context-menu-tab-id);
                } else if id == "slide-info" {
                    root.slide-info-requested(root.context-menu-tab-id);
                } else if id == "save-copy" {
                    root.save-copy-requested(root.context-menu-tab-id);
                } else if id == "split-right" {
                    root.split-right(root.drag-source-pane, root.context-menu-tab-id);
                }
            } else if root.context-menu-series-path != "" {
                if id == "series-open" {
                    root.series-item-activated(root.context-menu-series-path);
                } else if id == "series-open-new-tab" {
                    root.series-item-open-in-new-tab(root.context-menu-series-path);
                } else if id == "series-open-folder" {
                    root.series-item-open-containing-folder(root.context-menu-series-path);
                } else if id == "series-copy-path" {
                    root.series-item-copy-path(root.context-menu-series-path);
                }
            } else {
                root.context-menu-command(id);
            }
            root.context-menu-series-path = "";
        }
    }

    Rectangle {
        opacity: root.toast-visible ? 1.0 : 0.0;
        y: root.toast-visible ? root.height - self.height - 36px : root.height + 12px;
        x: root.width / 2 - self.width / 2;
        width: toast-label.preferred-width + 28px;
        height: toast-label.preferred-height + 14px;
        background: #111111ee;
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: root.toast-level == 3 ? #ff6b6b : root.toast-level == 2 ? #f1c40f : root.toast-level == 1 ? #2ecc71 : Theme.border;
        animate opacity { duration: 180ms; }
        animate y { duration: 220ms; }
        accessible-role: text;
        accessible-label: root.toast-text;
        // The border's colour, for assistive technology.
        accessible-description: root.toast-level == 3 ? "Error" : root.toast-level == 2 ? "Warning" : "";
        accessible-live-region: polite;

        toast-label := Text {
            x: 14px;
            y: 7px;
            text: root.toast-text;
            color: white;
            font-size: 12px;
            accessible-role: none;
        }
    }

    // Dismiss overlay for filtering popup
    if root.filter-popup-visible: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: transparent;

        TouchArea {
            clicked => {
                root.filter-popup-visible = false;
            }
        }
    }

    // Floating filtering dropdown (rendered above all content)
    if root.filter-popup-visible: Rectangle {
        x: toolbar.filter-combo-abs-x;
        y: toolbar.filter-combo-abs-y;
        width: toolbar.filter-combo-width + 74px;
        height: 3 * 26px + 4px;
        background: Theme.context-menu-bg;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;

        VerticalLayout {
            padding: 2px;

            Rectangle {
                height: 26px;
                background: bilinear-touch.has-hover ? Theme.context-menu-hover : transparent;
                border-radius: 2px;
                accessible-role: radio-button;
                accessible-label: "Bilinear (Low Quality)";
                accessible-checkable: true;
                accessible-checked: root.filtering-mode == FilteringMode.bilinear;
                accessible-action-default => {
                    root.filter-popup-visible = false;
                    root.filtering-mode-selected(FilteringMode.bilinear);
                }

                bilinear-touch := TouchArea {
                    clicked => {
                        root.filter-popup-visible = false;
                        root.filtering-mode-selected(FilteringMode.bilinear);
                    }
                }

                HorizontalLayout {
                    padding-left: 8px;
                    Text {
                        text: root.filtering-mode == FilteringMode.bilinear ? "✓ Bilinear (Low Quality)" : "   Bilinear (Low Quality)";
                        color: Theme.text-primary;
                        font-size: 11px;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
            }

            Rectangle {
                height: 26px;
                background: trilinear-touch.has-hover ? Theme.context-menu-hover : transparent;
                border-radius: 2px;
                accessible-role: radio-button;
                accessible-label: "Trilinear (Balanced)";
                accessible-checkable: true;
                accessible-checked: root.filtering-mode == FilteringMode.trilinear;
                accessible-action-default => {
                    root.filter-popup-visible = false;
                    root.filtering-mode-selected(FilteringMode.trilinear);
                }

                trilinear-touch := TouchArea {
                    clicked => {
                        root.filter-popup-visible = false;
                        root.filtering-mode-selected(FilteringMode.trilinear);
                    }
                }

                HorizontalLayout {
                    padding-left: 8px;
                    Text {
                        text: root.filtering-mode == FilteringMode.trilinear ? "✓ Trilinear (Balanced)" : "   Trilinear (Balanced)";
                        color: Theme.text-primary;
                        font-size: 11px;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
            }

            Rectangle {
                height: 26px;
                background: lanczos3-touch.has-hover ? Theme.context-menu-hover : transparent;
                border-radius: 2px;
                accessible-role: radio-button;
                accessible-label: "Lanczos-3 (High Quality)";
                accessible-checkable: true;
                accessible-checked: root.filtering-mode == FilteringMode.lanczos3;
                accessible-action-default => {
                    root.filter-popup-visible = false;
                    root.filtering-mode-selected(FilteringMode.lanczos3);
                }

                lanczos3-touch := TouchArea {
                    clicked => {
                        root.filter-popup-visible = false;
                        root.filtering-mode-selected(FilteringMode.lanczos3);
                    }
                }

                HorizontalLayout {
                    padding-left: 8px;
                    Text {
                        text: root.filtering-mode == FilteringMode.lanczos3 ? "✓ Lanczos-3 (High Quality)" : "   Lanczos-3 (High Quality)";
                        color: Theme.text-primary;
                        font-size: 11px;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
            }
        }
    }

    // Lanczos CPU confirmation dialog (centered modal)
    if root.lanczos-confirm-visible: Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000088;

        TouchArea {
            clicked => {
                root.cancel-lanczos-confirm();
            }
        }

        DialogKeys {
            title: "Lanczos Filtering (CPU)";
            has-default-action: true;
            cancel => {
                root.cancel-lanczos-confirm();
            }
            default-action => {
                root.lanczos-confirm-visible = false;
                root.lanczos-confirm-accepted();
                root.lanczos-confirm-from-backend-switch = false;
            }

            lanczos-card := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 420px;
                height: 200px;
                background: Theme.surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;

                // Block clicks from dismissing through the card
                TouchArea { }

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    Text {
                        text: "Lanczos Filtering (CPU)";
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: left;
                    }

                    Text {
                        text: "Lanczos-3 filtering on the CPU renderer is very slow and will significantly degrade rendering performance. It is highly recommended to use Trilinear filtering on CPU.\n\nAre you sure you want to enable it?";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-alignment: left;
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        Rectangle {
                            width: 72px;
                            height: 28px;
                            border-radius: 4px;
                            background: cancel-touch.has-hover ? Theme.surface-hover : Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;
                            accessible-role: button;
                            accessible-label: "Cancel";
                            accessible-action-default => {
                                root.lanczos-confirm-visible = false;
                                root.lanczos-confirm-cancelled();
                                root.lanczos-confirm-from-backend-switch = false;
                            }

                            cancel-touch := TouchArea {
                                clicked => {
                                    root.lanczos-confirm-visible = false;
                                    root.lanczos-confirm-cancelled();
                                    root.lanczos-confirm-from-backend-switch = false;
                                }
                            }

                            Text {
                                text: "Cancel";
                                color: Theme.text-primary;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }

                        Rectangle {
                            min-width: use-trilinear-text.preferred-width + 16px;
                            height: 28px;
                            border-radius: 4px;
                            background: use-trilinear-touch.has-hover ? Theme.surface-hover : Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;
                            accessible-role: button;
                            accessible-label: "Use Trilinear";
                            accessible-action-default => {
                                root.lanczos-confirm-visible = false;
                                root.lanczos-confirm-use-trilinear();
                                root.lanczos-confirm-from-backend-switch = false;
                            }

                            use-trilinear-touch := TouchArea {
                                clicked => {
                                    root.lanczos-confirm-visible = false;
                                    root.lanczos-confirm-use-trilinear();
                                    root.lanczos-confirm-from-backend-switch = false;
                                }
                            }

                            use-trilinear-text := Text {
                                text: "Use Trilinear";
                                color: Theme.text-primary;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }

                        Rectangle {
                            width: 72px;
                            height: 28px;
                            border-radius: 4px;
                            background: confirm-touch.has-hover ? #1177bb : Theme.accent;
                            accessible-role: button;
                            accessible-label: "Confirm";
                            accessible-action-default => {
                                root.lanczos-confirm-visible = false;
                                root.lanczos-confirm-accepted();
                                root.lanczos-confirm-from-backend-switch = false;
                            }

                            confirm-touch := TouchArea {
                                clicked => {
                                    root.lanczos-confirm-visible = false;
                                    root.lanczos-confirm-accepted();
                                    root.lanczos-confirm-from-backend-switch = false;
                                }
                            }

                            Text {
                                text: "Confirm";
                                color: white;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }
                    }
                }
            }
        }
    }

    if root.plugin-confirm-visible: Rectangle {
