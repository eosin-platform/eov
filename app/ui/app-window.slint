                            background: root.plugin-confirm-destructive
                                ? (plugin-confirm-touch.has-hover ? #c0392b : #e74c3c)
                                : (plugin-confirm-touch.has-hover ? #1177bb : Theme.accent);
                            accessible-role: button;
                            accessible-label: root.plugin-confirm-confirm-label;
                            accessible-action-default => {
                                root.plugin-confirm-visible = false;
                                root.plugin-confirm-accepted();
                            }

                            plugin-confirm-touch := TouchArea {
                                clicked => {
                                    root.plugin-confirm-visible = false;
                                    root.plugin-confirm-accepted();
                                }
                            }

                            confirm-text := Text {
                                text: root.plugin-confirm-confirm-label;
                                color: white;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }
                    }
                }
            }
        }
