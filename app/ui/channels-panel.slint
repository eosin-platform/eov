// The Channels panel: how each channel of a multichannel slide is shown
// (visibility, colour, display window, gamma), with auto contrast, colour
// palettes and one channel alone (AUDIT §14.3). It sits at the right so the
// slide stays visible while it changes.

import { Theme } from "theme.slint";
import { ChannelRow } from "types.slint";

component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    /// A toggle: assistive technology is told whether it is on (`active`).
    in property <bool> checkable: false;
    /// What the button acts on, for assistive technology.
    in property <string> description;
    callback clicked();

    width: label.preferred-width + 14px;
    height: 22px;
    border-radius: 4px;
    background: root.active ? Theme.accent : touch.has-hover ? Theme.surface-hover : transparent;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.description;
    accessible-checkable: root.checkable;
    accessible-checked: root.active;
    accessible-action-default => {
        root.clicked();
    }

    label := Text {
        text: root.text;
        color: Theme.text-primary;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component Check inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled(bool);

    width: 16px;
    height: 16px;
    border-radius: 3px;
    border-width: 1px;
    border-color: root.checked ? Theme.accent : Theme.border;
    background: root.checked ? Theme.accent : transparent;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.toggled(!root.checked);
    }

    if root.checked: Text {
        width: 100%;
        height: 100%;
        text: "✓";
        color: #ffffff;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    TouchArea {
        clicked => {
            root.toggled(!root.checked);
        }
    }
}

// A number shown as text; clicking it edits it, Enter applies. (A field
// created per edit starts from the current value, whatever was typed
// before.)
component ValueField inherits Rectangle {
    in property <string> text;
    in property <string> label;
    callback entered(string);
    property <bool> editing: false;

    width: 58px;
    height: 22px;
    border-radius: 3px;
    border-width: 1px;
    border-color: root.editing ? Theme.accent : Theme.border;
    background: #0a0c10;
    accessible-role: spinbox;
    accessible-label: root.label;
    accessible-value: root.text;
    accessible-action-default => {
        root.editing = true;
    }
    accessible-action-set-value(value) => {
        root.entered(value);
    }

    if !root.editing: Text {
        x: 6px;
        width: parent.width - 12px;
        height: 100%;
        text: root.text;
        color: Theme.text-primary;
        font-size: 11px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }

    if !root.editing: TouchArea {
        clicked => {
            root.editing = true;
        }
    }

    if root.editing: TextInput {
        x: 6px;
        width: parent.width - 12px;
        height: 100%;
        text: root.text;
        color: Theme.text-primary;
        font-size: 11px;
        horizontal-alignment: right;
        vertical-alignment: center;
        single-line: true;
        accessible-label: root.label;
        init => {
            self.focus();
            self.select-all();
        }
        accepted => {
            root.entered(self.text);
            root.editing = false;
        }
        changed has-focus => {
            if !self.has-focus {
                root.editing = false;
            }
        }
    }
}

// The display window over the channel's histogram: two handles, the
// nearer one follows the pointer.
component WindowSlider inherits Rectangle {
    in property <float> low;
    in property <float> high;
    in property <image> histogram;
    in property <color> accent;
    // The channel's name and the ends' values, for assistive technology.
    in property <string> name;
    in property <string> low-text;
    in property <string> high-text;
    callback moved(/* high */ bool, /* position */ float);
    property <length> pad: 5px;
    property <length> track: self.width - 2 * self.pad;
    property <bool> high-handle: false;

    height: 30px;

    Rectangle {
        x: root.pad;
        y: 0px;
        width: root.track;
        height: root.height - 6px;
        border-radius: 2px;
        background: #ffffff08;
        clip: true;

        Image {
            width: 100%;
            height: 100%;
            source: root.histogram;
            image-fit: fill;
            accessible-label: "Histogram of " + root.name;
        }
    }

    Rectangle {
        x: root.pad;
        y: root.height - 4px;
        width: root.track;
        height: 2px;
        background: #ffffff20;
    }

    Rectangle {
        x: root.pad + root.low * root.track;
        y: root.height - 4px;
        width: max(1px, (root.high - root.low) * root.track);
        height: 2px;
        background: root.accent;
    }

    for position[end] in [root.low, root.high]: Rectangle {
        x: root.pad + position * root.track - 2px;
        y: 0px;
        width: 4px;
        height: root.height;
        border-radius: 2px;
        background: #ffffffd0;
        accessible-role: slider;
        accessible-label: end == 0 ? "Lower end of " + root.name : "Upper end of " + root.name;
        accessible-value: end == 0 ? root.low-text : root.high-text;
        accessible-value-minimum: 0;
        accessible-value-maximum: 1;
        accessible-value-step: 0.01;
        accessible-action-increment => {
            root.moved(end == 1, min(1.0, position + 0.01));
        }
        accessible-action-decrement => {
            root.moved(end == 1, max(0.0, position - 0.01));
        }
    }

    TouchArea {
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            let position = max(0.0, min(1.0, (self.mouse-x - root.pad) / max(root.track, 1px)));
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.high-handle = abs(position - root.high) < abs(position - root.low)
                    || (abs(root.high - root.low) < 0.001 && position > root.high);
                root.moved(root.high-handle, position);
            } else if e.kind == PointerEventKind.move && self.pressed {
                root.moved(root.high-handle, position);
            }
        }
    }
}

// Gamma on a logarithmic slider, 1 in the middle; double-click resets.
component GammaSlider inherits Rectangle {
    in property <float> position;
    in property <string> label;
    in property <string> value-text;
    callback moved(float);
    property <length> pad: 5px;
    property <length> track: self.width - 2 * self.pad;

    height: 22px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value-text;
    accessible-value-minimum: 0;
    accessible-value-maximum: 1;
    accessible-value-step: 0.02;
    accessible-action-increment => {
        root.moved(min(1.0, root.position + 0.02));
    }
    accessible-action-decrement => {
        root.moved(max(0.0, root.position - 0.02));
    }

    Rectangle {
        x: root.pad;
        y: (parent.height - 3px) / 2;
        width: root.track;
        height: 3px;
        border-radius: 1.5px;
        background: #ffffff20;
    }

    // The middle mark: gamma 1.
    Rectangle {
        x: root.pad + 0.5 * root.track - 0.5px;
        y: (parent.height - 9px) / 2;
        width: 1px;
        height: 9px;
        background: #ffffff40;
    }

    Rectangle {
        x: root.pad + root.position * root.track - 5px;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: #ffffff;
        border-width: 1px;
        border-color: Theme.accent;
    }

    TouchArea {
        double-clicked => {
            root.moved(0.5);
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed) {
                root.moved(max(0.0, min(1.0, (self.mouse-x - root.pad) / max(root.track, 1px))));
            }
        }
    }
}

export component ChannelsPanel inherits Rectangle {
    in property <string> title;
    in property <string> summary;
    in property <[ChannelRow]> rows;
    // The colours offered for a channel (every palette's).
    in property <[color]> chip-colors;
    // The row whose colour choices are open (-1: none).
    in-out property <int> picker-row: -1;
    callback close-requested();
    callback visibility-toggled(int, bool);
    callback solo-toggled(int);
    callback color-chosen(int, color);
    callback window-moved(int, bool, float);
    callback min-entered(int, string);
    callback max-entered(int, string);
    callback gamma-moved(int, float);
    callback gamma-entered(int, string);
    callback auto-contrast-requested();
    callback reset-requested();
    callback show-all-requested();
    callback palette-requested(string);

    background: #00000030;

    TouchArea {
        clicked => {
            root.close-requested();
        }
    }

    FocusScope {
        init => {
            self.focus();
        }
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.close-requested();
                return accept;
            }
            reject
        }

        Rectangle {
            x: parent.width - self.width - 16px;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 32px, 700px);
            height: min(parent.height - 48px, 680px);
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            TouchArea { }

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 8px;

                    Text {
                        horizontal-stretch: 1;
                        text: root.title;
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 4px;
                        background: close-touch.has-hover ? Theme.surface-hover : transparent;
                        accessible-role: button;
                        accessible-label: "Close";
                        accessible-action-default => {
                            root.close-requested();
                        }

                        Text {
                            text: "✕";
                            color: Theme.text-secondary;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            accessible-role: none;
                        }

                        close-touch := TouchArea {
                            clicked => {
                                root.close-requested();
                            }
                        }
                    }
                }

                Text {
                    vertical-stretch: 0;
                    text: root.summary;
                    color: Theme.text-secondary;
                    font-size: 11px;
                }

                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 6px;
                    height: 24px;

                    VerticalLayout {
                        alignment: center;
                        SmallButton {
                            text: "Auto contrast";
                            clicked => {
                                root.auto-contrast-requested();
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        SmallButton {
                            text: "Show all";
                            clicked => {
                                root.show-all-requested();
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        SmallButton {
                            text: "Reset";
                            clicked => {
                                root.picker-row = -1;
                                root.reset-requested();
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: "Colours:";
                        color: Theme.text-secondary;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    for palette in [
                        { id: "standard", name: "Standard" },
                        { id: "colour-blind-safe", name: "Colour-blind safe" },
                        { id: "okabe-ito", name: "Okabe–Ito" },
                    ]: VerticalLayout {
                        alignment: center;
                        SmallButton {
                            text: palette.name;
                            description: "Colour palette";
                            clicked => {
                                root.palette-requested(palette.id);
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    min-height: 80px;

                    Flickable {
                        width: parent.width;
                        height: parent.height;
                        viewport-height: list.preferred-height;

                        list := VerticalLayout {
                            spacing: 4px;

                            for row in root.rows: Rectangle {
                                border-radius: 4px;
                                background: Math.mod(row.index, 2) == 0 ? transparent : #ffffff05;

                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 4px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        height: 22px;

                                        VerticalLayout {
                                            alignment: center;
                                            Check {
                                                checked: row.visible;
                                                label: "Show " + row.name;
                                                toggled(visible) => {
                                                    root.visibility-toggled(row.index, visible);
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 20px;
                                                height: 16px;
                                                border-radius: 3px;
                                                background: row.color;
                                                border-width: 1px;
                                                border-color: root.picker-row == row.index ? #ffffff : #ffffff40;
                                                accessible-role: button;
                                                accessible-label: "Colour of " + row.name;
                                                accessible-expandable: true;
                                                accessible-expanded: root.picker-row == row.index;
                                                accessible-action-default => {
                                                    root.picker-row = root.picker-row == row.index ? -1 : row.index;
                                                }

                                                TouchArea {
                                                    clicked => {
                                                        root.picker-row = root.picker-row == row.index ? -1 : row.index;
                                                    }
                                                }
                                            }
                                        }

                                        Text {
                                            horizontal-stretch: 1;
                                            text: row.name;
                                            color: row.visible ? Theme.text-primary : Theme.text-secondary;
                                            accessible-description: row.detail;
                                            font-size: 12px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: row.detail;
                                            color: Theme.text-secondary;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            SmallButton {
                                                text: "Solo";
                                                active: row.solo;
                                                checkable: true;
                                                description: "Show " + row.name + " alone";
                                                clicked => {
                                                    root.solo-toggled(row.index);
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 30px;

                                        WindowSlider {
                                            horizontal-stretch: 1;
                                            low: row.low;
                                            high: row.high;
                                            histogram: row.histogram;
                                            accent: row.color;
                                            name: row.name;
                                            low-text: row.min-text;
                                            high-text: row.max-text;
                                            moved(high, position) => {
                                                root.window-moved(row.index, high, position);
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            ValueField {
                                                text: row.min-text;
                                                label: "Minimum of " + row.name;
                                                entered(text) => {
                                                    root.min-entered(row.index, text);
                                                }
                                            }
                                        }

                                        Text {
                                            text: "–";
                                            color: Theme.text-secondary;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            accessible-role: none;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            ValueField {
                                                text: row.max-text;
                                                label: "Maximum of " + row.name;
                                                entered(text) => {
                                                    root.max-entered(row.index, text);
                                                }
                                            }
                                        }

                                        Text {
                                            text: "γ";
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            accessible-role: none;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            GammaSlider {
                                                width: 72px;
                                                position: row.gamma-position;
                                                label: "Gamma of " + row.name;
                                                value-text: row.gamma-text;
                                                moved(position) => {
                                                    root.gamma-moved(row.index, position);
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            ValueField {
                                                width: 42px;
                                                text: row.gamma-text;
                                                label: "Gamma of " + row.name;
                                                entered(text) => {
                                                    root.gamma-entered(row.index, text);
                                                }
                                            }
                                        }
                                    }

                                    if root.picker-row == row.index: HorizontalLayout {
                                        spacing: 4px;
                                        height: 22px;
                                        alignment: start;

                                        for chip[chip-index] in root.chip-colors: Rectangle {
                                            width: 22px;
                                            height: 20px;
                                            border-radius: 3px;
                                            background: chip;
                                            border-width: 1px;
                                            border-color: chip-touch.has-hover ? #ffffff : #ffffff30;
                                            accessible-role: button;
                                            accessible-label: "Colour " + (chip-index + 1) + " of " + root.chip-colors.length;
                                            accessible-action-default => {
                                                root.color-chosen(row.index, chip);
                                                root.picker-row = -1;
                                            }

                                            chip-touch := TouchArea {
                                                clicked => {
                                                    root.color-chosen(row.index, chip);
                                                    root.picker-row = -1;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Text {
                    vertical-stretch: 0;
                    text: "Windows are in the file's sample values: at the lower end a channel is black, at the upper end its full colour. γ above 1 brightens dim signal. Settings are kept for this slide; exports and plugins see the same picture.";
                    color: Theme.text-secondary;
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
