import { Theme } from "theme.slint";
import {
    MeasurementUnit,
    PaneViewData,
    RecentFileData,
    StainNormalization,
} from "types.slint";
import { HomeScreen } from "home-screen.slint";
import { TabBar } from "tab-controls.slint";
import { Viewport } from "viewport.slint";

component PaneView inherits Rectangle {
    in property <PaneViewData> pane-data;
    in property <string> status-text;
    in property <[RecentFileData]> recent-files: [];
    in property <bool> show-minimap: true;
    in property <bool> show-metadata: false;
    in property <bool> show-scale-bar: true;
    in property <bool> debug-mode: false;
    in property <float> fps: 0;
    in property <int> focused-pane: 0;
    in property <int> dragging-tab-id: -1;
    in property <int> drag-source-pane: -1;
    in property <int> drag-source-index: -1;
    in property <length> drag-abs-x: -1px;
    in property <int> drop-target-pane: -1;
    in property <int> split-drop-side: -1;
    in property <int> os-file-hover-pane: -1;
    in property <int> os-file-hover-side: -1;

    callback tab-activated(int, int);
    callback tab-close-requested(int, int);
    callback tab-context-menu(int, int, length, length);
    callback new-tab-requested(int);
    callback open-file-requested();
    callback open-recent-file(string);
    callback viewport-fit-to-view();
    callback viewport-pointer(/* pane */ int, int, int, float, float, float, float, bool, bool, bool, bool);
    callback viewport-wheel(/* pane */ int, float, float, float, float, bool, bool, bool, bool);
    callback viewport-pinch(/* pane */ int, float, float, float, bool);
    callback viewport-key(/* pane */ int, string, bool, bool, bool, bool, bool, bool) -> bool;
    callback minimap-navigate(float, float);
    callback minimap-drag-start();
    callback minimap-drag-end();
    callback viewport-interaction-started(int);
    callback pane-focused(int);
    callback tab-drag-started(int, int, string, int, length, length);
    callback tab-drag-moved(length, length);
    callback tab-drag-ended(length, length);
    callback zoom-slider-changed(int, float);
    callback tab-tooltip-changed(bool, string, length, length);
    callback hud-toggle-dropdown(int);
    callback hud-sharpness-changed(int, float);
    callback hud-gamma-changed(int, float);
    callback hud-brightness-changed(int, float);
    callback hud-contrast-changed(int, float);
    callback hud-measurement-unit-changed(int, MeasurementUnit);
    callback hud-stain-normalization-changed(int, StainNormalization);
    callback hud-reset-adjustments(int);
    callback hud-zoom-input(int, string);
    callback hud-zoom-in(int);
    callback hud-orientation-changed(int, int);
    callback hud-rotation-input(int, string);
    callback hud-color-management-toggled(int);
    callback hud-zoom-out(int);
    callback hud-deconv-h-intensity-changed(int, float);
    callback hud-deconv-e-intensity-changed(int, float);
    callback hud-deconv-h-visibility-toggled(int);
    callback hud-deconv-e-visibility-toggled(int);
    callback hud-deconv-h-view-toggled(int);
    callback hud-deconv-e-view-toggled(int);
    callback hud-plugin-button-clicked(int, string, string, string);

    border-width: 0px;
    border-color: transparent;
    background: dragging-tab-id != -1 && drop-target-pane == pane-data.id ? Theme.subtle-fill : transparent;

    VerticalLayout {
        pane-tab-bar := TabBar {
            pane-id: root.pane-data.id;
            tabs: root.pane-data.tabs;
            dragging-tab-id: root.dragging-tab-id;
            drag-source-pane: root.drag-source-pane;
            drag-source-index: root.drag-source-index;
            drag-abs-x: root.drag-abs-x;
            is-drop-target: root.drop-target-pane == root.pane-data.id;
            show-drop-indicator: root.split-drop-side == -1;
            tab-activated(pane, id) => {
                root.tab-activated(pane, id);
            }
            tab-close-requested(pane, id) => {
                root.tab-close-requested(pane, id);
            }
            tab-context-menu(pane, id, x, y) => {
                root.tab-context-menu(pane, id, x, y);
            }
            new-tab-requested(pane) => {
                root.new-tab-requested(pane);
            }
            tab-drag-started(id, pane, title, index, abs-x, abs-y) => {
                root.tab-drag-started(id, pane, title, index, abs-x, abs-y);
            }
            tab-drag-moved(abs-x, abs-y) => {
                root.tab-drag-moved(abs-x, abs-y);
            }
            tab-drag-ended(abs-x, abs-y) => {
                root.tab-drag-ended(abs-x, abs-y);
            }
            tab-tooltip-changed(visible, text, cx, ty) => {
                root.tab-tooltip-changed(visible, text, cx, ty);
            }
        }

        Rectangle {
            vertical-stretch: 1;

            if root.pane-data.is-home-tab || root.pane-data.tabs.length == 0: HomeScreen {
                recent-files: root.recent-files;
                open-file-requested => {
                    root.pane-focused(root.pane-data.id);
                    root.open-file-requested();
                }
                open-recent-file(path) => {
                    root.pane-focused(root.pane-data.id);
                    root.open-recent-file(path);
                }
            }

            if !root.pane-data.is-home-tab && root.pane-data.tabs.length > 0: Viewport {
                content: root.pane-data.content;
                viewport-info: root.pane-data.viewport-info;
                zoom-display-text: root.pane-data.zoom-display-text;
                zoom-input-text: root.pane-data.zoom-input-text;
                zoom-tooltip: root.pane-data.zoom-tooltip;
                minimap-thumbnail: root.pane-data.minimap-thumbnail;
                minimap-rect: root.pane-data.minimap-rect;
                show-minimap: root.show-minimap;
                metadata-items: root.pane-data.metadata-items;
                show-metadata: root.show-metadata;
                show-scale-bar: root.show-scale-bar;
                status-text: root.status-text;
                is-loading: root.pane-data.is-loading;
                overlay: root.pane-data.overlay;
                overlay-x: root.pane-data.overlay-x;
                overlay-y: root.pane-data.overlay-y;
                overlay-width: root.pane-data.overlay-width;
                overlay-height: root.pane-data.overlay-height;
                overlay-labels: root.pane-data.overlay-labels;
                cursor: root.pane-data.cursor;
                debug-mode: root.debug-mode;
                fps: root.fps;
                zoom-slider-position: root.pane-data.zoom-slider-position;
                hud: root.pane-data.hud;
                pane-id: root.pane-data.id;
                plugin-hud-buttons: root.pane-data.hud-buttons;

                fit-to-view => {
                    root.pane-focused(root.pane-data.id);
                    root.viewport-fit-to-view();
                }
                pointer-input(kind, button, x, y, wx, wy, shift, control, alt, meta) => {
                    root.viewport-pointer(root.pane-data.id, kind, button, x, y, wx, wy, shift, control, alt, meta);
                }
                wheel-input(dx, dy, x, y, shift, control, alt, meta) => {
                    root.pane-focused(root.pane-data.id);
                    root.viewport-wheel(root.pane-data.id, dx, dy, x, y, shift, control, alt, meta);
                }
                pinch-input(scale, x, y, active) => {
                    root.viewport-pinch(root.pane-data.id, scale, x, y, active);
                }
                key-input(text, shift, control, alt, meta, pressed, repeat) => {
                    root.viewport-key(root.pane-data.id, text, shift, control, alt, meta, pressed, repeat)
                }
                minimap-navigate(nx, ny) => {
                    root.pane-focused(root.pane-data.id);
                    root.minimap-navigate(nx, ny);
                }
                minimap-drag-start => {
                    root.pane-focused(root.pane-data.id);
                    root.minimap-drag-start();
                }
                minimap-drag-end => {
                    root.minimap-drag-end();
                }
                zoom-slider-changed(value) => {
                    root.pane-focused(root.pane-data.id);
                    root.zoom-slider-changed(root.pane-data.id, value);
                }
                interaction-started => {
                    // Every pointer press focuses its pane first, so tool
                    // gestures are applied to this pane's slide.
                    root.pane-focused(root.pane-data.id);
                    root.viewport-interaction-started(root.pane-data.id);
                }
                hud-toggle-dropdown => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-toggle-dropdown(root.pane-data.id);
                }
                hud-sharpness-changed(v) => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-sharpness-changed(root.pane-data.id, v);
                }
                hud-gamma-changed(v) => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-gamma-changed(root.pane-data.id, v);
                }
                hud-brightness-changed(v) => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-brightness-changed(root.pane-data.id, v);
                }
                hud-contrast-changed(v) => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-contrast-changed(root.pane-data.id, v);
                }
                hud-measurement-unit-changed(u) => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-measurement-unit-changed(root.pane-data.id, u);
                }
                hud-stain-normalization-changed(s) => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-stain-normalization-changed(root.pane-data.id, s);
                }
                hud-reset-adjustments => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-reset-adjustments(root.pane-data.id);
                }
                hud-zoom-input(v) => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-zoom-input(root.pane-data.id, v);
                }
                hud-zoom-in => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-zoom-in(root.pane-data.id);
                }
                hud-color-management-toggled => {
                    root.hud-color-management-toggled(root.pane-data.id);
                }
                hud-orientation-changed(action) => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-orientation-changed(root.pane-data.id, action);
                }
                hud-rotation-input(text) => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-rotation-input(root.pane-data.id, text);
                }
                hud-zoom-out => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-zoom-out(root.pane-data.id);
                }
                hud-deconv-h-intensity-changed(v) => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-deconv-h-intensity-changed(root.pane-data.id, v);
                }
                hud-deconv-e-intensity-changed(v) => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-deconv-e-intensity-changed(root.pane-data.id, v);
                }
                hud-deconv-h-visibility-toggled => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-deconv-h-visibility-toggled(root.pane-data.id);
                }
                hud-deconv-e-visibility-toggled => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-deconv-e-visibility-toggled(root.pane-data.id);
                }
                hud-deconv-h-view-toggled => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-deconv-h-view-toggled(root.pane-data.id);
                }
                hud-deconv-e-view-toggled => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-deconv-e-view-toggled(root.pane-data.id);
                }
                hud-plugin-button-clicked(plugin-id, button-id, item-id) => {
                    root.pane-focused(root.pane-data.id);
                    root.hud-plugin-button-clicked(root.pane-data.id, plugin-id, button-id, item-id);
                }
            }
        }
    }

    if dragging-tab-id != -1 && drop-target-pane == pane-data.id: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: transparent;
        border-width: 2px;
        border-color: Theme.text-strong;
    }

    // OS file drag hover: center zone (no split) - subtle highlight
    if root.os-file-hover-pane == root.pane-data.id && root.os-file-hover-side == -1: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: Theme.drop-fill;
        border-width: 2px;
        border-color: Theme.drop-border;
    }

    // OS file drag hover: split overlay (left or right)
    if root.os-file-hover-pane == root.pane-data.id && root.os-file-hover-side != -1: Rectangle {
        x: 0px;
        y: 35px;
        width: parent.width;
        height: parent.height - 35px;
        background: Theme.drop-scrim;

        Rectangle {
            x: root.os-file-hover-side == 0 ? 10px : parent.width / 2 + 5px;
            y: 10px;
            width: parent.width / 2 - 15px;
            height: parent.height - 20px;
            border-radius: 8px;
            background: Theme.drop-zone-fill;
            border-width: 2px;
            border-color: Theme.drop-border;

            Text {
                text: root.os-file-hover-side == 0 ? @tr("Open Left") : @tr("Open Right");
                color: Theme.drop-text;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            x: parent.width / 2 - 1px;
            y: 10px;
            width: 2px;
            height: parent.height - 20px;
            background: Theme.drop-divider;
        }
    }

    if root.dragging-tab-id != -1 && root.drop-target-pane == root.pane-data.id && root.split-drop-side != -1: Rectangle {
        x: 0px;
        y: 35px;
        width: parent.width;
        height: parent.height - 35px;
        background: Theme.drop-scrim;

        Rectangle {
            x: root.split-drop-side == 0 ? 10px : parent.width / 2 + 5px;
            y: 10px;
            width: parent.width / 2 - 15px;
            height: parent.height - 20px;
            border-radius: 8px;
            background: Theme.drop-zone-fill;
            border-width: 2px;
            border-color: Theme.drop-border;

            Text {
                text: root.split-drop-side == 0 ? @tr("Create Left Pane") : @tr("Create Right Pane");
                color: Theme.drop-text;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            x: parent.width / 2 - 1px;
            y: 10px;
            width: 2px;
            height: parent.height - 20px;
            background: Theme.drop-divider;
        }
    }
}

export component SplitPaneContainer inherits Rectangle {
    in property <[PaneViewData]> panes: [];
    in property <string> status-text;
    in property <bool> show-minimap: true;
    in property <bool> show-metadata: false;
    in property <bool> show-scale-bar: true;
    in property <bool> split-enabled: false;
    in property <int> focused-pane: 0;
    in property <bool> debug-mode: false;
    in property <float> fps: 0;
    in property <[RecentFileData]> recent-files: [];
    in property <int> dragging-tab-id: -1;
    in property <int> drag-source-pane: -1;
    in property <int> drag-source-index: -1;
    in property <string> dragging-tab-title: "";
    in property <int> drop-target-pane: -1;
    in property <int> split-drop-side: -1;
    in property <length> drag-abs-x: -1px;
    in property <int> os-file-hover-pane: -1;
    in property <int> os-file-hover-side: -1;
    // PANE_GAP in state.rs, and pane-gap in app-window.slint, must match.
    property <length> pane-gap: 6px;
    property <int> pane-count: max(1, panes.length);
    property <length> pane-width: (self.width - max(0px, (pane-count - 1) * pane-gap)) / pane-count;
    property <length> pane-stride: pane-width + pane-gap;
    property <int> target-tab-count: drop-target-pane >= 0 && drop-target-pane < panes.length ? panes[drop-target-pane].tabs.length : 0;
    property <length> target-local-x: drop-target-pane >= 0 ? drag-abs-x - drop-target-pane * pane-stride : -1px;
    property <length> target-slot-width: target-tab-count > 0 ? max(101px, (pane-width - 40px) / target-tab-count) : 101px;
    property <int> raw-drop-index: dragging-tab-id == -1 || split-drop-side != -1 || drop-target-pane < 0 ? -1 : Math.max(0, Math.min(target-tab-count, Math.round((target-local-x - 4px) / target-slot-width)));
    out property <int> active-drop-index: drag-source-pane == drop-target-pane && drag-source-index >= 0 && (raw-drop-index == drag_source_index || raw-drop-index == drag_source_index + 1) ? -1 : raw-drop-index;

    callback tab-activated(int, int);
    callback tab-close-requested(int, int);
    callback tab-context-menu(int, int, length, length);
    callback new-tab-requested(int);
    callback open-file-requested();
    callback open-recent-file(string);
    callback viewport-fit-to-view();
    callback viewport-pointer(int, int, int, float, float, float, float, bool, bool, bool, bool);
    callback viewport-wheel(int, float, float, float, float, bool, bool, bool, bool);
    callback viewport-pinch(int, float, float, float, bool);
    callback viewport-key(int, string, bool, bool, bool, bool, bool, bool) -> bool;
    callback minimap-navigate(float, float);
    callback minimap-drag-start();
    callback minimap-drag-end();
    callback viewport-interaction-started(int);
    callback pane-focused(int);
    callback tab-drag-started(int, int, string, int, length, length);
    callback tab-drag-moved(length, length);
    callback tab-drag-ended(length, length);
    callback move-tab-to-pane(int, int, int);
    callback split-tab-by-drop(int, int);
    callback reorder-tab(int, int, int);
    callback clear-tab-drag();
    callback zoom-slider-changed(int, float);
    callback tab-tooltip-changed(bool, string, length, length);
    callback hud-toggle-dropdown(int);
    callback hud-sharpness-changed(int, float);
    callback hud-gamma-changed(int, float);
    callback hud-brightness-changed(int, float);
    callback hud-contrast-changed(int, float);
    callback hud-measurement-unit-changed(int, MeasurementUnit);
    callback hud-stain-normalization-changed(int, StainNormalization);
    callback hud-reset-adjustments(int);
    callback hud-zoom-input(int, string);
    callback hud-zoom-in(int);
    callback hud-orientation-changed(int, int);
    callback hud-rotation-input(int, string);
    callback hud-color-management-toggled(int);
    callback hud-zoom-out(int);
    callback hud-deconv-h-intensity-changed(int, float);
    callback hud-deconv-e-intensity-changed(int, float);
    callback hud-deconv-h-visibility-toggled(int);
    callback hud-deconv-e-visibility-toggled(int);
    callback hud-deconv-h-view-toggled(int);
    callback hud-deconv-e-view-toggled(int);
    callback hud-plugin-button-clicked(int, string, string, string);

    background: Theme.background;

    HorizontalLayout {
        vertical-stretch: 1;
        spacing: root.pane-gap;

        for pane[i] in panes: PaneView {
            width: root.pane-width;
            pane-data: pane;
            status-text: root.status-text;
            recent-files: root.recent-files;
            show-minimap: root.show-minimap;
            show-metadata: root.show-metadata;
            show-scale-bar: root.show-scale-bar;
            debug-mode: root.debug-mode;
            fps: root.fps;
            focused-pane: root.focused-pane;
            dragging-tab-id: root.dragging-tab-id;
            drag-source-pane: root.drag-source-pane;
            drag-source-index: root.drag_source_index;
            drag-abs-x: root.drag-abs-x;
            drop-target-pane: root.drop-target-pane;
            split-drop-side: root.split-drop-side;
            os-file-hover-pane: root.os-file-hover-pane;
            os-file-hover-side: root.os-file-hover-side;

            tab-activated(pane-id, id) => {
                root.tab-activated(pane-id, id);
            }
            tab-close-requested(pane-id, id) => {
                root.tab-close-requested(pane-id, id);
            }
            tab-context-menu(pane-id, id, x, y) => {
                root.tab-context-menu(pane-id, id, x, y);
            }
            new-tab-requested(pane-id) => {
                root.new-tab-requested(pane-id);
            }
            open-file-requested => {
                root.open-file-requested();
            }
            open-recent-file(path) => {
                root.open-recent-file(path);
            }
            viewport-fit-to-view => {
                root.viewport-fit-to-view();
            }
            viewport-pointer(pane-id, kind, button, x, y, wx, wy, shift, control, alt, meta) => {
                root.viewport-pointer(pane-id, kind, button, x, y, wx, wy, shift, control, alt, meta);
            }
            viewport-wheel(pane-id, dx, dy, x, y, shift, control, alt, meta) => {
                root.viewport-wheel(pane-id, dx, dy, x, y, shift, control, alt, meta);
            }
            viewport-pinch(pane-id, scale, x, y, active) => {
                root.viewport-pinch(pane-id, scale, x, y, active);
            }
            viewport-key(pane-id, text, shift, control, alt, meta, pressed, repeat) => {
                root.viewport-key(pane-id, text, shift, control, alt, meta, pressed, repeat)
            }
            minimap-navigate(nx, ny) => {
                root.minimap-navigate(nx, ny);
            }
            minimap-drag-start => {
                root.minimap-drag-start();
            }
            minimap-drag-end => {
                root.minimap-drag-end();
            }
            viewport-interaction-started(pane-id) => {
                root.viewport-interaction-started(pane-id);
            }
            pane-focused(pane-id) => {
                root.pane-focused(pane-id);
            }
            tab-drag-started(id, pane-id, title, index, abs-x, abs-y) => {
                root.tab-drag-started(id, pane-id, title, index, abs-x, abs-y);
            }
            tab-drag-moved(abs-x, abs-y) => {
                root.tab-drag-moved(abs-x, abs-y);
            }
            tab-drag-ended(abs-x, abs-y) => {
                root.tab-drag-ended(abs-x, abs-y);
            }
            zoom-slider-changed(pane-id, value) => {
                root.zoom-slider-changed(pane-id, value);
            }
            tab-tooltip-changed(visible, text, cx, ty) => {
                root.tab-tooltip-changed(visible, text, cx, ty);
            }
            hud-toggle-dropdown(pane-id) => {
                root.hud-toggle-dropdown(pane-id);
            }
            hud-sharpness-changed(pane-id, v) => {
                root.hud-sharpness-changed(pane-id, v);
            }
            hud-gamma-changed(pane-id, v) => {
                root.hud-gamma-changed(pane-id, v);
            }
            hud-brightness-changed(pane-id, v) => {
                root.hud-brightness-changed(pane-id, v);
            }
            hud-contrast-changed(pane-id, v) => {
                root.hud-contrast-changed(pane-id, v);
            }
            hud-measurement-unit-changed(pane-id, u) => {
