import { Locale } from "locale.slint";
import { Theme, ThemeKind } from "theme.slint";
import {
    FilteringMode,
    PluginButtonData,
    RenderMode,
    ShortcutLabels,
    ToolType,
} from "types.slint";
import {
    MetadataToolButton,
    MinimapToolButton,
    OpenFileToolButton,
    RoiToolButton,
    SvgToolButton,
    ToolButton,
} from "tab-controls.slint";

// The line between two groups of toolbar buttons, left out where its group
// starts a row (when the buttons wrap).
component GroupSeparator {
    in property <bool> shown: true;

    width: 1px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 1px;
        height: 24px;
        background: Theme.border;
        visible: root.shown;
    }
}

// Holds a button that can be disabled. A disabled button ignores the
// pointer, which would hand its presses to the title bar's drag handler
// behind it (a double click on a greyed-out Undo would maximize the window):
// the touch area under the button takes them instead.
component GuardedSlot {
    width: 32px;
    height: 28px;

    TouchArea { }

    @children
}

export component WindowToolbar inherits Rectangle {
    in property <ToolType> current-tool: ToolType.navigate;
    in property <RenderMode> render-mode: RenderMode.cpu;
    in property <bool> gpu-rendering-available: false;
    in property <bool> show-minimap: true;
    in property <bool> show-series-bar: false;
    in property <bool> show-metadata: false;
    in property <bool> show-scale-bar: true;
    in property <bool> viewport-lock-enabled: false;
    // Linked navigation across different slides, and adjusting it.
    in property <bool> slide-link-enabled: false;
    in property <bool> alignment-adjust-enabled: false;
    in property <bool> use-native-window-controls: false;
    in property <bool> undo-enabled: false;
    in property <bool> redo-enabled: false;
    // What undo/redo would revert ("Add marker", "Set region of interest").
    in property <string> undo-label: "";
    in property <string> redo-label: "";
    in property <string> measure-mode-label: @tr("Distance");
    in property <int> plugin-count: 0;
    in property <bool> plugin-problems: false;
    in property <FilteringMode> filtering-mode: FilteringMode.trilinear;
    in property <int> filtering-mode-index: filtering-mode == FilteringMode.bilinear ? 0 : filtering-mode == FilteringMode.trilinear ? 1 : 2;
    in-out property <bool> filter-popup-visible: false;
    in property <[PluginButtonData]> plugin-buttons: [];
    property <string> plugin-hovered-tooltip-text: "";
    property <length> plugin-hovered-tooltip-center-x: 0px;
    property <length> plugin-hovered-tooltip-top-y: 0px;
    /// Keys from the shortcut table, for tooltips.
    in property <ShortcutLabels> shortcuts;
    // Translators: tooltip of Undo; {} names the edit it reverts ("Add measurement", or a plugin's own wording).
    property <string> undo-text: root.undo-label != "" ? @tr("Undo {}", root.undo-label)
        : @tr("Undo");
    // Translators: tooltip of Redo; {} names the edit it repeats ("Add measurement", or a plugin's own wording).
    property <string> redo-text: root.redo-label != "" ? @tr("Redo {}", root.redo-label)
        : @tr("Redo");
    property <string> undo-tooltip-text: root.shortcuts.undo == "" ? root.undo-text
        // A tooltip and the key of its shortcut ("Undo (Ctrl+Z)").
        : @tr("{} ({})", root.undo-text, Locale.isolate(root.shortcuts.undo));
    property <string> redo-tooltip-text: root.shortcuts.redo == "" ? root.redo-text
        // A tooltip and the key of its shortcut ("Redo (Ctrl+Y)").
        : @tr("{} ({})", root.redo-text, Locale.isolate(root.shortcuts.redo));

    callback open-file-requested();
    callback open-recent-menu-requested(length, length);
    callback toggle-series-bar-requested();
    callback toggle-minimap-requested();
    callback toggle-metadata-requested();
    callback toggle-scale-bar-requested();
    callback toggle-viewport-lock-requested();
    callback toggle-slide-link-requested();
    callback toggle-alignment-adjust-requested();
    callback tool-selected(ToolType);
    callback render-backend-selected(RenderMode);
    callback filtering-mode-selected(FilteringMode);
    callback dataset-export-requested();
    callback plugin-button-clicked(/* plugin */ string, /* button or tool */ string, /* is tool */ bool);
    callback undo-requested();
    callback redo-requested();
    callback measure-mode-menu-requested(length, length);
    callback plugins-panel-requested();
    // The theme menu, at this window position.
    callback theme-menu-requested(length, length);
    /// The Language dialog.
    callback language-requested();
    callback window-minimize();
    callback window-maximize();
    callback window-close();

    // Pressed on the title bar where there is no control: the window moves
    // when the pointer goes on to move (callbacks.rs).
    out property <bool> drag-handle-pressed: drag-touch.pressed;
    out property <length> filter-combo-abs-x: filter-combo-area.absolute-position.x;
    out property <length> filter-combo-abs-y: filter-combo-area.absolute-position.y + filter-combo-area.height + 2px;
    out property <length> filter-combo-width: filter-combo-area.width;
    out property <bool> hovered-tooltip-visible: hovered-tooltip-text != "";
    out property <string> hovered-tooltip-text:
        open-button.hovered ? open-button.tooltip-text : undo-button.hovered ? undo-button.tooltip-text : redo-button.hovered ? redo-button.tooltip-text : series-button.hovered ? series-button.tooltip-text : minimap-button.hovered ? minimap-button.tooltip-text : viewport-lock-button.hovered ? viewport-lock-button.tooltip-text : link-button.hovered ? link-button.tooltip-text : align-button.hovered ? align-button.tooltip-text : navigate-button.hovered ? navigate-button.tooltip-text : roi-button.hovered ? roi-button.tooltip-text : measure-button.hovered ? measure-button.tooltip-text : cpu-button.hovered ? cpu-button.tooltip-text : gpu-button.hovered ? gpu-button.tooltip-text : metadata-button.hovered ? metadata-button.tooltip-text : scale-bar-button.hovered ? scale-bar-button.tooltip-text : theme-button.hovered ? theme-button.tooltip-text : dataset-export-button.hovered ? dataset-export-button.tooltip-text : plugins-button.hovered ? plugins-button.tooltip-text : root.plugin-hovered-tooltip-text != "" ? root.plugin-hovered-tooltip-text : !root.use-native-window-controls && minimize-touch.has-hover ? @tr("Minimize window") : !root.use-native-window-controls && maximize-touch.has-hover ? @tr("Maximize window") : !root.use-native-window-controls && close-win-touch.has-hover ? @tr("Close window") : "";
    out property <length> hovered-tooltip-center-x:
        open-button.hovered ? open-button.absolute-position.x + open-button.width / 2 : undo-button.hovered ? undo-button.absolute-position.x + undo-button.width / 2 : redo-button.hovered ? redo-button.absolute-position.x + redo-button.width / 2 : series-button.hovered ? series-button.absolute-position.x + series-button.width / 2 : minimap-button.hovered ? minimap-button.absolute-position.x + minimap-button.width / 2 : viewport-lock-button.hovered ? viewport-lock-button.absolute-position.x + viewport-lock-button.width / 2 : link-button.hovered ? link-button.absolute-position.x + link-button.width / 2 : align-button.hovered ? align-button.absolute-position.x + align-button.width / 2 : navigate-button.hovered ? navigate-button.absolute-position.x + navigate-button.width / 2 : roi-button.hovered ? roi-button.absolute-position.x + roi-button.width / 2 : measure-button.hovered ? measure-button.absolute-position.x + measure-button.width / 2 : cpu-button.hovered ? cpu-button.absolute-position.x + cpu-button.width / 2 : gpu-button.hovered ? gpu-button.absolute-position.x + gpu-button.width / 2 : metadata-button.hovered ? metadata-button.absolute-position.x + metadata-button.width / 2 : scale-bar-button.hovered ? scale-bar-button.absolute-position.x + scale-bar-button.width / 2 : theme-button.hovered ? theme-button.absolute-position.x + theme-button.width / 2 : dataset-export-button.hovered ? dataset-export-button.absolute-position.x + dataset-export-button.width / 2 : plugins-button.hovered ? plugins-button.absolute-position.x + plugins-button.width / 2 : root.plugin-hovered-tooltip-text != "" ? root.plugin-hovered-tooltip-center-x : !root.use-native-window-controls && minimize-touch.has-hover ? minimize-control.absolute-position.x + minimize-control.width / 2 : !root.use-native-window-controls && maximize-touch.has-hover ? maximize-control.absolute-position.x + maximize_control.width / 2 : !root.use-native-window-controls && close-win-touch.has-hover ? close-control.absolute-position.x + close_control.width / 2 : 0px;
    out property <length> hovered-tooltip-top-y:
        open-button.hovered ? open-button.absolute-position.y + open-button.height + 6px : undo-button.hovered ? undo-button.absolute-position.y + undo-button.height + 6px : redo-button.hovered ? redo-button.absolute-position.y + redo-button.height + 6px : series-button.hovered ? series-button.absolute-position.y + series-button.height + 6px : minimap-button.hovered ? minimap-button.absolute-position.y + minimap-button.height + 6px : viewport-lock-button.hovered ? viewport-lock-button.absolute-position.y + viewport-lock-button.height + 6px : link-button.hovered ? link-button.absolute-position.y + link-button.height + 6px : align-button.hovered ? align-button.absolute-position.y + align-button.height + 6px : navigate-button.hovered ? navigate-button.absolute-position.y + navigate-button.height + 6px : roi-button.hovered ? roi-button.absolute-position.y + roi-button.height + 6px : measure-button.hovered ? measure-button.absolute-position.y + measure-button.height + 6px : cpu-button.hovered ? cpu-button.absolute-position.y + cpu-button.height + 6px : gpu-button.hovered ? gpu-button.absolute-position.y + gpu-button.height + 6px : metadata-button.hovered ? metadata-button.absolute-position.y + metadata-button.height + 6px : scale-bar-button.hovered ? scale-bar-button.absolute-position.y + scale-bar-button.height + 6px : theme-button.hovered ? theme-button.absolute-position.y + theme-button.height + 6px : dataset-export-button.hovered ? dataset-export-button.absolute-position.y + dataset-export-button.height + 6px : plugins-button.hovered ? plugins-button.absolute-position.y + plugins-button.height + 6px : root.plugin-hovered-tooltip-text != "" ? root.plugin-hovered-tooltip-top-y : !root.use-native-window-controls && minimize-touch.has-hover ? minimize-control.absolute-position.y + minimize_control.height + 6px : !root.use-native-window-controls && maximize-touch.has-hover ? maximize_control.absolute-position.y + maximize_control.height + 6px : !root.use-native-window-controls && close-win-touch.has-hover ? close-control.absolute-position.y + close_control.height + 6px : 0px;

    // The strip along the top of the title bar, above the first row of
    // buttons, moves the window like the rest of its empty space. Without
    // the system's title bar (Windows, Linux) the window resizes from its top
    // 5px unless maximized (`resize-border-width` in app-window.slint), so
    // the strip is 2px taller there to leave a few pixels to grab below that
    // border. With the system's title bar (macOS) it stays the 6px above the
    // buttons, which keeps the first row where the traffic lights are aligned
    // to it (MACOS_TOOLBAR_HEIGHT in callbacks.rs).
    property <length> top-strip: root.use-native-window-controls ? 6px : 8px;
    // Where each row of buttons starts.
    property <length> row-start: 6px;
    property <length> button-height: 28px;
    // The strip, the first row of buttons and the padding under them.
    property <length> first-row-height: root.top-strip + root.button-height + 6px;

    // The title bar grows a row for each row of buttons (vertical-stretch:
    // it never takes more height than they need).
    vertical-stretch: 0;
    background: Theme.toolbar-bg;
    border-width: 0px;

    // Behind everything: pressing where there is no control (the strip along
    // the top, the logo, the gaps between buttons, the rest of a row) and
    // dragging moves the window (callbacks.rs starts the move once the
    // pointer has moved a few pixels); a double click maximizes or restores
    // it.
    drag-touch := TouchArea {
        double-clicked => {
            root.window-maximize();
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border-subtle;
    }

    HorizontalLayout {
        spacing: 0px;

        // The buttons, wrapped onto further rows when they do not fit.
        FlexboxLayout {
            horizontal-stretch: 1;
            flex-wrap: wrap;
            alignment: start;
            cross-axis-line-alignment: start;
            cross-axis-alignment: center;
            padding-left: root.row-start;
            padding-right: 6px;
            padding-top: root.top-strip;
            padding-bottom: 6px;
            spacing-horizontal: 4px;
            spacing-vertical: 4px;

            // Room for the system's window buttons (macOS), on the first row.
            if root.use-native-window-controls: Rectangle {
                width: 74px;
                height: root.button-height;
            }

            action-cluster := HorizontalLayout {
                spacing: 4px;

                open-button := OpenFileToolButton {
                    tooltip-text: @tr("Open file (right-click for folder or recent)");
                    clicked => {
                        root.open-file-requested();
                    }
                    secondary-clicked(x, y) => {
                        root.open-recent-menu-requested(x, y);
                    }
                }

                GuardedSlot {
                    undo-button := SvgToolButton {
                        icon-source: @image-url("icons/undo.svg");
                        tooltip-text: root.undo-tooltip-text;
                        enabled: root.undo-enabled;
                        clicked => {
                            root.undo-requested();
                        }
                    }
                }

                GuardedSlot {
                    redo-button := SvgToolButton {
                        icon-source: @image-url("icons/redo.svg");
                        tooltip-text: root.redo-tooltip-text;
                        enabled: root.redo-enabled;
                        clicked => {
                            root.redo-requested();
                        }
                    }
                }

                series-button := SvgToolButton {
                    icon-source: @image-url("icons/series.svg");
                    tooltip-text: root.show-series-bar ? @tr("Hide Series Bar") : @tr("Show Series Bar");
                    is-active: root.show-series-bar;
                    checkable: true;
                    clicked => {
                        root.toggle-series-bar-requested();
                    }
                }

                minimap-button := MinimapToolButton {
                    tooltip-text: @tr("Toggle minimap");
                    is-active: root.show-minimap;
                    checkable: true;
                    clicked => {
                        root.toggle-minimap-requested();
                    }
                }

                viewport-lock-button := SvgToolButton {
                    icon-source: root.viewport-lock-enabled ? @image-url("icons/viewport-lock-enabled.svg") : @image-url("icons/viewport-lock-disabled.svg");
                    tooltip-text: @tr("Link the views of panes that show the same slide");
                    is-active: root.viewport-lock-enabled;
                    checkable: true;
                    clicked => {
                        root.toggle-viewport-lock-requested();
                    }
                }

                link-button := SvgToolButton {
                    icon-source: @image-url("icons/link-slides.svg");
                    tooltip-text: root.slide-link-enabled ? @tr("Unlink panes") : @tr("Link panes with different slides");
                    is-active: root.slide-link-enabled;
                    checkable: true;
                    clicked => {
                        root.toggle-slide-link-requested();
                    }
                }

                // Moving a pane alone adjusts its alignment (while linked).
                align-button := SvgToolButton {
                    width: root.slide-link-enabled ? 32px : 0px;
                    visible: root.slide-link-enabled;
                    icon-source: @image-url("icons/align-slides.svg");
                    tooltip-text: root.alignment-adjust-enabled
                        ? @tr("Done adjusting (saves the alignment)")
                        : @tr("Adjust alignment: move one pane alone");
                    is-active: root.alignment-adjust-enabled;
                    checkable: true;
                    clicked => {
                        root.toggle-alignment-adjust-requested();
                    }
                }
            }

            tool-group := HorizontalLayout {
                spacing: 4px;

                GroupSeparator {
                    shown: tool-group.x > root.row-start + 1px;
                }

                navigate-button := SvgToolButton {
                    icon-source: @image-url("icons/navigate.svg");
                    property <string> tool-name: @tr("Navigate");
                    tooltip-text: root.shortcuts.navigate == "" ? self.tool-name
                        // A tooltip and the key of its shortcut ("Navigate (N)").
                        : @tr("{} ({})", self.tool-name, Locale.isolate(root.shortcuts.navigate));
                    is-active: root.current-tool == ToolType.navigate;
                    checkable: true;
                    clicked => {
                        root.tool-selected(ToolType.navigate);
                    }
                }

                roi-button := RoiToolButton {
                    property <string> tool-name: @tr("Region of interest");
                    tooltip-text: root.shortcuts.roi == "" ? self.tool-name
                        // A tooltip and the key of its shortcut ("Region of interest (R)").
                        : @tr("{} ({})", self.tool-name, Locale.isolate(root.shortcuts.roi));
                    is-active: root.current-tool == ToolType.region-of-interest;
                    checkable: true;
                    clicked => {
                        root.tool-selected(ToolType.region-of-interest);
                    }
                }

                measure-button := SvgToolButton {
                    icon-source: @image-url("icons/measure.svg");
                    tooltip-text: root.shortcuts.measure != ""
                        ? @tr("Measure: {} ({}; right-click for more)", root.measure-mode-label, Locale.isolate(root.shortcuts.measure))
                        : @tr("Measure: {} (right-click for more)", root.measure-mode-label);
                    is-active: root.current-tool == ToolType.measure;
                    checkable: true;
                    clicked => {
                        root.tool-selected(ToolType.measure);
                    }
                    secondary-clicked(x, y) => {
                        root.measure-mode-menu-requested(x, y);
                    }
                }
            }

            view-group := HorizontalLayout {
                spacing: 4px;

                GroupSeparator {
                    shown: view-group.x > root.row-start + 1px;
                }

                metadata-button := MetadataToolButton {
                    tooltip-text: @tr("Toggle metadata HUD");
                    is-active: root.show-metadata;
                    checkable: true;
                    clicked => {
                        root.toggle-metadata-requested();
                    }
                }

                scale-bar-button := SvgToolButton {
                    icon-source: @image-url("icons/toggle-measure.svg");
                    tooltip-text: @tr("Toggle scale bar");
                    is-active: root.show-scale-bar;
                    checkable: true;
                    clicked => {
                        root.toggle-scale-bar-requested();
                    }
                }

                // Dark, light or high contrast (`theme` in config.toml).
                theme-button := SvgToolButton {
                    icon-source: @image-url("icons/theme.svg");
                    // The current theme ("Theme: Dark"), named as in the theme menu.
                    tooltip-text: @tr("Theme: {}", Theme.kind == ThemeKind.light ? @tr("Theme" => "Light") : Theme.kind == ThemeKind.high-contrast ? @tr("Theme" => "High Contrast") : @tr("Theme" => "Dark"));
                    clicked => {
                        root.theme-menu-requested(self.absolute-position.x, self.absolute-position.y + self.height + 2px);
                    }
                }

                // The interface language: a globe, which people who cannot
                // read the current language still recognise; its tooltip also
                // says "Language" in English.
                language-button := SvgToolButton {
                    icon-source: @image-url("icons/language.svg");
                    tooltip-text: Locale.tag == "en" ? @tr("Language") : @tr("Language") + " (Language)";
                    clicked => {
                        root.language-requested();
                    }
                }

                dataset-export-button := SvgToolButton {
                    icon-source: @image-url("icons/dataset.svg");
                    tooltip-text: @tr("Export Dataset");
                    clicked => {
                        root.dataset-export-requested();
                    }
                }
            }

            render-group := HorizontalLayout {
                spacing: 4px;

                GroupSeparator {
                    shown: render-group.x > root.row-start + 1px;
                }

                cpu-button := ToolButton {
                    width: 40px;
                    icon: @tr("CPU");
                    tooltip-text: @tr("Use CPU renderer");
                    is-active: root.render-mode == RenderMode.cpu;
                    checkable: true;
                    clicked => {
                        root.render-backend-selected(RenderMode.cpu);
                    }
                }

                GuardedSlot {
                    width: 40px;

                    gpu-button := ToolButton {
                        width: 40px;
                        icon: @tr("GPU");
                        tooltip-text: root.gpu-rendering-available ? @tr("Use GPU renderer") : @tr("GPU renderer unavailable");
                        enabled: root.gpu-rendering-available;
                        is-active: root.render-mode == RenderMode.gpu;
                        checkable: true;
                        clicked => {
                            if root.gpu-rendering-available {
                                root.render-backend-selected(RenderMode.gpu);
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    filter-combo-area := Rectangle {
                        width: 82px;
                        height: 26px;
                        border-radius: 3px;
                        background: filter-combo-touch.has-hover ? Theme.surface-hover : Theme.surface;
                        border-width: 1px;
                        border-color: root.filter-popup-visible ? Theme.accent : Theme.border;
                        accessible-role: combobox;
                        accessible-label: @tr("Filtering mode");
                        accessible-value: filter-mode-text.text;
                        accessible-expandable: true;
                        accessible-expanded: root.filter-popup-visible;
                        accessible-action-default => {
                            root.filter-popup-visible = !root.filter-popup-visible;
                        }
                        accessible-action-expand => {
                            root.filter-popup-visible = true;
                        }

                        filter-combo-touch := TouchArea {
                            clicked => {
                                root.filter-popup-visible = !root.filter-popup-visible;
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 6px;
                            spacing: 4px;

                            filter-mode-text := Text {
                                text: root.filtering-mode == FilteringMode.bilinear ? @tr("Bilinear") : root.filtering-mode == FilteringMode.trilinear ? @tr("Trilinear") : @tr("Lanczos-3");
                                color: Theme.text-primary;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                                accessible-role: none;
                            }

                            Text {
                                text: "▾";
                                color: Theme.text-secondary;
                                font-size: 10px;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }
                    }
                }
            }

            // Each plugin's buttons start with a separator; a row breaks
            // between any two of them.
            for btn[idx] in root.plugin-buttons: plugin-item := HorizontalLayout {
                spacing: 4px;

                if btn.show-left-separator: GroupSeparator {
                    shown: plugin-item.x > root.row-start + 1px;
                }

                GuardedSlot {
                    SvgToolButton {
                        width: 32px;
                        icon-source: btn.icon;
                        tooltip-text: btn.tooltip;
                        is-active: btn.active;
                        checkable: btn.is-tool || btn.active;
                        enabled: btn.enabled;
                        changed hovered => {
                            if self.hovered {
                                root.plugin-hovered-tooltip-text = btn.tooltip;
                                root.plugin-hovered-tooltip-center-x = self.absolute-position.x + self.width / 2;
                                root.plugin-hovered-tooltip-top-y = self.absolute-position.y + self.height + 6px;
                            } else if root.plugin-hovered-tooltip-text == btn.tooltip {
                                root.plugin-hovered-tooltip-text = "";
                                root.plugin-hovered-tooltip-center-x = 0px;
                                root.plugin-hovered-tooltip-top-y = 0px;
                            }
                        }
                        clicked => {
                            root.plugin-button-clicked(btn.plugin-id, btn.button-id, btn.is-tool);
                        }
                    }
                }
            }

            plugins-group := HorizontalLayout {
                spacing: 4px;

                GroupSeparator {
                    shown: plugins-group.x > root.row-start + 1px;
                }

                plugins-button := SvgToolButton {
                    icon-source: @image-url("icons/plugin.svg");
                    tooltip-text: root.plugin-problems ? @tr("Plugins (some could not be started)") : @tr("Plugins ({})", root.plugin-count);
                    is-active: root.plugin-problems;
                    clicked => {
                        root.plugins-panel-requested();
                    }
                }
            }
        }

        // The logo and the window's own buttons stay on the first row at the
        // right, however narrow the window. The system draws the window's
        // buttons on macOS (top left), so there these take no room.
        VerticalLayout {
            alignment: start;

            HorizontalLayout {
                height: root.first-row-height;

                logo := Rectangle {
                    width: 64px;

                    Image {
                        source: @image-url("icons/logo.png");
                        x: (parent.width - self.width) / 2;
                        y: root.top-strip + (root.button-height - self.height) / 2;
                        height: 20px;
                        image-fit: contain;
                        accessible-role: none;
                    }
                }

                minimize-control := Rectangle {
                    width: root.use-native-window-controls ? 0px : 46px;
                    visible: !root.use-native-window-controls;
                    background: minimize-touch.has-hover ? Theme.surface-hover : transparent;
                    border-radius: 0px;
                    accessible-role: button;
                    accessible-label: @tr("Minimize window");
                    accessible-action-default => {
                        root.window-minimize();
                    }

                    minimize-touch := TouchArea {
                        clicked => {
                            root.window-minimize();
                        }
                    }

                    // The glyphs sit on the line of the toolbar's icons.
                    Text {
                        y: root.top-strip;
                        height: root.button-height;
                        text: "─";
                        color: Theme.text-primary;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }

                maximize-control := Rectangle {
                    width: root.use-native-window-controls ? 0px : 46px;
                    visible: !root.use-native-window-controls;
                    background: maximize-touch.has-hover ? Theme.surface-hover : transparent;
                    border-radius: 0px;
                    accessible-role: button;
                    accessible-label: @tr("Maximize window");
                    accessible-action-default => {
                        root.window-maximize();
                    }

                    maximize-touch := TouchArea {
                        clicked => {
                            root.window-maximize();
                        }
                    }

                    Text {
                        y: root.top-strip;
                        height: root.button-height;
                        text: "☐";
                        color: Theme.text-primary;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }

                close-control := Rectangle {
                    width: root.use-native-window-controls ? 0px : 46px;
                    visible: !root.use-native-window-controls;
                    background: close-win-touch.has-hover ? Theme.close-hover : transparent;
                    border-radius: 0px;
                    accessible-role: button;
                    accessible-label: @tr("Close window");
                    accessible-action-default => {
                        root.window-close();
                    }

                    close-win-touch := TouchArea {
                        clicked => {
                            root.window-close();
                        }
                    }

                    Path {
                        width: 10px;
                        height: 10px;
                        x: (parent.width - self.width) / 2;
                        y: root.top-strip + (root.button-height - self.height) / 2;
                        stroke: close-win-touch.has-hover ? Theme.text-on-danger : Theme.text-primary;
                        stroke-width: 1.2px;
                        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
                    }
                }
            }
        }
    }
}
