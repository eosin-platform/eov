// Naming a bookmark of the focused view (Ctrl+B).

import { Theme } from "theme.slint";
import { DialogKeys } from "dialog-keys.slint";

export component BookmarkDialog inherits Rectangle {
    in-out property <string> name;
    /// Where the view is ("20× at 1200, 3400 of slide.svs").
    in property <string> detail;
    callback accepted(string);
    callback cancelled();

    background: Theme.scrim;

    TouchArea {
        clicked => {
            root.cancelled();
        }
    }

    DialogKeys {
        title: @tr("Add Bookmark");
        forward-focus: name-input;
        has-default-action: true;
        cancel => {
            root.cancelled();
        }
        default-action => {
            root.accepted(root.name);
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(440px, root.width - 32px);
            height: layout.preferred-height;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            TouchArea { }

            layout := VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: @tr("Add Bookmark");
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-weight: 600;
                }

                Text {
                    text: root.detail;
                    color: Theme.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                    height: self.preferred-height;
                }

                Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    border-width: name-input.has-focus ? Theme.focus-width : 1px;
                    border-color: name-input.has-focus ? Theme.accent : Theme.border;
                    background: Theme.input-bg;

                    name-input := TextInput {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text <=> root.name;
                        color: Theme.text-primary;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                        accessible-label: @tr("Bookmark name");
                        accepted => {
                            root.accepted(self.text);
                        }
                        init => {
                            self.focus();
                            self.select-all();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Rectangle {
                        min-width: cancel-text.preferred-width + 16px;
                        height: 28px;
                        border-radius: 4px;
                        background: cancel-touch.has-hover ? Theme.surface-hover : Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        accessible-role: button;
                        accessible-label: @tr("Cancel");
                        accessible-action-default => {
                            root.cancelled();
                        }

                        cancel-touch := TouchArea {
                            clicked => {
                                root.cancelled();
                            }
                        }

                        cancel-text := Text {
                            text: @tr("Cancel");
                            accessible-role: none;
                            color: Theme.text-primary;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        min-width: add-text.preferred-width + 16px;
                        height: 28px;
                        border-radius: 4px;
                        background: add-touch.has-hover ? Theme.accent-hover : Theme.accent;
                        accessible-role: button;
                        accessible-label: @tr("Add");
                        accessible-action-default => {
                            root.accepted(root.name);
                        }

                        add-touch := TouchArea {
                            clicked => {
                                root.accepted(root.name);
                            }
                        }

                        add-text := Text {
                            text: @tr("Add");
                            accessible-role: none;
                            color: Theme.text-on-accent;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
