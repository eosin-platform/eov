// The on-screen scale bar. The length and label are computed in Rust
// (`eov_common::overlay::scale_bar_for_view`): the nicest 1-2-5 length in
// the shown unit, measured with the horizontal pixel size, labelled with
// its exact value (UI-6).
export component ScaleBar inherits Rectangle {
    // Bar length in logical pixels; 0 hides the bar (uncalibrated slide).
    in property <float> bar-width-px: 0.0;
    in property <string> label-text;

    width: max(60px, bar-width-px * 1px + 24px);
    height: 32px;
    background: transparent;
    visible: bar-width-px > 5.0;

    Rectangle {
        x: (parent.width - bar-width-px * 1px) / 2 - 1px;
        y: parent.height - 12px - 1px;
        width: bar-width-px * 1px + 2px;
        height: 3px + 2px;
        background: black;
        border-radius: 2px;
    }

    Rectangle {
        x: (parent.width - bar-width-px * 1px) / 2;
        y: parent.height - 12px;
        width: bar-width-px * 1px;
        height: 3px;
        background: white;
        border-radius: 1px;

        // Left tick outline
        Rectangle {
            x: -1px;
            y: -4px - 1px;
            width: 2px + 2px;
            height: 10px + 2px;
            background: black;
        }

        // Left tick
        Rectangle {
            x: 0px;
            y: -4px;
            width: 2px;
            height: 10px;
            background: white;
        }

        // Right tick outline
        Rectangle {
            x: parent.width - 2px - 1px;
            y: -4px - 1px;
            width: 2px + 2px;
            height: 10px + 2px;
            background: black;
        }

        // Right tick
        Rectangle {
            x: parent.width - 2px;
            y: -4px;
            width: 2px;
            height: 10px;
            background: white;
        }
    }

    // Text stroke (black outline via offset copies)
    Text {
        x: -1px;
        y: -1px;
        width: 100%;
        text: root.label-text;
        color: black;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
    }

    Text {
        x: 0px;
        y: -1px;
        width: 100%;
        text: root.label-text;
        color: black;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
    }

    Text {
        x: 1px;
        y: -1px;
        width: 100%;
        text: root.label-text;
        color: black;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
    }

    Text {
        x: -1px;
        y: 0px;
        width: 100%;
        text: root.label-text;
        color: black;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
    }

    Text {
        x: 1px;
        y: 0px;
        width: 100%;
        text: root.label-text;
        color: black;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
    }

    Text {
        x: -1px;
        y: 1px;
        width: 100%;
        text: root.label-text;
        color: black;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
    }

    Text {
        x: 0px;
        y: 1px;
        width: 100%;
        text: root.label-text;
        color: black;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
    }

    Text {
        x: 1px;
        y: 1px;
        width: 100%;
        text: root.label-text;
        color: black;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
    }

    Text {
        x: 0px;
        y: 0px;
        width: 100%;
        text: root.label-text;
        color: white;
        font-size: 10px;
        font-weight: 600;
        horizontal-alignment: center;
    }
}
