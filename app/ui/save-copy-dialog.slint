// EOV WSI Viewer - Save a Copy of the Slide dialog (AUDIT §14.3, §14.6)

import { Locale } from "locale.slint";
import { Theme } from "theme.slint";
import { DialogKeys } from "dialog-keys.slint";
import { ScrollArea } from "scroll-area.slint";

export struct SaveCopySettings {
    // The slide's name, for the title.
    title: string,
    // 0 = the whole slide, 1 = the region of interest.
    area: int,
    has-roi: bool,
    // "23903 × 21015 px", "3000 × 2000 px at 8000, 6000".
    whole-text: string,
    roi-text: string,
    // 0 = pyramidal TIFF, 1 = OME-TIFF.
    format: int,
    // 0 = JPEG quality 90, 1 = JPEG quality 80, 2 = lossless (Deflate).
    compression: int,
    deidentify: bool,
    // What will be written ("7 levels, about 120 MB"), or empty.
    summary: string,
    // Why the copy cannot be made, shown in the dialog.
    error: string,
}

// One choice of a group. Its texts start where the language starts a line
// (the button stays at the left), and the detail wraps: the OME-TIFF one
// ends with what OpenSlide cannot see.
component Choice inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback clicked();

    // As tall as before, taller when the detail takes more lines (and
    // never shorter than its texts).
    min-height: max(root.detail == "" ? 24px : 38px, content.min-height);
    vertical-stretch: 0;
    opacity: root.enabled ? 1.0 : 0.45;
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-description: root.detail;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    content := HorizontalLayout {
        spacing: 8px;

        Rectangle {
            width: 16px;
            height: 16px;
            y: 4px;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.checked ? Theme.accent : Theme.text-secondary;
            background: transparent;

            if root.checked: Rectangle {
                x: 4px;
                y: 4px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.accent;
            }
        }

        VerticalLayout {
            spacing: 2px;
            alignment: start;

            Text {
                text: root.text;
                color: Theme.text-primary;
                font-size: 12px;
                horizontal-alignment: Locale.start;
                accessible-role: none;
            }

            // Wrapped text in `if` needs its height set.
            if root.detail != "": detail := Text {
                text: root.detail;
                color: Theme.text-secondary;
                font-size: Locale.text-size(11px);
                wrap: word-wrap;
                horizontal-alignment: Locale.start;
                height: self.preferred-height;
                accessible-role: none;
            }
        }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

component Heading inherits Text {
    color: Theme.text-primary;
    font-size: 12px;
    font-weight: 600;
    horizontal-alignment: Locale.start;
}

// A checkbox with its label, which wraps and starts where the language
// starts a line (the box stays at the left). A click anywhere on the row
// toggles it.
component CheckRow inherits Rectangle {
    in property <string> text;
    in property <bool> checked: false;
    callback toggled();

    // As tall as before, taller when the label wraps.
    min-height: max(22px, row.min-height);
    vertical-stretch: 0;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.toggled();
    }

    row := HorizontalLayout {
        // A line of the label is as tall as the row was, and the first one
        // stays level with the box.
        padding-top: 2.5px;
        padding-bottom: 2.5px;
        spacing: 8px;

        Rectangle {
            width: 16px;
            height: 16px;
            y: 3px;
            border-radius: 3px;
            border-width: 1px;
            border-color: root.checked ? Theme.accent : Theme.border;
            background: root.checked ? Theme.accent : transparent;

            if root.checked: Text {
                text: "✓";
                color: Theme.text-on-accent;
                font-size: Locale.text-size(11px);
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
        }

        label := Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text-primary;
            font-size: 12px;
            wrap: word-wrap;
            horizontal-alignment: Locale.start;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

component DialogButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    callback clicked();

    width: label.preferred-width + 28px;
    height: 30px;
    border-radius: 4px;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border;
    background: root.primary
        ? (touch.has-hover ? Theme.accent-hover : Theme.accent)
        : (touch.has-hover ? Theme.surface-hover : Theme.surface);
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    label := Text {
        text: root.text;
        color: root.primary ? Theme.text-on-accent : Theme.text-primary;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component SaveCopyDialog inherits Rectangle {
    in-out property <SaveCopySettings> settings;
    callback save-requested();
    callback cancel-requested();
    callback settings-changed(SaveCopySettings);

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.scrim;

    TouchArea {
        clicked => {
            root.cancel-requested();
        }
    }

    // Escape cancels, Enter saves.
    DialogKeys {
        title: @tr("Save a Copy of the Slide");
        has-default-action: true;
        cancel => {
            root.cancel-requested();
        }
        default-action => {
            root.save-requested();
        }

        card := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 40px, 480px);
            height: min(parent.height - 40px, layout.preferred-height);
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            TouchArea { }

            layout := VerticalLayout {
                padding: 20px;
                spacing: 10px;

                Text {
                    text: @tr("Save a Copy of the Slide");
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: Locale.start;
                }

                Text {
                    text: root.settings.title;
                    color: Theme.text-secondary;
                    font-size: Locale.text-size(11px);
                    horizontal-alignment: Locale.start;
                    overflow: elide;
                }

                // The choices scroll when the window is too short to show
                // them all; what will be written (or why it cannot be) and
                // the buttons stay in view below them.
                choices := ScrollArea {
                    VerticalLayout {
                        spacing: 10px;

                        Heading {
                            // Translators: heading of the choice of what to copy (the whole slide or the region of interest), not a measured area.
                            text: @tr("Area");
                        }

                        Choice {
                            text: @tr("Whole slide");
                            detail: root.settings.whole-text;
                            checked: root.settings.area == 0;
                            clicked => {
                                root.settings.area = 0;
                                root.settings-changed(root.settings);
                            }
                        }

                        Choice {
                            text: @tr("Region of interest");
                            detail: root.settings.has-roi ? root.settings.roi-text : @tr("Draw one with the region tool first");
                            checked: root.settings.area == 1;
                            enabled: root.settings.has-roi;
                            clicked => {
                                root.settings.area = 1;
                                root.settings-changed(root.settings);
                            }
                        }

                        Heading {
                            text: @tr("Format");
                        }

                        Choice {
                            text: @tr("Pyramidal TIFF");
                            detail: @tr("Opens in eov, QuPath, OpenSlide and most WSI tools");
                            checked: root.settings.format == 0;
                            clicked => {
                                root.settings.format = 0;
                                root.settings-changed(root.settings);
                            }
                        }

                        Choice {
                            text: @tr("OME-TIFF");
                            detail: @tr("For eov, QuPath, Bio-Formats and OMERO (OpenSlide sees its full resolution only)");
                            checked: root.settings.format == 1;
                            clicked => {
                                root.settings.format = 1;
                                root.settings-changed(root.settings);
                            }
                        }

                        Heading {
                            text: @tr("Compression");
                        }

                        Choice {
                            text: @tr("JPEG, high quality (90)");
                            checked: root.settings.compression == 0;
                            clicked => {
                                root.settings.compression = 0;
                                root.settings-changed(root.settings);
                            }
                        }

                        Choice {
                            text: @tr("JPEG, smaller files (80)");
                            checked: root.settings.compression == 1;
                            clicked => {
                                root.settings.compression = 1;
                                root.settings-changed(root.settings);
                            }
                        }

                        Choice {
                            text: @tr("Lossless (Deflate)");
                            detail: @tr("Exact pixels; several times larger");
                            checked: root.settings.compression == 2;
                            clicked => {
                                root.settings.compression = 2;
                                root.settings-changed(root.settings);
                            }
                        }

                        // De-identification.
                        CheckRow {
                            text: @tr("De-identify");
                            checked: root.settings.deidentify;
                            toggled => {
                                root.settings.deidentify = !root.settings.deidentify;
                                root.settings-changed(root.settings);
                            }
                        }

                        Text {
                            text: root.settings.deidentify
                                ? @tr("No label, macro or thumbnail image, and no properties but the pixel size, objective power and stain. Text or marks inside the scanned tissue image are not removed.")
                                : @tr("The copy keeps the label and macro images and every property of the slide; any of these can identify the patient.");
                            color: Theme.text-secondary;
                            font-size: Locale.text-size(11px);
                            wrap: word-wrap;
                            horizontal-alignment: Locale.start;
                        }
                    }
                }

                if root.settings.summary != "": Text {
                    text: root.settings.summary;
                    color: Theme.text-secondary;
                    font-size: Locale.text-size(11px);
                    wrap: word-wrap;
                    horizontal-alignment: Locale.start;
                }

                if root.settings.error != "": Text {
                    text: root.settings.error;
                    color: Theme.error;
                    font-size: Locale.text-size(11px);
                    wrap: word-wrap;
                    horizontal-alignment: Locale.start;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    DialogButton {
                        text: @tr("Cancel");
                        clicked => {
                            root.cancel-requested();
                        }
                    }

                    DialogButton {
                        text: @tr("Save…");
                        primary: true;
                        clicked => {
                            root.save-requested();
                        }
                    }
                }
            }
        }
    }
}
