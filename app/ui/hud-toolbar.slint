import { Theme } from "theme.slint";
import { ContextMenuItem, HudToolbarButtonData } from "types.slint";
import { DialogKeys } from "dialog-keys.slint";

component HudButton inherits Rectangle {
    in property <image> icon-source;
    in property <string> text: "";
    in property <string> tooltip-text;
    in property <bool> active: false;
    /// A toggle: assistive technology is told whether it is on (`active`).
    in property <bool> checkable: false;
    /// The button opens a menu or panel (`expanded` while it is open).
    in property <bool> expandable: false;
    in property <bool> expanded: false;
    out property <bool> hovered: touch.has-hover;
    callback clicked();

    width: 38px;
    height: 38px;
    border-radius: 0px;
    background: touch.has-hover ? Theme.hover-fill-strong : active ? Theme.hover-fill : transparent;
    accessible-role: button;
    accessible-label: root.tooltip-text != "" ? root.tooltip-text : root.text;
    accessible-checkable: root.checkable;
    accessible-checked: root.active;
    accessible-expandable: root.expandable;
    accessible-expanded: root.expanded;
    accessible-action-default => {
        root.clicked();
    }
    accessible-action-expand => {
        if root.expandable && !root.expanded {
            root.clicked();
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    if root.text == "": Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.icon-source;
        image-fit: contain;
        colorize: root.active ? Theme.text-strong : Theme.text-primary;
        accessible-role: none;
    }

    if root.text != "": Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.active ? Theme.text-strong : Theme.text-primary;
        font-size: 18px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

component HudSeparator inherits Rectangle {
    width: 1px;
    height: 38px;
    background: Theme.track;
}

export component HudToolbar inherits Rectangle {
    in property <int> pane-id: 0;
    in property <float> zoom-level: 1.0;
    in property <string> zoom-display-text: "100%";
    in property <string> zoom-input-text: "100";
    in property <string> zoom-tooltip: @tr("100% = 1 image pixel per display pixel");
    in property <bool> dropdown-open: false;
    in property <bool> has-adjustments: false;
    in property <[HudToolbarButtonData]> plugin-buttons: [];
    // The view's turn (see `ViewportInfo`): any angle, and as shown.
    in property <float> rotation-degrees: 0;
    in property <string> rotation-text: "0";
    in property <string> rotation-input-text: "0";
    in property <bool> flipped: false;
    // Colour management (see `HudSettings.color-management`).
    in property <int> color-management: 0;
    in property <string> color-management-tooltip: "";

    callback fit-to-view();
    callback zoom-in();
    callback zoom-out();
    callback toggle-dropdown();
    callback zoom-input(string);
    callback plugin-button-clicked(/* plugin */ string, /* button */ string, /* menu item */ string);
    callback dismiss-plugin-menu();
    // 0 rotate left, 1 rotate right, 2 flip, 3 reset the rotation.
    callback orientation-changed(int);
    // An angle typed into the angle field (degrees clockwise).
    callback rotation-input(string);
    callback color-management-toggled();
    /// The zoom field or the plugin menu, which had the keyboard, is done
    /// with it.
    callback release-keyboard();

    property <bool> editing-zoom: false;
    property <bool> cancel-zoom-edit: false;
    property <bool> editing-angle: false;
    property <bool> cancel-angle-edit: false;
    in-out property <bool> plugin-menu-open: false;
    property <string> plugin-menu-plugin-id: "";
    property <string> plugin-menu-button-id: "";
    property <int> plugin-menu-index: -1;
    property <length> plugin-menu-x: 0px;
    property <length> plugin-menu-y: root.height + 6px;

    /// The plugin button under the pointer (-1: none) and its centre.
    property <int> hovered-plugin: -1;
    property <length> hovered-plugin-x: 0px;
    property <string> active-tooltip:
        zoom-touch.has-hover ? root.zoom-tooltip
        : zoom-out-btn.hovered ? zoom-out-btn.tooltip-text
        : zoom-in-btn.hovered ? zoom-in-btn.tooltip-text
        : rotate-left-btn.hovered ? rotate-left-btn.tooltip-text
        : rotate-right-btn.hovered ? rotate-right-btn.tooltip-text
        : flip-btn.hovered ? flip-btn.tooltip-text
        : angle-touch.has-hover ? @tr("Rotation: click to type an angle")
        : icc-touch.has-hover ? root.color-management-tooltip
        : adjust-btn.hovered ? adjust-btn.tooltip-text
        : root.hovered-plugin >= 0 && root.hovered-plugin < root.plugin-buttons.length && !root.plugin-menu-open
            ? root.plugin-buttons[root.hovered-plugin].tooltip
        : "";
    property <length> tooltip-center-x:
        zoom-touch.has-hover ? zoom-touch.absolute-position.x - root.absolute-position.x + zoom-touch.width / 2
        : zoom-out-btn.hovered ? zoom-out-btn.absolute-position.x - root.absolute-position.x + zoom-out-btn.width / 2
        : zoom-in-btn.hovered ? zoom-in-btn.absolute-position.x - root.absolute-position.x + zoom-in-btn.width / 2
        : rotate-left-btn.hovered ? rotate-left-btn.absolute-position.x - root.absolute-position.x + rotate-left-btn.width / 2
        : rotate-right-btn.hovered ? rotate-right-btn.absolute-position.x - root.absolute-position.x + rotate-right-btn.width / 2
        : flip-btn.hovered ? flip-btn.absolute-position.x - root.absolute-position.x + flip-btn.width / 2
        : angle-touch.has-hover ? angle-label.absolute-position.x - root.absolute-position.x + angle-label.width / 2
        : icc-touch.has-hover ? icc-chip.absolute-position.x - root.absolute-position.x + icc-chip.width / 2
        : adjust-btn.hovered ? adjust-btn.absolute-position.x - root.absolute-position.x + adjust-btn.width / 2
        : root.hovered-plugin-x;

    width: bar.preferred-width;
    height: 38px;
    background: transparent;

    dismiss-plugin-menu => {
        root.plugin-menu-open = false;
    }

    changed plugin-menu-open => {
        if !self.plugin-menu-open {
            root.release-keyboard();
        }
    }

    function start-zoom-edit() {
        root.cancel-zoom-edit = false;
        zoom-text-input.text = root.zoom-input-text;
        root.editing-zoom = true;
        zoom-text-input.focus();
        zoom-text-input.select-all();
    }

    // Clipped bar container for rounded corners
    bar := Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.hud-bg;
        border-radius: 8px;
        border-width: Theme.high-contrast ? 1px : 0px;
        border-color: Theme.outline;
        clip: true;

        HorizontalLayout {
            padding: 0px;
            spacing: 0px;

            zoom-out-btn := HudButton {
                width: 30px;
                text: "−";
                tooltip-text: @tr("Zoom out");
                clicked => {
                    root.zoom-out();
                }
            }

            // Zoom label / text input
            Rectangle {
                width: 72px;
                height: 38px;
                border-radius: 0px;
                background: zoom-touch.has-hover || root.editing-zoom ? Theme.hover-fill : transparent;
                accessible-role: spinbox;
                accessible-label: @tr("Zoom");
                accessible-description: root.zoom-tooltip;
                accessible-value: root.zoom-display-text;
                accessible-action-increment => {
                    root.zoom-in();
                }
                accessible-action-decrement => {
                    root.zoom-out();
                }
                accessible-action-default => {
                    root.start-zoom-edit();
                }

                Text {
                    visible: !root.editing-zoom;
                    text: root.zoom-display-text;
                    color: Theme.text-value;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }

                Rectangle {
                    visible: root.editing-zoom;
                    x: 4px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - 8px;
                    height: 26px;
                    background: root.editing-zoom ? Theme.input-bg : transparent;
                    border-radius: 4px;
                    border-width: root.editing-zoom ? Theme.focus-width : 0px;
                    border-color: Theme.accent-bright;

                    zoom-text-input := TextInput {
                        x: 4px;
                        width: parent.width - 8px;
                        color: Theme.text-strong;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        text: root.zoom-input-text;
                        accessible-label: @tr("Zoom");

                        accepted => {
                            root.cancel-zoom-edit = false;
                            root.editing-zoom = false;
                            root.zoom-input(self.text);
                            root.release-keyboard();
                        }

                        changed has-focus => {
                            if !self.has-focus && root.editing-zoom {
                                if root.cancel-zoom-edit {
                                    root.cancel-zoom-edit = false;
                                    root.editing-zoom = false;
                                    self.text = root.zoom-input-text;
                                } else {
                                    root.editing-zoom = false;
                                    root.zoom-input(self.text);
                                }
                            }
                        }

                        key-pressed(e) => {
                            if e.text == Key.Escape {
                                root.cancel-zoom-edit = true;
                                root.editing-zoom = false;
                                self.text = root.zoom-input-text;
                                root.release-keyboard();
                                return accept;
                            }
                            reject
                        }
                    }
                }

                zoom-touch := TouchArea {
                    enabled: !root.editing-zoom;
                    clicked => {
                        root.start-zoom-edit();
                    }
                }
            }

            zoom-in-btn := HudButton {
                width: 30px;
                text: "+";
                tooltip-text: @tr("Zoom in");
                clicked => {
                    root.zoom-in();
                }
            }

            HudSeparator {}

            rotate-left-btn := HudButton {
                icon-source: @image-url("icons/rotate-left.svg");
                tooltip-text: @tr("Rotate left 90°");
                clicked => {
                    root.orientation-changed(0);
                }
            }

            rotate-right-btn := HudButton {
                icon-source: @image-url("icons/rotate-right.svg");
                tooltip-text: @tr("Rotate right 90°");
                clicked => {
                    root.orientation-changed(1);
                }
            }

            flip-btn := HudButton {
                icon-source: @image-url("icons/flip-horizontal.svg");
                tooltip-text: root.flipped ? @tr("Unflip") : @tr("Flip horizontally");
                active: root.flipped;
                checkable: true;
                clicked => {
                    root.orientation-changed(2);
                }
            }

            // The view's angle; clicking it types an exact one.
            angle-label := Rectangle {
                width: 56px;
                height: 38px;
                background: angle-touch.has-hover || root.editing-angle ? Theme.hover-fill-strong : transparent;
                accessible-role: button;
                accessible-label: @tr("Rotation");
                accessible-description: root.rotation-text + "°";
                accessible-action-default => {
                    root.cancel-angle-edit = false;
                    angle-text-input.text = root.rotation-input-text;
                    root.editing-angle = true;
                    angle-text-input.focus();
                    angle-text-input.select-all();
                }

                Text {
                    visible: !root.editing-angle;
                    text: root.rotation-text + "°";
                    color: root.rotation-degrees != 0 ? Theme.text-value : Theme.text-secondary;
                    font-size: 13px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }

                Rectangle {
                    visible: root.editing-angle;
                    x: 4px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - 8px;
                    height: 26px;
                    background: Theme.input-bg;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.accent-bright;

                    angle-text-input := TextInput {
                        accessible-label: @tr("Rotation in degrees");
                        x: 4px;
                        width: parent.width - 8px;
                        color: Theme.text-strong;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        text: root.rotation-input-text;

                        accepted => {
                            root.cancel-angle-edit = false;
                            root.editing-angle = false;
                            root.rotation-input(self.text);
                        }

                        changed has-focus => {
                            if !self.has-focus && root.editing-angle {
                                if root.cancel-angle-edit {
                                    root.cancel-angle-edit = false;
                                    root.editing-angle = false;
                                    self.text = root.rotation-input-text;
                                } else {
                                    root.editing-angle = false;
                                    root.rotation-input(self.text);
                                }
                            }
                        }

                        key-pressed(e) => {
                            if e.text == Key.Escape {
                                root.cancel-angle-edit = true;
                                root.editing-angle = false;
                                self.text = root.rotation-input-text;
                                // The angle as it was (the keyboard goes
                                // back to the shortcuts).
                                root.rotation-input(root.rotation-input-text);
                                return accept;
                            }
                            reject
                        }
                    }
                }

                angle-touch := TouchArea {
                    enabled: !root.editing-angle;
                    clicked => {
                        root.cancel-angle-edit = false;
                        angle-text-input.text = root.rotation-input-text;
                        root.editing-angle = true;
                        angle-text-input.focus();
                        angle-text-input.select-all();
                    }
                }
            }

            // Colour management: lit while the slide's ICC profile is
            // converted to sRGB; clicking turns it on or off.
            icc-chip := Rectangle {
                width: root.color-management != 0 ? 42px : 0px;
                height: 38px;
                visible: root.color-management != 0;
                background: icc-touch.has-hover ? Theme.hover-fill-strong : root.color-management == 1 ? Theme.hover-fill : transparent;
                accessible-role: button;
                accessible-label: @tr("Colour management");
                accessible-description: root.color-management-tooltip;
                accessible-checkable: root.color-management == 1 || root.color-management == 2;
                accessible-checked: root.color-management == 1;
                accessible-enabled: root.color-management == 1 || root.color-management == 2;
                accessible-action-default => {
                    if root.color-management == 1 || root.color-management == 2 {
                        root.color-management-toggled();
                    }
                }

                Text {
                    text: @tr("ICC");
                    color: root.color-management == 1 ? Theme.text-strong
                        : root.color-management == 4 ? Theme.notice
                        : Theme.text-secondary;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }

                // A line through the text while colours are as scanned.
                if root.color-management == 2: Rectangle {
                    x: 10px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - 20px;
                    height: 1.5px;
                    background: Theme.text-secondary;
                }

                icc-touch := TouchArea {
                    enabled: root.color-management == 1 || root.color-management == 2;
                    clicked => {
                        root.color-management-toggled();
                    }
                }
            }

            for btn[idx] in root.plugin-buttons: HorizontalLayout {
                spacing: 0px;

                if idx == 0 || root.plugin-buttons[idx - 1].plugin-id != btn.plugin-id: HudSeparator {}

                HudButton {
                    icon-source: btn.icon;
                    tooltip-text: btn.tooltip;
                    active: btn.active || (root.plugin-menu-open && root.plugin-menu-index == idx);
                    checkable: btn.menu.length == 0 && btn.active;
                    expandable: btn.menu.length > 0;
                    expanded: root.plugin-menu-open && root.plugin-menu-index == idx;
                    changed hovered => {
                        if self.hovered {
                            root.hovered-plugin = idx;
                            root.hovered-plugin-x = self.absolute-position.x - root.absolute-position.x + self.width / 2;
                        } else if root.hovered-plugin == idx {
                            root.hovered-plugin = -1;
                        }
                    }
                    clicked => {
                        if btn.menu.length > 0 {
                            if root.plugin-menu-open && root.plugin-menu-index == idx {
                                root.plugin-menu-open = false;
                            } else {
                                root.plugin-menu-plugin-id = btn.plugin-id;
                                root.plugin-menu-button-id = btn.button-id;
                                root.plugin-menu-index = idx;
                                root.plugin-menu-x = self.absolute-position.x - root.absolute-position.x;
                                root.plugin-menu-open = true;
                            }
                        } else {
                            root.plugin-menu-open = false;
                            root.plugin-button-clicked(btn.plugin-id, btn.button-id, "");
                        }
                    }
                }
            }

            if root.plugin-buttons.length > 0: HudSeparator {}

            adjust-btn := HudButton {
                icon-source: @image-url("icons/settings.svg");
                tooltip-text: @tr("Adjustments");
                active: root.dropdown-open || root.has-adjustments;
                expandable: true;
                expanded: root.dropdown-open;
                accessible-description: root.has-adjustments ? @tr("The colours are adjusted") : "";
                clicked => {
                    root.toggle-dropdown();
                }
            }
        }
    }

    // Tooltip rendered outside the clipped bar
    if active-tooltip != "": Rectangle {
        x: root.tooltip-center-x - self.width / 2;
        y: root.height + 6px;
        width: hud-tt-text.preferred-width + 12px;
        height: hud-tt-text.preferred-height + 6px;
        background: Theme.tooltip-bg;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.tooltip-border;

        hud-tt-text := Text {
            x: 6px;
            y: 3px;
            text: root.active-tooltip;
            color: Theme.tooltip-text;
            font-size: 11px;
        }
    }

    if root.plugin-menu-open && root.plugin-menu-index >= 0 && root.plugin-menu-index < root.plugin-buttons.length: Rectangle {
        property <[ContextMenuItem]> items: root.plugin-buttons[root.plugin-menu-index].menu;
        x: root.plugin-menu-x;
        y: root.plugin-menu-y;
        width: 180px;
        height: self.items.length * 30px + max(0, self.items.length - 1) * 2px + 12px;
        background: Theme.hud-panel-bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.outline;
        clip: true;

        // The menu takes the keyboard: Escape closes it.
        DialogKeys {
            title: @tr("Menu");
            takes-back: false;
            cancel => {
                root.plugin-menu-open = false;
            }
        }

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding: 6px;
            spacing: 2px;

            for item in parent.items: Rectangle {
                height: 30px;
                border-radius: 4px;
                background: item-touch.has-hover && item.enabled ? Theme.hover-fill : transparent;
                accessible-role: button;
                accessible-label: item.label;
                accessible-description: item.shortcut;
                accessible-enabled: item.enabled;
                accessible-checkable: item.icon == "check";
                accessible-checked: item.icon == "check";
                accessible-action-default => {
                    if item.enabled {
                        root.plugin-menu-open = false;
                        root.plugin-button-clicked(root.plugin-menu-plugin-id, root.plugin-menu-button-id, item.id);
                    }
                }

                Text {
                    x: 8px;
                    width: 14px;
                    y: (parent.height - self.height) / 2;
                    text: item.icon == "check" ? "✓" : "";
                    color: Theme.text-strong;
                    font-size: 12px;
                    accessible-role: none;
                }

                Text {
                    x: 26px;
                    y: (parent.height - self.height) / 2;
                    text: item.label;
                    color: item.enabled ? Theme.text-strong : Theme.text-disabled;
                    font-size: 12px;
                    accessible-role: none;
                }

                item-touch := TouchArea {
                    enabled: item.enabled;
                    clicked => {
                        root.plugin-menu-open = false;
                        root.plugin-button-clicked(root.plugin-menu-plugin-id, root.plugin-menu-button-id, item.id);
                    }
                }
            }
        }
    }
}
