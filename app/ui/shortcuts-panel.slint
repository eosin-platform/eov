// The Keyboard Shortcuts panel (F1): eov's shortcuts and plugins' keys.

import { Locale } from "locale.slint";
import { Theme } from "theme.slint";
import { DialogKeys } from "dialog-keys.slint";
import { ShortcutRow } from "types.slint";

export component ShortcutsPanel inherits Rectangle {
    in property <[ShortcutRow]> rows;
    /// How to change keys, with the configuration file's path.
    in property <string> hint;
    callback close();
    callback copy-config-path();

    background: Theme.scrim;

    TouchArea {
        clicked => {
            root.close();
        }
    }

    FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == Key.F1 {
                root.close();
                return accept;
            }
            reject
        }

        DialogKeys {
            title: @tr("Keyboard Shortcuts");
            cancel => {
                root.close();
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(560px, root.width - 32px);
                height: min(root.height - 64px, 680px);
                background: Theme.surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;

                TouchArea { }

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    HorizontalLayout {
                        vertical-stretch: 0;
                        Text {
                            text: @tr("Keyboard Shortcuts");
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            horizontal-alignment: Locale.start;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 4px;
                            background: close-touch.has-hover ? Theme.surface-hover : transparent;
                            accessible-role: button;
                            accessible-label: @tr("Close");
                            accessible-action-default => {
                                root.close();
                            }

                            Text {
                                text: "✕";
                                color: Theme.text-secondary;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                accessible-role: none;
                            }

                            close-touch := TouchArea {
                                clicked => {
                                    root.close();
                                }
                            }
                        }
                    }

                    // Takes the height the window leaves, and scrolls.
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 60px;

                        Flickable {
                            width: parent.width;
                            height: parent.height;
                            content-height: list.preferred-height;

                            list := VerticalLayout {
                                for row in root.rows: Rectangle {
                                    // A long entry (a plugin's tool with the keys it
                                    // goes with) wraps onto more lines.
                                    height: max(row.heading ? 32px : 24px, entry-layout.preferred-height);

                                    entry-layout := HorizontalLayout {
                                        // A heading sits 4px above the row's bottom.
                                        padding-top: row.heading ? 0px : 3px;
                                        padding-bottom: row.heading ? 4px : 3px;
                                        spacing: 12px;

                                        Text {
                                            text: row.label;
                                            color: row.heading ? Theme.accent : Theme.text-primary;
                                            font-size: 12px;
                                            font-weight: row.heading ? 600 : 400;
                                            horizontal-alignment: Locale.start;
                                            vertical-alignment: row.heading ? TextVerticalAlignment.bottom : TextVerticalAlignment.center;
                                            horizontal-stretch: 1;
                                            wrap: word-wrap;
                                        }

                                        if row.id != "": Text {
                                            text: row.id;
                                            color: Theme.text-secondary;
                                            font-size: Locale.text-size(10px);
                                            font-family: "monospace";
                                            vertical-alignment: center;
                                        }

                                        if !row.heading: Text {
                                            text: row.keys == "" ? @tr("no key") : row.keys;
                                            color: row.keys == "" ? Theme.text-secondary : Theme.text-primary;
                                            font-size: 12px;
                                            font-family: "monospace";
                                            vertical-alignment: center;
                                            horizontal-alignment: Locale.end;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Text {
                        text: root.hint;
                        color: Theme.text-secondary;
                        font-size: Locale.text-size(11px);
                        wrap: word-wrap;
                        horizontal-alignment: Locale.start;
                        height: self.preferred-height;
                    }

                    HorizontalLayout {
                        vertical-stretch: 0;
                        alignment: end;

                        Rectangle {
                            min-width: copy-text.preferred-width + 16px;
                            height: 28px;
                            border-radius: 4px;
                            background: copy-touch.has-hover ? Theme.surface-hover : Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;
                            accessible-role: button;
                            accessible-label: @tr("Copy Config Path");
                            accessible-action-default => {
                                root.copy-config-path();
                            }

                            copy-text := Text {
                                text: @tr("Copy Config Path");
                                accessible-role: none;
                                color: Theme.text-primary;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            copy-touch := TouchArea {
                                clicked => {
                                    root.copy-config-path();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
