// The Quantify Stain panel: positive-pixel analysis and an H-score of one
// stain in the region of interest, for brightfield IHC.

import { Theme } from "theme.slint";
import { ChoiceItem, ResultRow } from "types.slint";

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();

    width: label.preferred-width + 18px;
    height: 24px;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.border;
    background: root.selected ? Theme.accent : touch.has-hover ? Theme.surface-hover : transparent;

    label := Text {
        text: root.text;
        color: root.selected ? white : Theme.text-primary;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component NumberField inherits Rectangle {
    in property <string> label;
    in-out property <string> text;
    callback edited(string);

    width: 120px;
    height: 44px;

    VerticalLayout {
        spacing: 3px;

        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: 10px;
        }

        Rectangle {
            height: 24px;
            border-radius: 4px;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;
            background: #0a0c10;

            input := TextInput {
                x: 6px;
                width: parent.width - 12px;
                height: parent.height;
                text <=> root.text;
                color: Theme.text-primary;
                font-size: 12px;
                vertical-alignment: center;
                single-line: true;
                edited => {
                    root.edited(self.text);
                }
            }
        }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    min-width: label.preferred-width + 16px;
    height: 28px;
    border-radius: 4px;
    background: !root.enabled ? Theme.surface
        : root.primary ? (touch.has-hover ? #1177bb : Theme.accent)
        : (touch.has-hover ? Theme.surface-hover : Theme.surface);
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border;

    label := Text {
        text: root.text;
        color: !root.enabled ? Theme.text-secondary : root.primary ? white : Theme.text-primary;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

export component QuantifyPanel inherits Rectangle {
    in property <string> title;
    in property <[ChoiceItem]> presets;
    in property <string> preset;
    in property <[ChoiceItem]> stains;
    in property <string> stain;
    in-out property <string> weak;
    in-out property <string> moderate;
    in-out property <string> strong;
    /// The region and the resolution it is read at.
    in property <string> region-text;
    /// Problems with the inputs, or the state of a run.
    in property <string> note;
    in property <bool> running;
    in property <[ResultRow]> results;
    callback preset-chosen(string);
    callback stain-chosen(string);
    callback thresholds-edited(string, string, string);
    callback run-requested();
    callback copy-requested();
    callback close-requested();

    background: #00000088;

    TouchArea {
        clicked => {
            root.close-requested();
        }
    }

    FocusScope {
        init => {
            self.focus();
        }
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.close-requested();
                return accept;
            }
            reject
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(600px, root.width - 32px);
            height: min(root.height - 64px, layout.preferred-height);
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            TouchArea { }

            layout := VerticalLayout {
                padding: 20px;
                spacing: 12px;

                HorizontalLayout {
                    Text {
                        text: root.title;
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 4px;
                        background: close-touch.has-hover ? Theme.surface-hover : transparent;

                        Text {
                            text: "✕";
                            color: Theme.text-secondary;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        close-touch := TouchArea {
                            clicked => {
                                root.close-requested();
                            }
                        }
                    }
                }

                Text {
                    text: root.region-text;
                    color: Theme.text-secondary;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Text {
                    text: "Stain model";
                    color: Theme.text-secondary;
                    font-size: 11px;
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    for item in root.presets: Chip {
                        text: item.label;
                        selected: item.id == root.preset;
                        clicked => {
                            root.preset-chosen(item.id);
                        }
                    }
                }

                Text {
                    text: "Stain to measure";
                    color: Theme.text-secondary;
                    font-size: 11px;
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    for item in root.stains: Chip {
                        text: item.label;
                        selected: item.id == root.stain;
                        clicked => {
                            root.stain-chosen(item.id);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    NumberField {
                        label: "Weak (1+) from";
                        text <=> root.weak;
                        edited => {
                            root.thresholds-edited(root.weak, root.moderate, root.strong);
                        }
                    }

                    NumberField {
                        label: "Moderate (2+) from";
                        text <=> root.moderate;
                        edited => {
                            root.thresholds-edited(root.weak, root.moderate, root.strong);
                        }
                    }

                    NumberField {
                        label: "Strong (3+) from";
                        text <=> root.strong;
                        edited => {
                            root.thresholds-edited(root.weak, root.moderate, root.strong);
                        }
                    }
                }

                Text {
                    text: "Thresholds are stain concentrations (optical density along the stain's vector), as the deconvolution view shows them.";
                    color: Theme.text-secondary;
                    font-size: 10px;
                    wrap: word-wrap;
                }

                if root.results.length > 0: Rectangle {
                    border-radius: 6px;
                    background: Theme.background;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;

                        for row in root.results: HorizontalLayout {
                            Text {
                                text: row.label;
                                color: Theme.text-secondary;
                                font-size: 12px;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: row.value;
                                color: Theme.text-primary;
                                font-size: 12px;
                                font-weight: 600;
                            }
                        }
                    }
                }

                if root.note != "": Text {
                    text: root.note;
                    color: #f1c40f;
                    font-size: 11px;
                    wrap: word-wrap;
                    height: self.preferred-height;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Button {
                        text: "Copy Results";
                        enabled: root.results.length > 0;
                        clicked => {
                            root.copy-requested();
                        }
                    }

                    Button {
                        text: root.running ? "Measuring…" : "Quantify";
                        primary: true;
                        enabled: !root.running;
                        clicked => {
                            root.run-requested();
                        }
                    }
                }
            }
        }
    }
}
