// The Quantify Stain panel: positive-pixel analysis and an H-score of one
// stain in the region of interest, for brightfield IHC.

import { Theme } from "theme.slint";
import { ChoiceItem, ResultRow } from "types.slint";
import { Chip, NumberField, PanelButton } from "panel-controls.slint";
import { DialogKeys } from "dialog-keys.slint";

export component QuantifyPanel inherits Rectangle {
    in property <string> title;
    in property <[ChoiceItem]> presets;
    in property <string> preset;
    in property <[ChoiceItem]> stains;
    in property <string> stain;
    in-out property <string> weak;
    in-out property <string> moderate;
    in-out property <string> strong;
    /// The region and the resolution it is read at.
    in property <string> region-text;
    /// Problems with the inputs, or the state of a run.
    in property <string> note;
    in property <bool> running;
    in property <[ResultRow]> results;
    callback preset-chosen(string);
    callback stain-chosen(string);
    callback thresholds-edited(string, string, string);
    callback run-requested();
    callback copy-requested();
    callback close-requested();

    background: Theme.scrim;

    TouchArea {
        clicked => {
            root.close-requested();
        }
    }

    DialogKeys {
        title: root.title;
        has-default-action: !root.running;
        cancel => {
            root.close-requested();
        }
        default-action => {
            root.run-requested();
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(600px, root.width - 32px);
            height: min(root.height - 64px, layout.preferred-height);
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            TouchArea { }

            layout := VerticalLayout {
                padding: 20px;
                spacing: 12px;

                HorizontalLayout {
                    Text {
                        text: root.title;
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 4px;
                        background: close-touch.has-hover ? Theme.surface-hover : transparent;
                        accessible-role: button;
                        accessible-label: @tr("Close");
                        accessible-action-default => {
                            root.close-requested();
                        }

                        Text {
                            text: "✕";
                            color: Theme.text-secondary;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            accessible-role: none;
                        }

                        close-touch := TouchArea {
                            clicked => {
                                root.close-requested();
                            }
                        }
                    }
                }

                Text {
                    text: root.region-text;
                    color: Theme.text-secondary;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Text {
                    text: @tr("Stain model");
                    color: Theme.text-secondary;
                    font-size: 11px;
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    for item in root.presets: Chip {
                        text: item.label;
                        selected: item.id == root.preset;
                        clicked => {
                            root.preset-chosen(item.id);
                        }
                    }
                }

                Text {
                    text: @tr("Stain to measure");
                    color: Theme.text-secondary;
                    font-size: 11px;
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    for item in root.stains: Chip {
                        text: item.label;
                        selected: item.id == root.stain;
                        clicked => {
                            root.stain-chosen(item.id);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    NumberField {
                        label: @tr("Weak (1+) from");
                        accepted => {
                            if !root.running {
                                root.run-requested();
                            }
                        }
                        text <=> root.weak;
                        edited => {
                            root.thresholds-edited(root.weak, root.moderate, root.strong);
                        }
                    }

                    NumberField {
                        label: @tr("Moderate (2+) from");
                        accepted => {
                            if !root.running {
                                root.run-requested();
                            }
                        }
                        text <=> root.moderate;
                        edited => {
                            root.thresholds-edited(root.weak, root.moderate, root.strong);
                        }
                    }

                    NumberField {
                        label: @tr("Strong (3+) from");
                        accepted => {
                            if !root.running {
                                root.run-requested();
                            }
                        }
                        text <=> root.strong;
                        edited => {
                            root.thresholds-edited(root.weak, root.moderate, root.strong);
                        }
                    }
                }

                Text {
                    text: @tr("Thresholds are stain concentrations (optical density along the stain's vector), as the deconvolution view shows them.");
                    color: Theme.text-secondary;
                    font-size: 10px;
                    wrap: word-wrap;
                }

                if root.results.length > 0: Rectangle {
                    border-radius: 6px;
                    background: Theme.background;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;

                        for row in root.results: HorizontalLayout {
                            Text {
                                text: row.label;
                                color: Theme.text-secondary;
                                font-size: 12px;
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: row.value;
                                color: Theme.text-primary;
                                font-size: 12px;
                                font-weight: 600;
                            }
                        }
                    }
                }

                if root.note != "": Text {
                    text: root.note;
                    color: Theme.warning;
                    font-size: 11px;
                    wrap: word-wrap;
                    height: self.preferred-height;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    PanelButton {
                        text: @tr("Copy Results");
                        enabled: root.results.length > 0;
                        clicked => {
                            root.copy-requested();
                        }
                    }

                    PanelButton {
                        text: root.running ? @tr("Measuring…") : @tr("Quantify");
                        primary: true;
                        enabled: !root.running;
                        clicked => {
                            root.run-requested();
                        }
                    }
                }
            }
        }
    }
}
