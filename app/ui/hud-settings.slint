import { Theme } from "theme.slint";
import { DialogKeys } from "dialog-keys.slint";
import {
    MeasurementUnit,
    StainNormalization,
    IsolatedChannel,
} from "types.slint";

component HudSlider inherits Rectangle {
    in property <string> label;
    in property <float> value: 0.0;
    in property <float> min-value: 0.0;
    in property <float> max-value: 1.0;
    in property <float> default-value: 0.0;
    in property <string> display-text;
    /// What one increment (assistive technology) changes.
    in property <float> step: 0.05;
    callback changed(float);

    height: 28px;
    background: transparent;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.display-text;
    accessible-value-minimum: root.min-value;
    accessible-value-maximum: root.max-value;
    accessible-value-step: root.step;
    accessible-action-increment => {
        root.changed(max(root.min-value, min(root.max-value, root.value + root.step)));
    }
    accessible-action-decrement => {
        root.changed(min(root.max-value, max(root.min-value, root.value - root.step)));
    }

    property <float> normalized: (value - min-value) / max(max-value - min-value, 0.001);
    property <length> track-left: 80px;
    property <length> track-right: 42px;
    property <length> track-width: self.width - track-left - track-right;

    Text {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: 68px;
        text: root.label;
        color: Theme.text-label;
        font-size: 11px;
        vertical-alignment: center;
        accessible-role: none;
    }

    Rectangle {
        x: root.track-left;
        y: (parent.height - 3px) / 2;
        width: root.track-width;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.track;

        Rectangle {
            x: 0px;
            width: root.normalized * parent.width;
            height: parent.height;
            border-radius: parent.border-radius;
            background: Theme.accent-bright;
        }
    }

    // Handle
    Rectangle {
        x: root.track-left + root.normalized * root.track-width - 5px;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.handle;
        border-width: 1px;
        border-color: Theme.accent-bright;
    }

    slider-touch := TouchArea {
        x: root.track-left - 5px;
        y: 0px;
        width: root.track-width + 10px;
        height: root.height;

        double-clicked => {
            root.changed(root.default-value);
        }

        pointer-event(e) => {
            if e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed) {
                let norm = max(0.0, min(1.0, (self.mouse-x - 5px) / max(root.track-width, 1px)));
                root.changed(root.min-value + norm * (root.max-value - root.min-value));
            }
        }
    }

    Text {
        x: parent.width - root.track-right + 4px;
        y: (parent.height - self.height) / 2;
        width: root.track-right - 8px;
        text: root.display-text;
        color: Theme.text-value;
        font-size: 10px;
        horizontal-alignment: right;
        vertical-alignment: center;
        accessible-role: none;
    }
}

export component HudSettingsPanel inherits Rectangle {
    in property <float> sharpness: 0.0;
    in property <float> gamma: 1.0;
    in property <float> brightness: 0.0;
    in property <float> contrast: 1.0;
    in property <MeasurementUnit> measurement-unit: MeasurementUnit.um;
    in property <StainNormalization> stain-normalization: StainNormalization.none;
    in property <bool> has-adjustments: false;
    in property <float> deconv-hematoxylin-intensity: 1.0;
    in property <bool> deconv-hematoxylin-visible: true;
    in property <float> deconv-eosin-intensity: 1.0;
    in property <bool> deconv-eosin-visible: true;
    in property <IsolatedChannel> deconv-isolated-channel: IsolatedChannel.none;

    callback sharpness-changed(float);
    callback gamma-changed(float);
    callback brightness-changed(float);
    callback contrast-changed(float);
    callback measurement-unit-changed(MeasurementUnit);
    callback stain-normalization-changed(StainNormalization);
    callback reset-adjustments();
    callback deconv-h-intensity-changed(float);
    callback deconv-e-intensity-changed(float);
    callback deconv-h-visibility-toggled();
    callback deconv-e-visibility-toggled();
    callback deconv-h-view-toggled();
    callback deconv-e-view-toggled();
    /// Escape was pressed.
    callback close-requested();

    width: 260px;
    height: layout.preferred-height + 33px;
    background: Theme.hud-panel-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.outline;
    drop-shadow-blur: 16px;
    drop-shadow-color: Theme.shadow;

    // Clicks and scrolling on the panel's background stay here instead of
    // reaching the slide underneath.
    TouchArea {
        scroll-event(e) => {
            accept
        }
    }

    DialogKeys {
        title: "Image Adjustments";
        cancel => {
            root.close-requested();
        }
    }

    layout := VerticalLayout {
        padding: 4px;
        spacing: 2px;

        // Header
        Rectangle {
            height: 28px;

            Text {
                x: 8px;
                text: "Image Adjustments";
                color: Theme.text-strong;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        HudSlider {
            label: "Sharpness";
            value: root.sharpness;
            min-value: 0.0;
            max-value: 1.0;
            display-text: Math.round(root.sharpness * 100) + "%";
            changed(v) => {
                root.sharpness-changed(v);
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        HudSlider {
            label: "Gamma";
            value: root.gamma;
            min-value: 0.2;
            max-value: 3.0;
            default-value: 1.0;
            display-text: Math.round(root.gamma * 100) / 100 + "";
            changed(v) => {
                root.gamma-changed(v);
            }
        }

        HudSlider {
            label: "Brightness";
            value: root.brightness;
            min-value: -1.0;
            max-value: 1.0;
            display-text: (root.brightness >= 0 ? "+" : "") + Math.round(root.brightness * 100) + "%";
            changed(v) => {
                root.brightness-changed(v);
            }
        }

        HudSlider {
            label: "Contrast";
            value: root.contrast;
            min-value: 0.2;
            max-value: 3.0;
            default-value: 1.0;
            display-text: Math.round(root.contrast * 100) / 100 + "x";
            changed(v) => {
                root.contrast-changed(v);
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        // Measurement unit row
        Rectangle {
            height: 28px;

            Text {
                x: 8px;
                text: "Units";
                color: Theme.text-label;
                font-size: 11px;
                vertical-alignment: center;
                accessible-role: none;
            }

            HorizontalLayout {
                x: 80px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 88px;
                height: 22px;
                spacing: 2px;

                Rectangle {
                    width: (parent.width - 4px) / 3;
                    height: 22px;
                    border-radius: 3px;
                    background: root.measurement-unit == MeasurementUnit.um ? Theme.selected-fill : um-touch.has-hover ? Theme.hover-fill : transparent;
                    border-width: root.measurement-unit == MeasurementUnit.um ? Theme.selected-width : 0px;
                    border-color: Theme.accent-bright;
                    accessible-role: radio-button;
                    accessible-label: "Micrometres (µm)";
                    accessible-checkable: true;
                    accessible-checked: root.measurement-unit == MeasurementUnit.um;
                    accessible-action-default => {
                        root.measurement-unit-changed(MeasurementUnit.um);
                    }

                    um-touch := TouchArea {
                        clicked => {
                            root.measurement-unit-changed(MeasurementUnit.um);
                        }
                    }

                    Text {
                        text: "µm";
                        accessible-role: none;
                        color: root.measurement-unit == MeasurementUnit.um ? Theme.text-selected : Theme.text-primary;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: (parent.width - 4px) / 3;
                    height: 22px;
                    border-radius: 3px;
                    background: root.measurement-unit == MeasurementUnit.mm ? Theme.selected-fill : mm-touch.has-hover ? Theme.hover-fill : transparent;
                    border-width: root.measurement-unit == MeasurementUnit.mm ? Theme.selected-width : 0px;
                    border-color: Theme.accent-bright;
                    accessible-role: radio-button;
                    accessible-label: "Millimetres (mm)";
                    accessible-checkable: true;
                    accessible-checked: root.measurement-unit == MeasurementUnit.mm;
                    accessible-action-default => {
                        root.measurement-unit-changed(MeasurementUnit.mm);
                    }

                    mm-touch := TouchArea {
                        clicked => {
                            root.measurement-unit-changed(MeasurementUnit.mm);
                        }
                    }

                    Text {
                        text: "mm";
                        accessible-role: none;
                        color: root.measurement-unit == MeasurementUnit.mm ? Theme.text-selected : Theme.text-primary;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: (parent.width - 4px) / 3;
                    height: 22px;
                    border-radius: 3px;
                    background: root.measurement-unit == MeasurementUnit.inches ? Theme.selected-fill : in-touch.has-hover ? Theme.hover-fill : transparent;
                    border-width: root.measurement-unit == MeasurementUnit.inches ? Theme.selected-width : 0px;
                    border-color: Theme.accent-bright;
                    accessible-role: radio-button;
                    accessible-label: "Inches and mils";
                    accessible-checkable: true;
                    accessible-checked: root.measurement-unit == MeasurementUnit.inches;
                    accessible-action-default => {
                        root.measurement-unit-changed(MeasurementUnit.inches);
                    }

                    in-touch := TouchArea {
                        clicked => {
                            root.measurement-unit-changed(MeasurementUnit.inches);
                        }
                    }

                    Text {
                        text: "in/mil";
                        accessible-role: none;
                        color: root.measurement-unit == MeasurementUnit.inches ? Theme.text-selected : Theme.text-primary;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        // Stain normalization row
        Rectangle {
            height: 28px;

            Text {
                x: 8px;
                text: "Stain Norm";
                color: Theme.text-label;
                font-size: 11px;
                vertical-alignment: center;
                accessible-role: none;
            }

            HorizontalLayout {
                x: 80px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 88px;
                height: 22px;
                spacing: 2px;

                Rectangle {
                    width: (parent.width - 4px) / 3;
                    height: 22px;
                    border-radius: 3px;
                    background: root.stain-normalization == StainNormalization.none ? Theme.selected-fill : sn-none-touch.has-hover ? Theme.hover-fill : transparent;
                    border-width: root.stain-normalization == StainNormalization.none ? Theme.selected-width : 0px;
                    border-color: Theme.accent-bright;
                    accessible-role: radio-button;
                    accessible-label: "Stain normalization: none";
                    accessible-checkable: true;
                    accessible-checked: root.stain-normalization == StainNormalization.none;
                    accessible-action-default => {
                        root.stain-normalization-changed(StainNormalization.none);
                    }

                    sn-none-touch := TouchArea {
                        clicked => {
                            root.stain-normalization-changed(StainNormalization.none);
                        }
                    }

                    Text {
                        text: "None";
                        accessible-role: none;
                        color: root.stain-normalization == StainNormalization.none ? Theme.text-selected : Theme.text-primary;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: (parent.width - 4px) / 3;
                    height: 22px;
                    border-radius: 3px;
                    background: root.stain-normalization == StainNormalization.macenko ? Theme.selected-fill : sn-macenko-touch.has-hover ? Theme.hover-fill : transparent;
                    border-width: root.stain-normalization == StainNormalization.macenko ? Theme.selected-width : 0px;
                    border-color: Theme.accent-bright;
                    accessible-role: radio-button;
                    accessible-label: "Stain normalization: Macenko";
                    accessible-checkable: true;
                    accessible-checked: root.stain-normalization == StainNormalization.macenko;
                    accessible-action-default => {
                        root.stain-normalization-changed(StainNormalization.macenko);
                    }

                    sn-macenko-touch := TouchArea {
                        clicked => {
                            root.stain-normalization-changed(StainNormalization.macenko);
                        }
                    }

                    Text {
                        text: "Macenko";
                        accessible-role: none;
                        color: root.stain-normalization == StainNormalization.macenko ? Theme.text-selected : Theme.text-primary;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: (parent.width - 4px) / 3;
                    height: 22px;
                    border-radius: 3px;
                    background: root.stain-normalization == StainNormalization.vahadane ? Theme.selected-fill : sn-vahadane-touch.has-hover ? Theme.hover-fill : transparent;
                    border-width: root.stain-normalization == StainNormalization.vahadane ? Theme.selected-width : 0px;
                    border-color: Theme.accent-bright;
                    accessible-role: radio-button;
                    accessible-label: "Stain normalization: Vahadane";
                    accessible-checkable: true;
                    accessible-checked: root.stain-normalization == StainNormalization.vahadane;
                    accessible-action-default => {
                        root.stain-normalization-changed(StainNormalization.vahadane);
                    }

                    sn-vahadane-touch := TouchArea {
                        clicked => {
                            root.stain-normalization-changed(StainNormalization.vahadane);
                        }
                    }

                    Text {
                        text: "Vahadane";
                        accessible-role: none;
                        color: root.stain-normalization == StainNormalization.vahadane ? Theme.text-selected : Theme.text-primary;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        // Color Deconvolution header
        Rectangle {
            height: 24px;

            Text {
                x: 8px;
                text: "Color Deconvolution";
                color: Theme.text-strong;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        // Hematoxylin row
        Rectangle {
            height: 28px;

            // Slider area
            h-slider-area := Rectangle {
                property <float> normalized: (root.deconv-hematoxylin-intensity - 0.0) / 3.0;
                property <length> track-left: 24px;
                property <length> track-right: 52px;
                property <length> track-width: parent.width - self.track-left - self.track-right;
                accessible-role: slider;
                accessible-label: "Hematoxylin intensity";
                accessible-value: h-intensity-text.text;
                accessible-value-minimum: 0;
                accessible-value-maximum: 3;
                accessible-value-step: 0.05;
                accessible-action-increment => {
                    root.deconv-h-intensity-changed(min(3.0, root.deconv-hematoxylin-intensity + 0.05));
                }
                accessible-action-decrement => {
                    root.deconv-h-intensity-changed(max(0.0, root.deconv-hematoxylin-intensity - 0.05));
                }

                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;

                Rectangle {
                    x: parent.track-left;
                    y: (parent.height - 3px) / 2;
                    width: parent.track-width;
                    height: 3px;
                    border-radius: 1.5px;
                    background: Theme.track;

                    Rectangle {
                        x: 0px;
                        width: h-slider-area.normalized * parent.width;
                        height: parent.height;
                        border-radius: parent.border-radius;
                        background: Theme.stain-hematoxylin;
                    }
                }

                Rectangle {
                    x: parent.track-left + parent.normalized * parent.track-width - 5px;
                    y: (parent.height - 10px) / 2;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Theme.handle;
                    border-width: 1px;
                    border-color: Theme.stain-hematoxylin;
                }

                h-slider-touch := TouchArea {
                    x: parent.track-left - 5px;
                    y: 0px;
                    width: parent.track-width + 10px;
                    height: parent.height;

                    double-clicked => {
                        root.deconv-h-intensity-changed(1.0);
                    }

                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed) {
                            let norm = max(0.0, min(1.0, (self.mouse-x - 5px) / max(parent.track-width, 1px)));
                            root.deconv-h-intensity-changed(norm * 3.0);
                        }
                    }
                }

                h-intensity-text := Text {
                    x: parent.width - parent.track-right + 4px;
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    text: Math.round(root.deconv-hematoxylin-intensity * 100) / 100 + "x";
                    accessible-role: none;
                    color: Theme.text-value;
                    font-size: 10px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            // View/isolate button
            Rectangle {
                x: parent.width - 16px;
                y: (parent.height - 16px) / 2;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: root.deconv-isolated-channel == IsolatedChannel.hematoxylin ? Theme.stain-hematoxylin : h-view-touch.has-hover ? Theme.hover-fill : transparent;
                border-width: 1px;
                accessible-role: button;
                accessible-label: "View hematoxylin alone";
                accessible-checkable: true;
                accessible-checked: root.deconv-isolated-channel == IsolatedChannel.hematoxylin;
                accessible-action-default => {
                    root.deconv-h-view-toggled();
                }
                border-color: root.deconv-isolated-channel == IsolatedChannel.hematoxylin ? Theme.stain-hematoxylin : Theme.outline-strong;

                h-view-touch := TouchArea {
                    clicked => {
                        root.deconv-h-view-toggled();
                    }
                }
            }

            // The channel's letter shows and hides it.
            Rectangle {
                x: 3px;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 20px;
                border-radius: 4px;
                background: h-eye-touch.has-hover ? Theme.hover-fill : transparent;
                accessible-role: checkbox;
                accessible-label: "Show hematoxylin";
                accessible-checkable: true;
                accessible-checked: root.deconv-hematoxylin-visible;
                accessible-action-default => {
                    root.deconv-h-visibility-toggled();
                }

                Text {
                    text: "H";
                    accessible-role: none;
                    color: Theme.stain-hematoxylin;
                    opacity: root.deconv-hematoxylin-visible ? 1.0 : 0.35;
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if !root.deconv-hematoxylin-visible: Rectangle {
                    x: 3px;
                    y: parent.height / 2;
                    width: parent.width - 6px;
                    height: 1px;
                    background: Theme.text-value;
                }

                h-eye-touch := TouchArea {
                    clicked => {
                        root.deconv-h-visibility-toggled();
                    }
                }
            }
        }

        // Eosin row
        Rectangle {
            height: 28px;

            // Slider area
            e-slider-area := Rectangle {
                property <float> normalized: (root.deconv-eosin-intensity - 0.0) / 3.0;
                property <length> track-left: 24px;
                property <length> track-right: 52px;
                property <length> track-width: parent.width - self.track-left - self.track-right;
                accessible-role: slider;
                accessible-label: "Eosin intensity";
                accessible-value: e-intensity-text.text;
                accessible-value-minimum: 0;
                accessible-value-maximum: 3;
                accessible-value-step: 0.05;
                accessible-action-increment => {
                    root.deconv-e-intensity-changed(min(3.0, root.deconv-eosin-intensity + 0.05));
                }
                accessible-action-decrement => {
                    root.deconv-e-intensity-changed(max(0.0, root.deconv-eosin-intensity - 0.05));
                }

                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;

                Rectangle {
                    x: parent.track-left;
                    y: (parent.height - 3px) / 2;
                    width: parent.track-width;
                    height: 3px;
                    border-radius: 1.5px;
                    background: Theme.track;

                    Rectangle {
                        x: 0px;
                        width: e-slider-area.normalized * parent.width;
                        height: parent.height;
                        border-radius: parent.border-radius;
                        background: Theme.stain-eosin;
                    }
                }

                Rectangle {
                    x: parent.track-left + parent.normalized * parent.track-width - 5px;
                    y: (parent.height - 10px) / 2;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Theme.handle;
                    border-width: 1px;
                    border-color: Theme.stain-eosin;
                }

                e-slider-touch := TouchArea {
                    x: parent.track-left - 5px;
                    y: 0px;
                    width: parent.track-width + 10px;
                    height: parent.height;

                    double-clicked => {
                        root.deconv-e-intensity-changed(1.0);
                    }

                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed) {
                            let norm = max(0.0, min(1.0, (self.mouse-x - 5px) / max(parent.track-width, 1px)));
                            root.deconv-e-intensity-changed(norm * 3.0);
                        }
                    }
                }

                e-intensity-text := Text {
                    x: parent.width - parent.track-right + 4px;
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    text: Math.round(root.deconv-eosin-intensity * 100) / 100 + "x";
                    accessible-role: none;
                    color: Theme.text-value;
                    font-size: 10px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            // View/isolate button
            Rectangle {
                x: parent.width - 16px;
                y: (parent.height - 16px) / 2;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: root.deconv-isolated-channel == IsolatedChannel.eosin ? Theme.stain-eosin : e-view-touch.has-hover ? Theme.hover-fill : transparent;
                border-width: 1px;
                accessible-role: button;
                accessible-label: "View eosin alone";
                accessible-checkable: true;
                accessible-checked: root.deconv-isolated-channel == IsolatedChannel.eosin;
                accessible-action-default => {
                    root.deconv-e-view-toggled();
                }
                border-color: root.deconv-isolated-channel == IsolatedChannel.eosin ? Theme.stain-eosin : Theme.outline-strong;

                e-view-touch := TouchArea {
                    clicked => {
                        root.deconv-e-view-toggled();
                    }
                }
            }

            // The channel's letter shows and hides it.
            Rectangle {
                x: 3px;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 20px;
                border-radius: 4px;
                background: e-eye-touch.has-hover ? Theme.hover-fill : transparent;
                accessible-role: checkbox;
                accessible-label: "Show eosin";
                accessible-checkable: true;
                accessible-checked: root.deconv-eosin-visible;
                accessible-action-default => {
                    root.deconv-e-visibility-toggled();
                }

                Text {
                    text: "E";
                    accessible-role: none;
                    color: Theme.stain-eosin;
                    opacity: root.deconv-eosin-visible ? 1.0 : 0.35;
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if !root.deconv-eosin-visible: Rectangle {
                    x: 3px;
                    y: parent.height / 2;
                    width: parent.width - 6px;
                    height: 1px;
                    background: Theme.text-value;
                }

                e-eye-touch := TouchArea {
                    clicked => {
                        root.deconv-e-visibility-toggled();
                    }
                }
            }
        }
    }

    // Divider above reset button
    Rectangle {
        x: 0px;
        y: layout.preferred-height;
        width: 100%;
        height: 1px;
        background: Theme.divider;
    }

    // Reset to Defaults button
    Rectangle {
        x: 0px;
        y: layout.preferred-height + 1px;
        width: 100%;
        height: 32px;
        background: defaults-touch.has-hover ? Theme.hover-fill : transparent;
        border-bottom-left-radius: root.border-radius;
        border-bottom-right-radius: root.border-radius;
        accessible-role: button;
        accessible-label: "Reset to Defaults";
        accessible-action-default => {
            root.reset-adjustments();
        }

        defaults-touch := TouchArea {
            clicked => {
                root.reset-adjustments();
            }
        }

        Text {
            text: "Reset to Defaults";
            accessible-role: none;
            color: Theme.error;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
