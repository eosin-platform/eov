import { Theme } from "theme.slint";
import { DialogKeys } from "dialog-keys.slint";
import { PluginRowData } from "types.slint";

// Lists every plugin with its version, origin and state, and lets the user
// turn plugins on and off.
export component PluginsPanel inherits Rectangle {
    in property <[PluginRowData]> rows: [];
    in property <string> plugin-dir: "";
    in property <string> note: "";
    /// The result of the last Check for Updates.
    in property <string> update-note: "";
    in property <bool> checking: false;
    callback close-requested();
    callback enable-requested(/* plugin id */ string, /* enable */ bool);
    callback open-folder-requested();
    callback check-updates-requested();
    callback update-requested(/* plugin id */ string);
    callback remove-requested(/* plugin id */ string);

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    background: Theme.scrim;

    TouchArea {
        clicked => {
            root.close-requested();
        }
    }

    DialogKeys {
        title: @tr("Plugins");
        cancel => {
            root.close-requested();
        }

        card := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 40px, 720px);
            height: min(parent.height - 40px, 520px);
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;

            TouchArea { }

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: @tr("Plugins");
                        color: Theme.text-primary;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: check-text.preferred-width + 16px;
                        height: 26px;
                        border-radius: 4px;
                        background: check-touch.has-hover && !root.checking ? Theme.surface-hover : Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        accessible-role: button;
                        accessible-label: check-text.text;
                        accessible-enabled: !root.checking;
                        accessible-action-default => {
                            if !root.checking {
                                root.check-updates-requested();
                            }
                        }

                        check-text := Text {
                            text: root.checking ? @tr("Checking…") : @tr("Check for updates");
                            accessible-role: none;
                            color: root.checking ? Theme.text-secondary : Theme.text-primary;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        check-touch := TouchArea {
                            enabled: !root.checking;
                            clicked => {
                                root.check-updates-requested();
                            }
                        }
                    }

                    Rectangle {
                        width: folder-text.preferred-width + 16px;
                        height: 26px;
                        border-radius: 4px;
                        background: folder-touch.has-hover ? Theme.surface-hover : Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        accessible-role: button;
                        accessible-label: @tr("Open plugin folder");
                        accessible-action-default => {
                            root.open-folder-requested();
                        }

                        folder-text := Text {
                            text: @tr("Open plugin folder");
                            accessible-role: none;
                            color: Theme.text-primary;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        folder-touch := TouchArea {
                            clicked => {
                                root.open-folder-requested();
                            }
                        }
                    }

                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        background: close-touch.has-hover ? Theme.surface-hover : transparent;
                        accessible-role: button;
                        accessible-label: @tr("Close");
                        accessible-action-default => {
                            root.close-requested();
                        }

                        Text {
                            text: "×";
                            color: Theme.text-secondary;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            accessible-role: none;
                        }

                        close-touch := TouchArea {
                            clicked => {
                                root.close-requested();
                            }
                        }
                    }
                }

                Text {
                    text: root.plugin-dir != "" ? @tr("Plugin packages (.eop) are loaded from {}", root.plugin-dir) : "";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    wrap: word-wrap;
                    // Only its own height: otherwise the text takes the panel's
                    // spare height and pushes the list to the bottom.
                    height: self.preferred-height;
                }

                if root.note != "": Text {
                    text: root.note;
                    color: Theme.warning;
                    font-size: 11px;
                    wrap: word-wrap;
                    height: self.preferred-height;
                }

                if root.update-note != "": Text {
                    text: root.update-note;
                    color: Theme.text-secondary;
                    font-size: 11px;
                    wrap: word-wrap;
                    height: self.preferred-height;
                }

                Flickable {
                    vertical-stretch: 1;
                    viewport-height: plugin-list.preferred-height;

                    plugin-list := VerticalLayout {
                        spacing: 6px;

                        if root.rows.length == 0: Text {
                            text: @tr("No plugins are installed.");
                            color: Theme.text-secondary;
                            font-size: 12px;
                        }

                        for row in root.rows: Rectangle {
                            height: row-layout.preferred-height + 16px;
                            border-radius: 6px;
                            background: Theme.background;
                            border-width: 1px;
                            border-color: row.status-level >= 2 ? Theme.danger.with-alpha(0.5) : Theme.border-subtle;

                            row-layout := HorizontalLayout {
                                x: 10px;
                                y: 8px;
                                width: parent.width - 20px;
                                // Inside the card's 8px padding (at the card's
                                // full height, its last line ran past the edge).
                                height: parent.height - 16px;
                                spacing: 10px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: row.name;
                                            color: Theme.text-primary;
                                            font-size: 13px;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: row.api-version != "" ? @tr("{}  (plugin API {})", row.version, row.api-version) : row.version;
                                            color: Theme.text-secondary;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    // Wrapped text in `if`/`for` needs its height
                                    // set (Slint 1.17).
                                    if row.description != "": Text {
                                        text: row.description;
                                        color: Theme.text-secondary;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }

                                    Text {
                                        text: row.update != "" ? @tr("{} · version {} is available", row.status, row.update) : row.status;
                                        color: row.status-level == 0 ? Theme.success : row.status-level == 1 ? Theme.text-secondary : Theme.danger;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }

                                    if row.detail != "": Text {
                                        text: row.detail;
                                        color: Theme.warning;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }

                                    Text {
                                        text: row.id + (row.origin != "" ? " · " + row.origin : "") + (row.source != "" ? " · " + row.source : "");
                                        color: Theme.text-secondary;
                                        font-size: 10px;
                                        wrap: word-wrap;
                                        height: self.preferred-height;
                                    }
                                }

                                VerticalLayout {
                                    alignment: start;
                                    spacing: 6px;

                                    if row.update != "": Rectangle {
                                        width: update-text.preferred-width + 18px;
                                        height: 26px;
                                        border-radius: 4px;
                                        background: update-touch.has-hover ? Theme.accent-hover : Theme.accent;
                                        accessible-role: button;
                                        accessible-label: @tr("Update {}", row.name);
                                        accessible-description: row.update;
                                        accessible-action-default => {
                                            root.update-requested(row.id);
                                        }

                                        update-text := Text {
                                            text: @tr("Update");
                                            accessible-role: none;
                                            color: Theme.text-on-accent;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        update-touch := TouchArea {
                                            clicked => {
                                                root.update-requested(row.id);
                                            }
                                        }
                                    }

                                    if row.can-enable || row.can-disable: Rectangle {
                                        width: toggle-text.preferred-width + 18px;
                                        height: 26px;
                                        border-radius: 4px;
                                        background: toggle-touch.has-hover ? Theme.surface-hover : Theme.surface;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        accessible-role: button;
                                        accessible-label: row.can-disable ? @tr("Disable {}", row.name) : @tr("Enable {}", row.name);
                                        accessible-action-default => {
                                            root.enable-requested(row.id, !row.can-disable);
                                        }

                                        toggle-text := Text {
                                            text: row.can-disable ? @tr("Disable") : @tr("Enable");
                                            accessible-role: none;
                                            color: Theme.text-primary;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        toggle-touch := TouchArea {
                                            clicked => {
                                                root.enable-requested(row.id, !row.can-disable);
                                            }
                                        }
                                    }

                                    if row.can-remove: Rectangle {
                                        width: remove-text.preferred-width + 18px;
                                        height: 26px;
                                        border-radius: 4px;
                                        background: remove-touch.has-hover ? Theme.surface-hover : Theme.surface;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        accessible-role: button;
                                        accessible-label: @tr("Remove {}", row.name);
                                        accessible-action-default => {
                                            root.remove-requested(row.id);
                                        }

                                        remove-text := Text {
                                            text: @tr("Remove");
                                            accessible-role: none;
                                            color: Theme.danger;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        remove-touch := TouchArea {
                                            clicked => {
                                                root.remove-requested(row.id);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
