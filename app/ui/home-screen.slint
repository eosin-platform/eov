import { Theme } from "theme.slint";
import { RecentFileData } from "types.slint";

/// About this eov, set by the host.
export global AppInfo {
    in property <string> version: "";
    callback check-for-updates();
}

export component HomeScreen inherits Rectangle {
    in property <[RecentFileData]> recent-files: [];
    callback open-file-requested();
    callback open-recent-file(string);

    background: Theme.background;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 300px;
        height: recent-files.length > 0 ? 480px : 300px;

        VerticalLayout {
            alignment: center;
            spacing: 0px;

            Text {
                text: "🔬";
                font-size: 48px;
                horizontal-alignment: center;
                accessible-role: none;
            }

            Rectangle {
                height: 16px;
            }

            Text {
                text: "Whole Slide Image Viewer";
                color: Theme.text-secondary;
                font-size: 14px;
                horizontal-alignment: center;
            }

            Rectangle {
                height: 32px;
            }

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 160px;
                    height: 40px;
                    background: open-touch.has-hover ? Theme.accent-hover : Theme.accent;
                    border-radius: 6px;
                    accessible-role: button;
                    accessible-label: "Open File";
                    accessible-action-default => {
                        root.open-file-requested();
                    }

                    open-touch := TouchArea {
                        clicked => {
                            root.open-file-requested();
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;

                        Rectangle {
                            width: 18px;

                            Image {
                                x: 0;
                                y: (parent.height - self.height) / 2;
                                width: parent.width;
                                height: 18px;
                                source: @image-url("icons/open-file.svg");
                                image-fit: contain;
                                accessible-role: none;
                            }
                        }

                        Text {
                            text: "Open File";
                            color: Theme.text-on-accent;
                            font-size: 14px;
                            font-weight: 500;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                }
            }

            Rectangle {
                height: 16px;
            }

            Text {
                text: "or drag and drop WSI files or folders";
                color: Theme.text-secondary;
                font-size: 12px;
                horizontal-alignment: center;
            }

            if recent-files.length > 0: Rectangle {
                height: 180px;

                VerticalLayout {
                    padding-top: 32px;
                    spacing: 8px;

                    Text {
                        text: "Recently Opened";
                        color: Theme.text-primary;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        height: 8px;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 0px;

                        // Left divider bar
                        Rectangle {
                            width: 1px;
                            vertical-stretch: 1;
                            background: Theme.border;
                        }

                        VerticalLayout {
                            spacing: 0px;

                            for file[i] in recent-files: Rectangle {
                                height: 28px;
                                background: file-touch.has-hover ? Theme.surface-hover : transparent;
                                border-radius: 4px;
                                accessible-role: button;
                                accessible-label: file.name;
                                accessible-description: file.path;
                                accessible-action-default => {
                                    root.open-recent-file(file.path);
                                }

                                file-touch := TouchArea {
                                    clicked => {
                                        root.open-recent-file(file.path);
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: start;
                                    spacing: 8px;

                                    Text {
                                        text: "📄";
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        accessible-role: none;
                                    }

                                    Text {
                                        text: file.name;
                                        color: file-touch.has-hover ? Theme.accent : Theme.text-primary;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        accessible-role: none;
                                    }
                                }
                            }
                        }

                        // Right divider bar
                        Rectangle {
                            width: 1px;
                            vertical-stretch: 1;
                            background: Theme.border;
                        }
                    }
                }
            }

            Rectangle {
                height: 24px;
            }
        }
    }

    // Intended use (AUDIT §14.6), the version and Check for Updates.
    VerticalLayout {
        x: 16px;
        y: parent.height - self.height - 12px;
        width: parent.width - 32px;
        height: self.preferred-height;
        spacing: 4px;

        Text {
            text: "For research and education. Not a medical device; not for primary diagnosis.";
            color: Theme.text-secondary;
            font-size: 10px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 6px;

            Text {
                text: "eov " + AppInfo.version;
                color: Theme.text-secondary;
                font-size: 10px;
            }

            Text {
                text: "·";
                color: Theme.text-secondary;
                font-size: 10px;
                accessible-role: none;
            }

            Text {
                text: "Check for Updates…";
                color: update-touch.has-hover ? Theme.text-primary : Theme.link;
                font-size: 10px;
                accessible-role: button;
                accessible-label: "Check for eov updates";
                accessible-action-default => {
                    AppInfo.check-for-updates();
                }

                update-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AppInfo.check-for-updates();
                    }
                }
            }
        }
    }
}
