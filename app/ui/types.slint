// EOV WSI Viewer - shared Slint data types

export struct PluginButtonData {
    plugin-id: string,
    button-id: string,
    tooltip: string,
    icon: image,
    active: bool,
    enabled: bool,
    // Tools are mutually exclusive with the host tools.
    is-tool: bool,
    show-left-separator: bool,
}

export struct ContextMenuItem {
    id: string,
    label: string,
    icon: string,
    shortcut: string,
    enabled: bool,
    separator-after: bool,
}

export struct HudToolbarButtonData {
    plugin-id: string,
    button-id: string,
    tooltip: string,
    icon: image,
    active: bool,
    // When non-empty the button opens this menu; the chosen item id is
    // reported with the click.
    menu: [ContextMenuItem],
}

export struct TabData {
    id: int,
    title: string,
    path: string,
    is-modified: bool,
    is-active: bool,
    is-focused: bool,
    is-home: bool,
}

// One slide property (key and value as stored in the file).
export struct PropertyRow {
    key: string,
    value: string,
}

// One line of the Measurements panel (the region of interest has id "roi").
export struct MeasurementRow {
    id: string,
    kind: string,
    value: string,
}

// One line of the Keyboard Shortcuts panel: a section heading, or an
// action with its keys.
export struct ShortcutRow {
    heading: bool,
    label: string,
    // The action's name in config.toml's [shortcuts] ("" for plugin keys).
    id: string,
    keys: string,
}

// The keys of host actions that menus and tooltips mention (from the
// shortcut table, so they follow the user's changes; "" when unbound).
export struct ShortcutLabels {
    undo: string,
    redo: string,
    navigate: string,
    roi: string,
    measure: string,
    close-tab: string,
    slide-info: string,
}

export struct RecentFileData {
    path: string,
    name: string,
}

export enum BottomPanelKind {
    none,
    series,
}

export struct SeriesItemData {
    path: string,
    name: string,
    series-label: string,
    objective-label: string,
    stain-label: string,
    is-directory: bool,
    metadata-tooltip: string,
    thumbnail: image,
    has-thumbnail: bool,
    is-loading: bool,
    is-selected: bool,
}

export struct TileInfo {
    x: int,
    y: int,
    width: int,
    height: int,
    level: int,
}

export struct MinimapRect {
    x: float,
    y: float,
    width: float,
    height: float,
}

export struct ViewportInfo {
    center-x: float,
    center-y: float,
    zoom: float,
    image-width: float,
    image-height: float,
    level: int,
    // Clockwise rotation of the view in degrees (0, 90, 180, 270), then a
    // left-right mirror when `flipped`.
    rotation: int,
    flipped: bool,
}

/// A text label drawn over the viewport (anchors: 0 = top-left at (x, y),
/// 1 = centred above (x, y), 2 = left-middle at (x, y)).
export struct OverlayLabel {
    x: float,
    y: float,
    anchor: int,
    text: string,
    color: color,
    backdrop: bool,
    font-size: float,
}

export enum PaneCursor {
    default,
    crosshair,
    pointer,
    move,
    grabbing,
    text,
    not-allowed,
}

/// One entry of the notification list (levels: 0 info, 1 success,
/// 2 warning, 3 error).
export struct NotificationData {
    level: int,
    message: string,
    detail: string,
    source: string,
    time: string,
}

/// A background job shown in the status bar.
export struct JobData {
    id: string,
    title: string,
    message: string,
    fraction: float,
    indeterminate: bool,
    cancellable: bool,
}

/// A row of the Plugins panel (status levels: 0 active, 1 disabled,
/// 2 failed, 3 stopped).
export struct PluginRowData {
    id: string,
    name: string,
    version: string,
    description: string,
    status: string,
    status-level: int,
    api-version: string,
    source: string,
    // Where the package came from: official, github (owner/repo), local, …
    origin: string,
    // Why it needs attention (changed since installed, incompatible, …).
    detail: string,
    // A newer version found by Check for Updates ("" if none).
    update: string,
    can-enable: bool,
    can-disable: bool,
    can-remove: bool,
}

export struct MetadataItem {
    label: string,
    value: string,
}

export enum MeasurementUnit {
    um,
    mm,
    inches,
}

export enum StainNormalization {
    none,
    macenko,
    vahadane,
}

/// Which stain channel is currently being viewed in grayscale isolation.
/// none = normal blended mode, hematoxylin or eosin = isolated grayscale view.
export enum IsolatedChannel {
    none,
    hematoxylin,
    eosin,
}

export struct HudSettings {
    show-hud-toolbar: bool,
    hud-dropdown-open: bool,
    sharpness: float,
    gamma: float,
    brightness: float,
    contrast: float,
    measurement-unit: MeasurementUnit,
    stain-normalization: StainNormalization,
    mpp-x: float,
    mpp-y: float,
    // Color deconvolution state
    deconv-hematoxylin-intensity: float,
    deconv-hematoxylin-visible: bool,
    deconv-eosin-intensity: float,
    deconv-eosin-visible: bool,
    deconv-isolated-channel: IsolatedChannel,
    // Colour processing (CLR-9): whether anything alters the colours, the
    // persistent badge describing it, and colour warnings (one per line).
    modified: bool,
    color-badge: string,
    color-warning: string,
    // On-screen scale bar (UI-6): length in logical pixels (0 = none) and
    // its exact label.
    scale-bar-width: float,
    scale-bar-label: string,
    // Plugin badges for this pane's slide, one per line.
    plugin-badges: string,
}

export struct PaneViewData {
    id: int,
    // Stable identity of the pane (survives reordering).
    uid: int,
    tabs: [TabData],
    content: image,
    viewport-info: ViewportInfo,
    zoom-display-text: string,
    zoom-input-text: string,
    zoom-tooltip: string,
    minimap-thumbnail: image,
    minimap-rect: MinimapRect,
    metadata-items: [MetadataItem],
    is-home-tab: bool,
    zoom-slider-position: float,
    // Host and plugin overlay layers, rendered off the UI thread and placed
    // at (overlay-x, overlay-y) with the given size (reprojected while the
    // view moves).
    overlay: image,
    overlay-x: float,
    overlay-y: float,
    overlay-width: float,
    overlay-height: float,
    overlay-labels: [OverlayLabel],
    cursor: PaneCursor,
    hud-buttons: [HudToolbarButtonData],
    is-loading: bool,
    hud: HudSettings,
}

export enum ToolType {
    navigate,
    region-of-interest,
    measure,
    // A plugin tool; its toolbar button shows which one.
    plugin,
}

export enum RenderMode {
    cpu,
    gpu,
}

export enum FilteringMode {
    bilinear,
    trilinear,
    lanczos3,
}

export enum ExportFilteringMode {
    bilinear,
    trilinear,
    lanczos,
}

export enum ExportFormat {
    jpeg,
    png,
    tiff,
}

export enum StrokeStyle {
    solid,
    dashed,
    dotted,
}

export enum CapStyle {
    round,
    square,
    flat,
}

export struct ExportSettings {
    dpi: int,
    filtering-mode: ExportFilteringMode,
    sharpness: float,
    gamma: float,
    brightness: float,
    contrast: float,
    stain-normalization: StainNormalization,
    // Measurement overlay
    show-measurement: bool,
    has-measurement: bool,
    measurement-color: color,
    measurement-opacity: float,
    measurement-thickness: float,
    measurement-stroke-style: StrokeStyle,
    measurement-cap-style: CapStyle,
    measurement-dash-length: float,
    measurement-dash-gap: float,
    measurement-dot-spacing: float,
    measurement-font-size: float,
    // ROI overlay
    show-roi-outline: bool,
    has-roi: bool,
    roi-color: color,
    roi-opacity: float,
    roi-thickness: float,
    roi-stroke-style: StrokeStyle,
    roi-cap-style: CapStyle,
    roi-dash-length: float,
    roi-dash-gap: float,
    roi-dot-spacing: float,
    // ROI outside overlay
    roi-outside-overlay: bool,
    roi-outside-color: color,
    roi-outside-opacity: float,
    // Color Deconvolution
    deconv-hematoxylin-intensity: float,
    deconv-hematoxylin-visible: bool,
    deconv-eosin-intensity: float,
    deconv-eosin-visible: bool,
    deconv-isolated-channel: IsolatedChannel,
    // Figure
    show-scale-bar: bool,
    show-processing-note: bool,
    // Format
    format: ExportFormat,
    jpeg-quality: int,
}

export struct ExportPreviewInfo {
    preview-image: image,
    estimated-size-mb: float,
    width-px: int,
    height-px: int,
    viewport-width: float,
    viewport-height: float,
    // What the export will contain that the user should know (colour
    // processing, missing calibration); empty when nothing to say.
    note: string,
    // A preview is being rendered.
    rendering: bool,
}

export struct DatasetExportSettings {
    inputs: [string],
    output-dir: string,
    tile-size: int,
    stride: int,
    threads: int,
    // 0 disables the white filter.
    white-threshold: float,
    // Keep only patches that are mostly tissue (Otsu mask).
    tissue-only: bool,
    // Why the run cannot start, shown in the dialog.
    error: string,
}