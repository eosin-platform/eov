import { Theme } from "theme.slint";
import {
    HudToolbarButtonData,
    HudSettings,
    MeasurementUnit,
    MetadataItem,
    MinimapRect,
    OverlayLabel,
    PaneCursor,
    StainNormalization,
    ViewportInfo,
} from "types.slint";
import { Minimap, ZoomSlider } from "minimap.slint";
import { MetadataHud } from "metadata-hud.slint";
import { ScaleBar } from "scale-bar.slint";
import { HudToolbar } from "hud-toolbar.slint";
import { HudSettingsPanel } from "hud-settings.slint";

export { Minimap, ZoomSlider, MetadataHud, ScaleBar, HudToolbar, HudSettingsPanel }

export component Viewport inherits Rectangle {
    in property <image> content;
    in property <ViewportInfo> viewport-info;
    in property <string> zoom-display-text: "100%";
    in property <string> zoom-input-text: "100";
    in property <string> zoom-tooltip: "100% = 1 image pixel per display pixel";
    in property <image> minimap-thumbnail;
    in property <MinimapRect> minimap-rect;
    in property <bool> show-minimap: true;
    in property <[MetadataItem]> metadata-items: [];
    in property <bool> show-metadata: false;
    in property <bool> show-scale-bar: true;
    in property <string> status-text: "";
    in property <bool> is-loading: false;
    in property <bool> debug-mode: false;
    in property <float> fps: 0;
    in property <float> zoom-slider-position: 0.5;
    // Host and plugin overlays: one image rendered off the UI thread for the
    // view at the time, placed (and scaled while the view moves) here.
    in property <image> overlay;
    in property <float> overlay-x: 0;
    in property <float> overlay-y: 0;
    in property <float> overlay-width: 0;
    in property <float> overlay-height: 0;
    in property <[OverlayLabel]> overlay-labels: [];
    in property <PaneCursor> cursor: PaneCursor.default;
    in property <HudSettings> hud;
    in property <[HudToolbarButtonData]> plugin-hud-buttons: [];
    in property <int> pane-id: 0;
    property <bool> hud-plugin-menu-open: false;

    callback fit-to-view();
    callback minimap-navigate(float, float);
    callback minimap-drag-start();
    callback minimap-drag-end();
    callback zoom-slider-changed(float);
    callback file-dropped(string);
    callback interaction-started();
    // Raw input, interpreted by the host's interaction controller.
    // kind: 0 down, 1 up, 2 move, 3 leave; button: 0 none, 1 left, 2 right, 3 middle.
    callback pointer-input(/* kind */ int, /* button */ int, /* x */ float, /* y */ float, /* window x */ float, /* window y */ float, /* shift */ bool, /* control */ bool, /* alt */ bool, /* meta */ bool);
    callback wheel-input(/* dx */ float, /* dy */ float, /* x */ float, /* y */ float, /* shift */ bool, /* control */ bool, /* alt */ bool, /* meta */ bool);
    callback pinch-input(/* cumulative scale */ float, /* x */ float, /* y */ float, /* active */ bool);
    callback key-input(/* text */ string, /* shift */ bool, /* control */ bool, /* alt */ bool, /* meta */ bool, /* pressed */ bool, /* repeat */ bool) -> bool;
    callback hud-toggle-dropdown();
    callback hud-sharpness-changed(float);
    callback hud-gamma-changed(float);
    callback hud-brightness-changed(float);
    callback hud-contrast-changed(float);
    callback hud-measurement-unit-changed(MeasurementUnit);
    callback hud-stain-normalization-changed(StainNormalization);
    callback hud-reset-adjustments();
    callback hud-zoom-input(string);
    callback hud-zoom-in();
    callback hud-zoom-out();
    callback hud-deconv-h-intensity-changed(float);
    callback hud-deconv-e-intensity-changed(float);
    callback hud-deconv-h-visibility-toggled();
    callback hud-deconv-e-visibility-toggled();
    callback hud-deconv-h-view-toggled();
    callback hud-deconv-e-view-toggled();
    callback hud-plugin-button-clicked(/* plugin */ string, /* button */ string, /* menu item */ string);

    out property <length> viewport-width: self.width;
    out property <length> viewport-height: self.height;
    property <length> metadata-hud-height: show-metadata && metadata-items.length > 0 ? 52px + metadata-items.length * 22px : 0px;
    private property <float> mouse-wheel-zoom-factor: 1.3225;

    background: Theme.viewport-bg;

    Rectangle {
        clip: true;
        width: parent.width;
        height: parent.height;

        Image {
            width: 100%;
            height: 100%;
            source: content;
            image-fit: fill;
        }

        Image {
            x: root.overlay-x * 1px;
            y: root.overlay-y * 1px;
            width: root.overlay-width * 1px;
            height: root.overlay-height * 1px;
            source: root.overlay;
            image-fit: fill;
        }

        for label in root.overlay-labels: Rectangle {
            property <length> box-width: label-text.preferred-width + (label.backdrop ? 14px : 0px);
            property <length> box-height: label-text.preferred-height + (label.backdrop ? 6px : 0px);
            x: label.anchor == 1 ? label.x * 1px - self.box-width / 2 : label.x * 1px;
            y: label.anchor == 1 ? label.y * 1px - self.box-height : label.anchor == 2 ? label.y * 1px - self.box-height / 2 : label.y * 1px;
            width: self.box-width;
            height: self.box-height;
            border-radius: label.backdrop ? self.height / 2 : 0px;
            background: label.backdrop ? #1a1a1aee : transparent;
            border-width: label.backdrop ? 1px : 0px;
            border-color: label.backdrop ? label.color.with-alpha(0.5) : transparent;
            drop-shadow-blur: label.backdrop ? 4px : 0px;
            drop-shadow-color: #00000066;

            label-text := Text {
                x: label.backdrop ? 7px : 0px;
                y: label.backdrop ? 3px : 0px;
                text: label.text;
                color: label.backdrop ? white : label.color;
                font-size: label.font-size * 1px;
                font-weight: 500;
            }
        }

        if is-loading: Rectangle {
            x: parent.width / 2 - 40px;
            y: parent.height / 2 - 40px;
            width: 80px;
            height: 80px;
            background: Theme.surface;
            border-radius: 8px;

            Text {
                text: "Loading...";
                color: Theme.text-primary;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    gesture := ScaleRotateGestureHandler {
        width: 100%;
        height: 100%;

        updated => {
            root.pinch-input(self.scale, self.center.x / 1px, self.center.y / 1px, true);
        }
        ended => {
            root.pinch-input(1.0, 0, 0, false);
        }
        cancelled => {
            root.pinch-input(1.0, 0, 0, false);
        }

        touch := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: root.cursor == PaneCursor.crosshair ? MouseCursor.crosshair
                : root.cursor == PaneCursor.pointer ? MouseCursor.pointer
                : root.cursor == PaneCursor.move ? MouseCursor.move
                : root.cursor == PaneCursor.grabbing ? MouseCursor.grabbing
                : root.cursor == PaneCursor.text ? MouseCursor.text
                : root.cursor == PaneCursor.not-allowed ? MouseCursor.not-allowed
                : MouseCursor.default;

            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.interaction-started();
                    root.hud-plugin-menu-open = false;
                    focus-scope.focus();
                }
                root.pointer-input(
                    e.kind == PointerEventKind.down ? 0 : e.kind == PointerEventKind.up ? 1 : e.kind == PointerEventKind.cancel ? 3 : 2,
                    e.button == PointerEventButton.left ? 1 : e.button == PointerEventButton.right ? 2 : e.button == PointerEventButton.middle ? 3 : 0,
                    self.mouse-x / 1px,
                    self.mouse-y / 1px,
                    (self.absolute-position.x + self.mouse-x) / 1px,
                    (self.absolute-position.y + self.mouse-y) / 1px,
                    e.modifiers.shift,
                    e.modifiers.control,
                    e.modifiers.alt,
                    e.modifiers.meta);
            }

            changed has-hover => {
                if !self.has-hover {
                    root.pointer-input(3, 0, 0, 0, 0, 0, false, false, false, false);
                }
            }

            scroll-event(e) => {
                root.wheel-input(e.delta-x / 1px, e.delta-y / 1px, self.mouse-x / 1px, self.mouse-y / 1px,
                    e.modifiers.shift, e.modifiers.control, e.modifiers.alt, e.modifiers.meta);
                accept
            }
        }
    }

    if show-minimap: Minimap {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        thumbnail: minimap-thumbnail;
        viewport-rect: minimap-rect;
        image-width: viewport-info.image-width;
        image-height: viewport-info.image-height;
        navigate(nx, ny) => {
            root.minimap-navigate(nx, ny);
        }
        drag-start => {
            root.minimap-drag-start();
        }
        drag-end => {
            root.minimap-drag-end();
        }
    }

    if show-minimap: ZoomSlider {
        x: parent.width - 16px - 150px - self.width - 8px;
        y: parent.height - self.height - 16px;
        value: root.zoom-slider-position;
        zoom-level: root.viewport-info.zoom;
        value-changed(value) => {
            root.zoom-slider-changed(value);
        }
    }

    if show-metadata && metadata-items.length > 0: MetadataHud {
        x: parent.width - self.width - 16px;
        y: 16px;
        items: root.metadata-items;
    }

    if debug-mode: Rectangle {
        x: parent.width - self.width - 8px;
        y: root.metadata-hud-height > 0px ? root.metadata-hud-height + 24px : 8px;
        width: 70px;
        height: 24px;
        background: #000000aa;
        border-radius: 4px;

        Text {
            x: 8px;
            y: 4px;
            text: Math.round(fps) + " FPS";
            color: fps >= 25 ? #00ff00 : fps >= 15 ? #ffff00 : #ff0000;
            font-size: 12px;
            font-weight: 600;
        }
    }

    // HUD toolbar (top-left)
    if root.hud.show-hud-toolbar: hud_toolbar := HudToolbar {
        x: 16px;
        y: 16px;
        pane-id: root.pane-id;
        plugin-menu-open <=> root.hud-plugin-menu-open;
        zoom-level: root.viewport-info.zoom;
        zoom-display-text: root.zoom-display-text;
        zoom-input-text: root.zoom-input-text;
        zoom-tooltip: root.zoom-tooltip;
        dropdown-open: root.hud.hud-dropdown-open;
        // Every colour-altering setting, stain normalisation and
        // deconvolution included (CLR-9).
        has-adjustments: root.hud.modified;
        plugin-buttons: root.plugin-hud-buttons;
        fit-to-view => {
            root.fit-to-view();
        }
        toggle-dropdown => {
            root.hud-toggle-dropdown();
        }
        zoom-input(v) => {
            root.hud-zoom-input(v);
        }
        zoom-in => {
            root.hud-zoom-in();
        }
        zoom-out => {
            root.hud-zoom-out();
        }
        plugin-button-clicked(plugin-id, button-id, item-id) => {
            root.hud-plugin-button-clicked(plugin-id, button-id, item-id);
        }
    }

    // HUD settings dropdown (below toolbar)
    if root.hud.show-hud-toolbar && root.hud.hud-dropdown-open: HudSettingsPanel {
        x: 16px;
        y: 60px;
        sharpness: root.hud.sharpness;
        gamma: root.hud.gamma;
        brightness: root.hud.brightness;
        contrast: root.hud.contrast;
        measurement-unit: root.hud.measurement-unit;
        stain-normalization: root.hud.stain-normalization;
        has-adjustments: root.hud.modified;
        sharpness-changed(v) => {
            root.hud-sharpness-changed(v);
        }
        gamma-changed(v) => {
            root.hud-gamma-changed(v);
        }
        brightness-changed(v) => {
            root.hud-brightness-changed(v);
        }
        contrast-changed(v) => {
            root.hud-contrast-changed(v);
        }
        measurement-unit-changed(u) => {
            root.hud-measurement-unit-changed(u);
        }
        stain-normalization-changed(s) => {
            root.hud-stain-normalization-changed(s);
        }
        reset-adjustments => {
            root.hud-reset-adjustments();
        }
        deconv-hematoxylin-intensity: root.hud.deconv-hematoxylin-intensity;
        deconv-hematoxylin-visible: root.hud.deconv-hematoxylin-visible;
        deconv-eosin-intensity: root.hud.deconv-eosin-intensity;
        deconv-eosin-visible: root.hud.deconv-eosin-visible;
        deconv-isolated-channel: root.hud.deconv-isolated-channel;
        deconv-h-intensity-changed(v) => {
            root.hud-deconv-h-intensity-changed(v);
        }
        deconv-e-intensity-changed(v) => {
            root.hud-deconv-e-intensity-changed(v);
        }
        deconv-h-visibility-toggled => {
            root.hud-deconv-h-visibility-toggled();
        }
        deconv-e-visibility-toggled => {
            root.hud-deconv-e-visibility-toggled();
        }
        deconv-h-view-toggled => {
            root.hud-deconv-h-view-toggled();
        }
        deconv-e-view-toggled => {
            root.hud-deconv-e-view-toggled();
        }
    }

    // Colour badge (bottom-left, above the scale bar): shown whenever the
    // colours are not as scanned, so a processed view is never mistaken for
    // the original (CLR-9), with any colour warnings below it.
    if root.hud.color-badge != "" || root.hud.color-warning != "": Rectangle {
        property <bool> both: root.hud.color-badge != "" && root.hud.color-warning != "";
        property <length> text-width: min(400px, root.width - 48px, max(badge-text.preferred-width, warning-text.preferred-width));
        x: 16px;
        y: root.height - self.height - (root.show-scale-bar ? 56px : 16px);
        width: self.text-width + 16px;
        height: badge-text.height + warning-text.height + (self.both ? 2px : 0px) + 8px;
        background: #000000b8;
        border-radius: 5px;

        badge-text := Text {
            x: 8px;
            y: 4px;
            width: parent.text-width;
            height: root.hud.color-badge != "" ? self.preferred-height : 0px;
            text: root.hud.color-badge;
            color: white;
            font-size: 12px;
            font-weight: 600;
            wrap: word-wrap;
        }

        warning-text := Text {
            x: 8px;
            y: badge-text.y + badge-text.height + (parent.both ? 2px : 0px);
            width: parent.text-width;
            height: root.hud.color-warning != "" ? self.preferred-height : 0px;
            text: root.hud.color-warning;
            color: #f5c26b;
            font-size: 11px;
            wrap: word-wrap;
        }
    }

    // Scale bar (bottom-left)
    if root.show-scale-bar: ScaleBar {
        x: 16px;
        y: parent.height - self.height - 16px;
        zoom: root.viewport-info.zoom;
        mpp-x: root.hud.mpp-x;
        mpp-y: root.hud.mpp-y;
        unit: root.hud.measurement-unit;
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(e) => {
            if root.key-input(e.text, e.modifiers.shift, e.modifiers.control, e.modifiers.alt, e.modifiers.meta, true, e.repeat) {
                accept
            }
            reject
        }
        key-released(e) => {
            if root.key-input(e.text, e.modifiers.shift, e.modifiers.control, e.modifiers.alt, e.modifiers.meta, false, false) {
                accept
            }
            reject
        }
    }
}
