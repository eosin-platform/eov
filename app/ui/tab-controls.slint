import { Theme } from "theme.slint";
import { ContextMenuItem, TabData } from "types.slint";

export component ToolButton inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip-text;
    in property <bool> is-active: false;
    in property <bool> enabled: true;
    /// A toggle (or one of a set of choices): assistive technology is told
    /// whether it is on (`is-active`).
    in property <bool> checkable: false;
    out property <bool> hovered: touch.has-hover;
    callback clicked();

    width: 32px;
    height: 28px;
    border-radius: 3px;
    background: is-active ? Theme.accent : (touch.has-hover && enabled ? Theme.surface-hover : transparent);
    border-width: is-active ? 0px : 0px;
    accessible-role: button;
    accessible-label: root.tooltip-text != "" ? root.tooltip-text : root.icon;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.is-active;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        alignment: center;
        Text {
            text: root.icon;
            color: is-active ? Theme.text-on-accent : (root.enabled ? Theme.text-primary : Theme.text-secondary);
            font-size: 14px;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

export component SvgToolButton inherits Rectangle {
    in property <image> icon-source;
    in property <string> tooltip-text;
    in property <bool> is-active: false;
    in property <bool> enabled: true;
    /// A toggle (or one of a set of choices): assistive technology is told
    /// whether it is on (`is-active`).
    in property <bool> checkable: false;
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    // Right click, with the window position of the pointer.
    callback secondary-clicked(length, length);

    width: 32px;
    height: 28px;
    border-radius: 3px;
    background: is-active ? Theme.accent : (touch.has-hover && enabled ? Theme.surface-hover : transparent);
    accessible-role: button;
    accessible-label: root.tooltip-text;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.is-active;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.secondary-clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 17px;
        height: 17px;
        source: root.icon-source;
        image-fit: contain;
        colorize: is-active ? Theme.text-on-accent : (root.enabled ? Theme.text-primary : Theme.text-secondary);
        accessible-role: none;
    }
}

