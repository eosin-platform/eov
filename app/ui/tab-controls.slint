    in property <string> text;
    in property <string> tooltip-text: "";
    in property <bool> enabled: true;
    in property <length> text-offset-y: 0px;
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    callback secondary-clicked(length, length);

    width: 32px;
    height: 28px;
    border-radius: 3px;
    background: touch.has-hover && enabled ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.tooltip-text != "" ? root.tooltip-text : root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }

        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.secondary-clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    Text {
        y: root.text-offset-y;
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.enabled ? Theme.text-primary : Theme.text-secondary;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

component Tab inherits Rectangle {
    in property <TabData> data;
    in property <int> pane-id: 0;
    in property <bool> is-dragging: false;
    callback close-requested(int);
    callback activated(int);
    callback context-menu(int, length, length);
    callback drag-started(int, int, string, length, length);
    callback drag-moved(length, length);
    callback drag-ended(length, length);
    callback tab-tooltip-changed(bool, string, length, length);

    callback horizontal-scroll(length);
    min-width: 100px;
    max-width: 200px;
    height: 35px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    background: is-dragging ? Theme.accent : (data.is-active ? Theme.tab-active : Theme.tab-inactive);
    border-width: 0px;
    border-color: transparent;
    opacity: is-dragging ? 0.35 : 1.0;
    accessible-role: tab;
    accessible-label: root.data.is-modified ? @tr("{} (modified)", root.data.title) : root.data.title;
    accessible-description: root.data.path;
    accessible-item-selectable: true;
    accessible-item-selected: root.data.is-active;
    accessible-action-default => {
        root.activated(root.data.id);
    }

    if data.is-focused: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 2px;
        background: Theme.accent;
        border-top-left-radius: 4px;
        border-top-right-radius: 4px;
    }

    states [
        hovered when touch.has-hover && !data.is-active: {
            background: Theme.surface-hover;
        }
    ]

    touch := TouchArea {
        property <length> press-x;
        property <length> press-y;
        property <bool> drag-armed: false;
        property <bool> lmb-down: false;

        scroll-event(e) => {
            root.horizontal-scroll(e.delta-y);
            accept
        }

        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
                self.drag-armed = false;
                self.lmb-down = true;
            }
            if e.kind == PointerEventKind.move && self.lmb-down {
                if !self.drag-armed {
                    let dx = self.mouse-x - self.press-x;
                    let dy = self.mouse-y - self.press-y;
                    if abs(dx) > 6px || abs(dy) > 6px {
                        self.drag-armed = true;
                        root.drag-started(data.id, root.pane-id, data.title, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
                if self.drag-armed {
                    root.drag-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                if self.drag-armed {
                    root.drag-ended(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                } else if self.lmb-down {
                    root.activated(data.id);
                }
                self.drag-armed = false;
                self.lmb-down = false;
            }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.context-menu(
                    data.id,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                );
            }
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.middle {
                root.close-requested(data.id);
            }
        }
    }

    property <bool> hover-active: touch.has-hover && !touch.drag-armed && data.path != "";
    property <float> tooltip-delay-progress: hover-active ? 1.0 : 0.0;
    animate tooltip-delay-progress {
        duration: 1ms;
        delay: 700ms;
    }
    property <bool> show-path-tooltip: tooltip-delay-progress > 0.5 && hover-active;
    changed show-path-tooltip => {
        root.tab-tooltip-changed(
            root.show-path-tooltip,
            data.path,
            touch.absolute-position.x + touch.width / 2,
            touch.absolute-position.y + touch.height + 4px,
        );
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 6px;
        alignment: center;

        if data.is-home: Text {
            text: "🏠";
            font-size: 12px;
            vertical-alignment: center;
            accessible-role: none;
        }

        Text {
            text: data.title + (data.is-modified ? " •" : "");
            color: data.is-active ? Theme.text-primary : Theme.text-secondary;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: none;
        }

        Rectangle {
            width: self.height;
            accessible-role: button;
            accessible-label: @tr("Close {}", data.title);
            accessible-action-default => {
                root.close-requested(data.id);
            }

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 4px;
                background: close-touch.has-hover ? Theme.surface-hover : transparent;
            }

            close-touch := TouchArea {
                scroll-event(e) => {
                    root.horizontal-scroll(e.delta-y);
                    accept
                }

                clicked => {
                    root.close-requested(data.id);
                }
            }

            Text {
                text: "×";
                color: close-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }
}

export component TabBar inherits Rectangle {
    in property <int> pane-id: 0;
    in property <[TabData]> tabs;
    in property <int> dragging-tab-id: -1;
    in property <int> drag-source-pane: -1;
    in property <int> drag-source-index: -1;
    in property <length> drag-abs-x: -1px;
    in property <bool> is-drop-target: false;
    in property <bool> show-drop-indicator: true;
    property <length> estimated-tabs-width: tabs.length * 101px;
    property <length> tabs-content-width: max(1px, tabs-end-marker.x);
    property <length> avg-slot: tabs.length > 0 ? (tabs-content-width + 1px) / tabs.length : 101px;
    property <int> raw-drop-index: !show-drop-indicator || !is-drop-target || drag-abs-x < 0px ? -1 : Math.max(0, Math.min(tabs.length, Math.round((drag-abs-x - abs-tracker.absolute-position.x) / avg-slot)));
    out property <int> computed-drop-index: drag-source-pane == pane-id && drag-source-index >= 0 && (raw-drop-index == drag-source-index || raw-drop-index == drag-source-index + 1) ? -1 : raw-drop-index;
    property <bool> tabs-overflow: estimated-tabs-width + 35px > self.width - 8px;
    property <length> tabs-scroll-x: 0px;
    callback tab-activated(int, int);
    callback tab-close-requested(int, int);
    callback tab-context-menu(int, int, length, length);
    callback new-tab-requested(int);
    callback tab-drag-started(int, int, string, int, length, length);
    callback tab-drag-moved(length, length);
    callback tab-drag-ended(length, length);
    callback tab-tooltip-changed(bool, string, length, length);

    height: 35px;
    background: Theme.surface;
    accessible-role: tab-list;
    accessible-label: @tr("Tabs");

    Rectangle {
        y: 0px;
        width: 100%;
        height: 1px;
        background: Theme.border-subtle;
    }

    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }

    Rectangle {
        x: 4px;
        y: 0px;
        width: root.tabs-overflow ? root.width - 39px : root.width - 4px;
        height: 35px;
        clip: true;

        TouchArea {
            width: parent.width;
            height: parent.height;
            enabled: root.tabs-overflow;

            scroll-event(e) => {
                root.tabs-scroll-x = clamp(
                    root.tabs-scroll-x - e.delta-y,
                    0px,
                    max(0px, root.tabs-content-width - parent.width)
                );
                accept
            }
        }

        abs-tracker := Rectangle {
            x: tabs-inline-layout.x;
            width: 0px;
            height: 0px;
        }

        tabs-inline-layout := HorizontalLayout {
            x: -root.tabs-scroll-x;
            alignment: start;
            spacing: 1px;

            for tab[i] in tabs: Tab {
                pane-id: root.pane-id;
                data: tab;
                is-dragging: root.dragging-tab-id == tab.id;
                horizontal-scroll(delta) => {
                    root.tabs-scroll-x = clamp(
                        root.tabs-scroll-x - delta,
                        0px,
                        max(0px, root.tabs-content-width - (root.tabs-overflow ? root.width - 39px : root.width - 4px))
                    );
                }
                close-requested(id) => {
                    root.tab-close-requested(root.pane-id, id);
                }
                activated(id) => {
                    root.tab-activated(root.pane-id, id);
                }
                context-menu(id, x, y) => {
                    root.tab-context-menu(root.pane-id, id, x, y);
                }
                drag-started(id, pane, title, abs-x, abs-y) => {
                    root.tab-drag-started(id, pane, title, i, abs-x, abs-y);
                }
                drag-moved(abs-x, abs-y) => {
                    root.tab-drag-moved(abs-x, abs-y);
                }
                drag-ended(abs-x, abs-y) => {
                    root.tab-drag-ended(abs-x, abs-y);
                }
                tab-tooltip-changed(visible, text, cx, ty) => {
                    root.tab-tooltip-changed(visible, text, cx, ty);
                }
            }

            if !root.tabs-overflow: Rectangle {
                width: 35px;
                height: 35px;
                background: inline-new-tab-touch.has-hover ? Theme.surface-hover : transparent;
                accessible-role: button;
                accessible-label: @tr("New tab");
                accessible-action-default => {
                    root.new-tab-requested(root.pane-id);
                }

                inline-new-tab-touch := TouchArea {
                    clicked => {
                        root.new-tab-requested(root.pane-id);
                    }
                }

                Text {
                    text: "+";
                    color: inline-new-tab-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
                    font-size: 20px;
                    font-weight: 400;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }

            tabs-end-marker := Rectangle {
                width: 0px;
                height: 0px;
            }
        }

        if root.computed-drop-index >= 0: Rectangle {
            x: root.computed-drop-index * root.avg-slot - 1px - root.tabs-scroll-x;
            y: 4px;
            width: 2px;
            height: 27px;
            border-radius: 1px;
            background: Theme.accent;
        }
    }

    if root.tabs-overflow: Rectangle {
        x: root.width - self.width;
        y: 0px;
        width: 35px;
        height: 35px;
        background: new-tab-touch.has-hover ? Theme.surface-hover : transparent;
        accessible-role: button;
        accessible-label: @tr("New tab");
        accessible-action-default => {
            root.new-tab-requested(root.pane-id);
        }

        new-tab-touch := TouchArea {
            clicked => {
                root.new-tab-requested(root.pane-id);
            }
        }

        Text {
            text: "+";
            color: new-tab-touch.has-hover ? Theme.text-primary : Theme.text-secondary;
            font-size: 20px;
            font-weight: 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

export component ContextMenu inherits Rectangle {
    in property <[ContextMenuItem]> items;
    in property <bool> is-visible: false;
    in property <length> menu-x: 0px;
    in property <length> menu-y: 0px;
    /// Taller menus scroll.
    in property <length> height-limit: 100000px;
    callback item-clicked(string);
    property <length> menu-width: 240px;
    property <length> content-height: items.length * 28px;

    x: menu-x;
    y: menu-y;
    width: root.is-visible ? root.menu-width : 0px;
    height: root.is-visible ? min(root.content-height, root.height-limit) : 0px;
    background: Theme.context-menu-bg;
    border-radius: 4px;
    border-width: Theme.menu-border-width;
    border-color: Theme.border;
    drop-shadow-blur: 8px;
    drop-shadow-color: Theme.shadow;
    opacity: root.is-visible ? 1 : 0;

    if root.is-visible: Rectangle {
        x: -10000px;
        y: -10000px;
        width: 20000px;
        height: 20000px;

        TouchArea {
            clicked => {
                root.item-clicked("dismiss");
            }
        }
    }

    Flickable {
        viewport-height: root.content-height;

        VerticalLayout {
            for item in items: Rectangle {
                height: 28px;
                background: item-touch.has-hover && item.enabled ? Theme.context-menu-hover : transparent;
                // Slint has no menu-item role: items are buttons, the chosen
                // one of a set of choices is "pressed".
                accessible-role: button;
                accessible-label: item.label;
                accessible-description: item.shortcut;
                accessible-enabled: item.enabled;
                accessible-checkable: item.icon == "check";
                accessible-checked: item.icon == "check";
                accessible-action-default => {
                    if item.enabled {
                        root.item-clicked(item.id);
                    }
                }

                if item.separator-after: Rectangle {
                    y: parent.height - 1px;
                    x: 8px;
                    width: parent.width - 16px;
                    height: 1px;
                    background: Theme.border;
                }

                item-touch := TouchArea {
                    enabled: item.enabled;
                    clicked => {
                        root.item-clicked(item.id);
                    }
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;

                    Rectangle {
                        width: 14px;
                        height: parent.height;

                        if item.icon == "check": Text {
                            y: (parent.height - self.height) / 2;
                            text: "✓";
                            color: item.enabled ? Theme.text-primary : Theme.text-secondary;
                            font-size: 12px;
                            accessible-role: none;
                        }

                        // Unknown names (plugins may send any) show no icon.
                        if item.icon == "copy" || item.icon == "export" || item.icon == "point" || item.icon == "delete"
                            || item.icon == "measure" || item.icon == "plugin" || item.icon == "open": Image {
                            x: 0px;
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            source: item.icon == "copy" ? @image-url("icons/copy.svg")
                                : item.icon == "export" ? @image-url("icons/export.svg")
                                : item.icon == "point" ? @image-url("icons/point.svg")
                                : item.icon == "delete" ? @image-url("icons/delete.svg")
                                : item.icon == "measure" ? @image-url("icons/measure.svg")
                                : item.icon == "plugin" ? @image-url("icons/plugin.svg")
                                : @image-url("icons/open-file.svg");
                            image-fit: contain;
                            colorize: item.enabled ? Theme.text-primary : Theme.text-secondary;
                            accessible-role: none;
                        }
                    }

                    Text {
                        text: item.label;
                        color: item.enabled ? Theme.text-primary : Theme.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                        accessible-role: none;
                    }

                    Text {
                        text: item.shortcut;
                        color: Theme.text-secondary;
                        font-size: 11px;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
            }
        }
    }
}
