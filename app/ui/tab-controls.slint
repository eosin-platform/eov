        image-fit: contain;
        colorize: root.enabled ? Theme.text-primary : Theme.text-secondary;
        accessible-role: none;
    }
}

export component MinimapToolButton inherits Rectangle {
    in property <string> tooltip-text;
    in property <bool> is-active: false;
    in property <bool> enabled: true;
    /// A toggle (or one of a set of choices): assistive technology is told
    /// whether it is on (`is-active`).
    in property <bool> checkable: false;
    out property <bool> hovered: touch.has-hover;
    callback clicked();

    width: 32px;
    height: 28px;
    border-radius: 3px;
    background: is-active ? Theme.accent : (touch.has-hover && enabled ? Theme.surface-hover : transparent);

    property <color> icon-color: root.enabled ? (root.is-active ? Theme.text-on-accent : Theme.text-primary) : Theme.text-secondary;
    property <color> viewport-color: root.is-active ? Theme.text-on-accent : Theme.accent;

    accessible-role: button;
    accessible-label: root.tooltip-text;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.is-active;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    Rectangle {
        x: parent.width / 2 - 8px;
        y: parent.height / 2 - 6px;
        width: 16px;
        height: 12px;
        background: transparent;
        border-width: 1px;
        border-color: root.icon-color;
        border-radius: 2px;

        Rectangle {
            x: 5px;
            y: 1px;
            width: 1px;
            height: parent.height - 2px;
            background: root.icon-color;
            opacity: 0.6;
        }

        Rectangle {
            x: 10px;
            y: 1px;
            width: 1px;
            height: parent.height - 2px;
            background: root.icon-color;
            opacity: 0.6;
        }

        Rectangle {
            x: 6px;
            y: 4px;
            width: 5px;
            height: 4px;
            background: transparent;
            border-width: 1px;
            border-color: root.viewport-color;
        }
    }
}

export component OpenFileToolButton inherits Rectangle {
    in property <string> tooltip-text: "";
    in property <bool> enabled: true;
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    callback secondary-clicked(length, length);

    width: 34px;
    height: 28px;
    border-radius: 4px;
    background: touch.has-hover && enabled ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.tooltip-text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }

        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.secondary-clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
