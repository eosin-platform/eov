// The eovae sidebar. Every property is pushed by the plugin (only changed
// values are applied); callbacks that can reject input return the value to
// show.

import { ComboBox, CheckBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct HistogramBin {
    label: string,
    count: int,
    normalized: float,
}

export struct HotRegion {
    id: string,
    label: string,
    score: string,
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> base: #3e444c;
    in property <color> hover: #4a5460;
    callback clicked();

    min-width: 64px;
    height: 28px;
    border-radius: 4px;
    background: root.enabled ? (touch.has-hover ? root.hover : root.base) : #2e3238;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.enabled ? white : #ffffff66;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> summary;
    in property <bool> expanded;
    callback toggled();

    height: 30px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.surface-hover : transparent;

    touch := TouchArea {
        clicked => { root.toggled(); }
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 6px;
        spacing: 8px;

        Text {
            text: root.expanded ? "▾" : "▸";
            color: Theme.text-secondary;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.expanded ? "" : root.summary;
            color: Theme.text-secondary;
            font-size: 11px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component Label inherits Text {
    color: Theme.text-secondary;
    font-size: 11px;
    wrap: word-wrap;
}

component Note inherits Text {
    in property <bool> error: false;
    in property <bool> warning: false;
    color: root.error ? #e57373 : (root.warning ? #e0b050 : Theme.text-secondary);
    font-size: 11px;
    wrap: word-wrap;
}

component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;

    Text {
        min-width: 86px;
        text: root.label;
        color: Theme.text-secondary;
        font-size: 11px;
        vertical-alignment: center;
    }

    @children
}

component RegionRow inherits Rectangle {
    in property <HotRegion> region;
    callback clicked();
    callback hovered(bool);

    height: 40px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.has-hover ? Theme.surface-hover : #ffffff08;

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover); }
    }

    VerticalLayout {
        padding: 5px;
        spacing: 2px;

        Text {
            text: root.region.label;
            color: Theme.text-primary;
            font-size: 11px;
            overflow: elide;
        }

        Text {
            text: root.region.score;
            color: Theme.text-secondary;
            font-size: 10px;
            overflow: elide;
        }
    }
}

export component EovaeSidebar inherits Rectangle {
    // Sections.
    in-out property <bool> model-expanded: true;
    in-out property <bool> analysis-expanded: true;
    in-out property <bool> results-expanded: true;
    in-out property <bool> cache-expanded: false;

    // Model.
    in property <int> model-state: 0;
    in property <string> model-name;
    in property <string> model-detail;
    in property <string> model-message: "No model loaded.";
    in property <bool> model-message-error: false;
    in property <string> engine-label;
    in property <string> engine-note;
    in property <string> runtime-label;
    in property <string> input-text;
    in property <[string]> output-options;
    in-out property <int> output-index: 0;
    in property <string> latent-text;
    in property <[string]> warnings;
    in property <string> contract-source;
    in property <string> contract-summary;
    in property <[string]> scaling-options: ["[-1, 1]", "[0, 1]", "[0, 255]", "ImageNet mean/std"];
    in-out property <int> input-scaling-index: 0;
    in-out property <int> output-scaling-index: 0;
    in-out property <bool> composite-white: true;
    in-out property <bool> black-to-white: true;
    in property <bool> contract-overridden: false;

    // Analysis.
    in property <[string]> device-options: ["Auto", "CPU", "CUDA"];
    in-out property <int> device-index: 0;
    in property <[string]> resolution-options: ["Auto"];
    in-out property <int> resolution-index: 0;
    in property <string> resolution-note;
    in property <bool> resolution-warning: false;
    in-out property <string> threads-text: "auto";
    in property <string> threads-hint;
    in-out property <string> batch-text: "16";
    in property <bool> batch-fixed: false;
    in-out property <bool> tf32: true;
    in-out property <bool> skip-background: true;
    in-out property <bool> auto-analyze: true;
    in property <bool> can-analyze: false;
    in property <bool> job-running: false;
    in property <string> job-title;
    in property <string> job-status;
    in property <float> job-progress: 0;
    in property <string> job-detail;
    in property <string> last-result;
    in property <bool> last-result-error: false;
    in property <string> auto-hint;

    // Results.
    in property <string> slide-name;
    in property <[string]> view-options: ["Original", "Reconstruction", "Error map", "Difference"];
    in-out property <int> view-index: 0;
    in property <string> adjustment-note;
    in property <string> coverage-text;
    in property <string> stats-text;
    in property <[HistogramBin]> histogram;
    in property <int> histogram-peak: 0;
    in property <string> histogram-lo;
    in property <string> histogram-hi;
    in property <bool> legend-visible: false;
    in property <string> legend-title;
    in property <string> legend-lo;
    in property <string> legend-hi;
    in property <[HotRegion]> hot-regions;
    in property <bool> can-export: false;

    // Cache.
    in property <string> cache-text;
    in property <string> cache-error;
    in property <bool> cache-enabled: true;
    in property <string> memory-text;
    in-out property <bool> keep-pixels: false;

    private property <string> hovered-bin;

    callback section-toggled(string, bool);
    callback load-model();
    callback clear-model();
    callback choose-runtime();
    callback output-selected(int) -> int;
    callback input-scaling-selected(int) -> int;
    callback output-scaling-selected(int) -> int;
    callback composite-white-toggled(bool);
    callback black-to-white-toggled(bool);
    callback reset-preprocessing();
    callback device-selected(int) -> int;
    callback resolution-selected(int) -> int;
    callback threads-committed(string) -> string;
    callback batch-committed(string) -> string;
    callback tf32-toggled(bool);
    callback skip-background-toggled(bool);
    callback auto-analyze-toggled(bool);
    callback analyze-viewport();
    callback analyze-slide();
    callback cancel-job();
    callback view-selected(int) -> int;
    callback jump-to-region(string);
    callback hover-region(string);
    callback export-csv();
    callback keep-pixels-toggled(bool);
    callback clear-cache();

    background: Theme.surface;

    ScrollView {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            alignment: start;

            // ---------------------------------------------------------- Model
            SectionHeader {
                title: "Model";
                summary: root.model-name;
                expanded: root.model-expanded;
                toggled => {
                    root.model-expanded = !root.model-expanded;
                    root.section-toggled("model", root.model-expanded);
                }
            }

            if root.model-expanded: VerticalLayout {
                padding-left: 12px;
                spacing: 6px;

                Text {
                    text: root.model-name == "" ? "No model" : root.model-name;
                    color: Theme.text-primary;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                if root.model-detail != "": Label { text: root.model-detail; }

                if root.model-message != "": Note {
                    text: root.model-message;
                    error: root.model-message-error;
                }

                if root.engine-label != "": Label { text: "Running on " + root.engine-label; }
                if root.engine-note != "": Note { text: root.engine-note; warning: true; }

                HorizontalLayout {
                    spacing: 6px;

                    ActionButton {
                        text: "Load ONNX…";
                        base: #2f6db5;
                        hover: #3f82d1;
                        enabled: root.model-state != 1;
                        clicked => { root.load-model(); }
                    }

                    ActionButton {
                        text: "Clear";
                        enabled: root.model-state != 0;
                        clicked => { root.clear-model(); }
                    }

                    ActionButton {
                        text: "Runtime…";
                        clicked => { root.choose-runtime(); }
                    }
                }

                Label { text: root.runtime-label; }

                if root.model-state == 2: VerticalLayout {
                    spacing: 6px;

                    Label { text: "Input: " + root.input-text; }

                    Field {
                        label: "Output";
                        ComboBox {
                            horizontal-stretch: 1;
                            model: root.output-options;
                            current-index <=> root.output-index;
                            enabled: root.output-options.length > 1;
                            selected(value) => {
                                root.output-index = root.output-selected(self.current-index);
                            }
                        }
                    }

                    if root.latent-text != "": Label { text: root.latent-text; }

                    for warning in root.warnings: Note {
                        text: "⚠ " + warning;
                        warning: true;
                    }

                    Rectangle { height: 1px; background: Theme.border; }

                    Text {
                        text: "Preprocessing";
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                    }

                    Label { text: root.contract-source; }

                    Field {
                        label: "Input range";
                        ComboBox {
                            horizontal-stretch: 1;
                            model: root.scaling-options;
                            current-index <=> root.input-scaling-index;
                            selected(value) => {
                                root.input-scaling-index = root.input-scaling-selected(self.current-index);
                            }
                        }
                    }

                    Field {
                        label: "Output range";
                        ComboBox {
                            horizontal-stretch: 1;
                            model: root.scaling-options;
                            current-index <=> root.output-scaling-index;
                            selected(value) => {
                                root.output-scaling-index = root.output-scaling-selected(self.current-index);
                            }
                        }
                    }

                    CheckBox {
                        text: "Composite transparency onto white";
                        checked <=> root.composite-white;
                        toggled => { root.composite-white-toggled(self.checked); }
                    }

                    CheckBox {
                        text: "Turn near-black pixels white";
                        checked <=> root.black-to-white;
                        toggled => { root.black-to-white-toggled(self.checked); }
                    }

                    if root.contract-overridden: HorizontalLayout {
                        alignment: start;
                        ActionButton {
                            text: "Use the model's preprocessing";
                            min-width: 200px;
                            clicked => { root.reset-preprocessing(); }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.border; }

            // ------------------------------------------------------- Analysis
            SectionHeader {
                title: "Analysis";
                summary: root.job-running ? root.job-status : root.last-result;
                expanded: root.analysis-expanded;
                toggled => {
                    root.analysis-expanded = !root.analysis-expanded;
                    root.section-toggled("analysis", root.analysis-expanded);
                }
            }

            if root.analysis-expanded: VerticalLayout {
                padding-left: 12px;
                spacing: 6px;

                Field {
                    label: "Device";
                    ComboBox {
                        horizontal-stretch: 1;
                        model: root.device-options;
                        current-index <=> root.device-index;
                        selected(value) => {
                            root.device-index = root.device-selected(self.current-index);
                        }
                    }
                }

                Field {
                    label: "Resolution";
                    ComboBox {
                        horizontal-stretch: 1;
                        model: root.resolution-options;
                        current-index <=> root.resolution-index;
                        selected(value) => {
                            root.resolution-index = root.resolution-selected(self.current-index);
                        }
                    }
                }

                if root.resolution-note != "": Note {
                    text: root.resolution-note;
                    warning: root.resolution-warning;
                }

                Field {
                    label: "Threads";
                    threads := LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.threads-text;
                        placeholder-text: root.threads-hint;
                        accepted(text) => { root.threads-text = root.threads-committed(text); }
                        changed has-focus => {
                            if !self.has-focus {
                                root.threads-text = root.threads-committed(self.text);
                            }
                        }
                    }
                }

                Field {
                    label: root.batch-fixed ? "Batch (model)" : "Batch";
                    LineEdit {
                        horizontal-stretch: 1;
                        enabled: !root.batch-fixed;
                        text <=> root.batch-text;
                        accepted(text) => { root.batch-text = root.batch-committed(text); }
                        changed has-focus => {
                            if !self.has-focus {
                                root.batch-text = root.batch-committed(self.text);
                            }
                        }
                    }
                }

                CheckBox {
                    text: "Allow TF32 on CUDA (faster)";
                    checked <=> root.tf32;
                    toggled => { root.tf32-toggled(self.checked); }
                }

                CheckBox {
                    text: "Skip background tiles";
                    checked <=> root.skip-background;
                    toggled => { root.skip-background-toggled(self.checked); }
                }

                CheckBox {
                    text: "Analyse visible tiles automatically";
                    checked <=> root.auto-analyze;
                    toggled => { root.auto-analyze-toggled(self.checked); }
                }

                HorizontalLayout {
                    spacing: 6px;

                    ActionButton {
                        horizontal-stretch: 1;
                        text: "Viewport";
                        base: #206a5d;
                        hover: #2b8777;
                        enabled: root.can-analyze;
                        clicked => { root.analyze-viewport(); }
                    }

                    ActionButton {
                        horizontal-stretch: 1;
                        text: "Whole slide";
                        base: #8a5a12;
                        hover: #aa711d;
                        enabled: root.can-analyze;
                        clicked => { root.analyze-slide(); }
                    }

                    ActionButton {
                        horizontal-stretch: 1;
                        text: "Cancel";
                        base: #922f2f;
                        hover: #b33d3d;
                        enabled: root.job-running;
                        clicked => { root.cancel-job(); }
                    }
                }

                if root.job-running: VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: root.job-title;
                        color: Theme.text-primary;
                        font-size: 11px;
                    }

                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: #23282f;

                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.job-progress, 0, 1);
                            height: parent.height;
                            border-radius: 3px;
                            background: #2f6db5;
                        }
                    }

                    Label { text: root.job-status; }
                    if root.job-detail != "": Label { text: root.job-detail; }
                }

                if root.last-result != "": Note {
                    text: root.last-result;
                    error: root.last-result-error;
                }

                if root.auto-hint != "": Note { text: root.auto-hint; }
            }

            Rectangle { height: 1px; background: Theme.border; }

            // -------------------------------------------------------- Results
            SectionHeader {
                title: "Results";
                summary: root.slide-name;
                expanded: root.results-expanded;
                toggled => {
                    root.results-expanded = !root.results-expanded;
                    root.section-toggled("results", root.results-expanded);
                }
            }

            if root.results-expanded: VerticalLayout {
                padding-left: 12px;
                spacing: 6px;

                Field {
                    label: "Overlay";
                    ComboBox {
                        horizontal-stretch: 1;
                        model: root.view-options;
                        current-index <=> root.view-index;
                        enabled: root.slide-name != "";
                        selected(value) => {
                            root.view-index = root.view-selected(self.current-index);
                        }
                    }
                }

                if root.legend-visible: VerticalLayout {
                    spacing: 2px;

                    Label { text: root.legend-title; }

                    Rectangle {
                        height: 10px;
                        border-radius: 2px;
                        background: @linear-gradient(90deg, #440154 0%, #46327e 14%, #365c8d 29%, #277f8e 43%, #1fa187 57%, #4ac16d 71%, #9fda3a 86%, #fde725 100%);
                    }

                    HorizontalLayout {
                        Label { text: root.legend-lo; }
                        Label { text: root.legend-hi; horizontal-alignment: right; }
                    }
                }

                Label { text: root.coverage-text; }

                if root.histogram.length > 0: VerticalLayout {
                    spacing: 2px;

                    Rectangle {
                        height: 64px;
                        border-radius: 4px;
                        background: #13181f;

                        HorizontalLayout {
                            padding: 4px;
                            spacing: 2px;

                            for bin in root.histogram: Rectangle {
                                horizontal-stretch: 1;

                                bar := Rectangle {
                                    y: parent.height - self.height;
                                    height: max(2px, parent.height * bin.normalized);
                                    border-radius: 2px;
                                    background: touch.has-hover ? #f0c850 : #d4aa33;
                                }

                                touch := TouchArea {
                                    changed has-hover => {
                                        if self.has-hover {
                                            root.hovered-bin = bin.label + " tiles";
                                        } else if root.hovered-bin == bin.label + " tiles" {
                                            root.hovered-bin = "";
                                        }
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        Label { text: root.histogram-lo; }
                        Label {
                            text: root.hovered-bin;
                            horizontal-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Label { text: root.histogram-hi; horizontal-alignment: right; }
                    }
                }

                if root.stats-text != "": Label { text: root.stats-text; }

                if root.hot-regions.length > 0: Text {
                    text: "Highest-error regions";
                    color: Theme.text-primary;
                    font-size: 12px;
                    font-weight: 600;
                }

                for region in root.hot-regions: RegionRow {
                    region: region;
                    clicked => { root.jump-to-region(region.id); }
                    hovered(on) => { root.hover-region(on ? region.id : ""); }
                }

                HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        text: "Export CSV…";
                        min-width: 110px;
                        enabled: root.can-export;
                        clicked => { root.export-csv(); }
                    }
                }

                Note { text: root.adjustment-note; }
                Note { text: "Research use only; not for diagnosis."; }
            }

            Rectangle { height: 1px; background: Theme.border; }

            // ---------------------------------------------------------- Cache
            SectionHeader {
                title: "Cache";
                summary: root.cache-text;
                expanded: root.cache-expanded;
                toggled => {
                    root.cache-expanded = !root.cache-expanded;
                    root.section-toggled("cache", root.cache-expanded);
                }
            }

            if root.cache-expanded: VerticalLayout {
                padding-left: 12px;
                spacing: 6px;

                Label { text: root.cache-text; }
                Label { text: root.memory-text; }
                if root.cache-error != "": Note { text: root.cache-error; error: true; }

                CheckBox {
                    text: "Keep reconstructions on disk (large)";
                    enabled: root.cache-enabled;
                    checked <=> root.keep-pixels;
                    toggled => { root.keep-pixels-toggled(self.checked); }
                }

                HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        text: "Clear cache…";
                        min-width: 110px;
                        enabled: root.cache-enabled;
                        clicked => { root.clear-cache(); }
                    }
                }
            }
        }
    }
}
