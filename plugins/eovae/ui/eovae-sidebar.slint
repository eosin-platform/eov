// The eovae sidebar. Every property is pushed by the plugin (only changed
// values are applied); callbacks that can reject input return the value to
// show. Texts are marked with `@tr` (eov compiles the sidebar with eovae's
// catalogs); the plugin pushes the texts it makes in the same language.
//
// The panel fits the sidebar's width in every language and widget style:
// texts wrap, buttons are as wide as their labels need (rows of buttons go
// onto more lines when the labels do not fit side by side, see `fits`), and
// it never scrolls sideways. A text that wraps beside other items in a row
// has `min-width: 0px`: else Slint does not narrow it below its longest word
// there, and a long name without spaces (a model or slide file name) would
// push the items beside it out of the panel; with it, such a word breaks
// anywhere.

import { CheckBox, LineEdit, Palette, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

// The writing direction of the interface, which eov gives the sidebar as
// `eov-rtl`. Arabic, Persian and Hebrew are written from right to left: a
// line of text starts at the right. Only text is aligned that way: controls
// keep their places (a check box's box and a list's arrow stay where they
// are), and things whose direction is physical (the legend's and the
// histogram's axes) are not mirrored.
global Direction {
    in-out property <bool> rtl: false;
    out property <TextHorizontalAlignment> start: root.rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    out property <TextHorizontalAlignment> end: root.rtl ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
}

// The language of the interface beyond its texts and direction, from the
// sidebar's `eov-language` (a tag such as "pt-BR").
global Script {
    in-out property <string> language;
    /// The size for small text (`font-size: Script.text-size(11px)`): at
    /// least 12 px in Hindi, other languages keep `size`. Below 12 px eov's
    /// GPU renderer draws Devanagari with overlapping and missing pieces at
    /// a scale factor of 1.
    public pure function text-size(size: length) -> length {
        return root.language == "hi" ? max(size, 12px) : size;
    }
}

// The colours of eov's widget style (Slint's Fluent, light or dark as the
// desktop is) that `Palette` does not offer, so that the drop-down lists
// look like the style's own.
global Look {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <brush> control-border: root.dark ? @linear-gradient(180deg, #ffffff17 0%, #00000012 8.33%) : @linear-gradient(180deg, #0000000f 90.58%, #00000029 100%);
    out property <brush> control-hover: root.dark ? #ffffff14 : #f9f9f980;
    out property <brush> control-pressed: root.dark ? #ffffff0a : #0000000f;
    out property <brush> control-disabled: root.dark ? #ffffff0a : #f9f9f94d;
    out property <brush> text-disabled: root.dark ? #ffffff5e : #0000005e;
    out property <brush> text-secondary: root.dark ? #ffffffc9 : #00000099;
    out property <brush> item-hover: root.dark ? #ffffff0f : #0000000a;
    out property <brush> flyout-border: root.dark ? #00000033 : #0000000f;
    out property <brush> shadow: root.dark ? #00000042 : #00000024;
    out property <brush> focus-outer: root.dark ? #ffffff : #000000e6;
    // Check box labels: the style's text colour where it reads on the dark
    // panel, the panel's own otherwise.
    out property <brush> label: root.dark ? Palette.foreground : Theme.text-primary;
    // A disabled check box's label. The panel is dark in both styles, so
    // this is the dark style's disabled text colour in both (the light
    // style's, translucent black, cannot be seen on it).
    out property <brush> label-disabled: #ffffff5e;
}

export struct HistogramBin {
    label: string,
    count: int,
    normalized: float,
}

export struct HotRegion {
    id: string,
    label: string,
    score: string,
}

// A button whose label is never cut: `natural-width` is the width the label
// needs on one line, which the rows of buttons use to decide how many fit
// side by side (see `fits`). A label wider than the whole row wraps, and the
// button grows taller.
component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> base: #3e444c;
    in property <color> hover: #4a5460;
    out property <length> natural-width: max(64px, label.preferred-width + 8px);
    callback clicked();

    min-width: 64px;
    // Buttons side by side share their row equally, unless the row sets
    // their widths.
    preferred-width: 64px;
    min-height: max(28px, content.min-height);
    horizontal-stretch: 1;
    border-radius: 4px;
    background: root.enabled ? (touch.has-hover ? root.hover : root.base) : #2e3238;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }

    content := HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 5px;
        padding-bottom: 5px;

        label := Text {
            // A word wider than the button breaks (see the top of the file).
            min-width: 0px;
            text: root.text;
            color: root.enabled ? white : #ffffff66;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            accessible-role: none;
        }
    }
}

component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> summary;
    in property <bool> expanded;
    callback toggled();

    // Taller when the summary wraps.
    min-height: max(30px, content.min-height);
    border-radius: 4px;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.expanded ? "" : root.summary;
    accessible-expandable: true;
    accessible-expanded: root.expanded;
    accessible-action-default => { root.toggled(); }
    accessible-action-expand => { root.toggled(); }

    touch := TouchArea {
        clicked => { root.toggled(); }
    }

    // The triangle stays at the left in every language; the title starts
    // the line (at the right in right-to-left languages) and the summary of
    // a closed section ends it, wrapping when it is long (a file name with
    // no spaces breaks anywhere, see the top of the file: the title stays in
    // view).
    content := HorizontalLayout {
        padding-left: 4px;
        padding-right: 6px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;

        Text {
            text: root.expanded ? "▾" : "▸";
            color: Theme.text-secondary;
            font-size: 12px;
            vertical-alignment: center;
            accessible-role: none;
        }

        if !Direction.rtl: Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            accessible-role: none;
        }

        Text {
            min-width: 0px;
            horizontal-stretch: 1;
            text: root.expanded ? "" : root.summary;
            color: Theme.text-secondary;
            font-size: Script.text-size(11px);
            horizontal-alignment: Direction.end;
            vertical-alignment: center;
            wrap: word-wrap;
            accessible-role: none;
        }

        if Direction.rtl: Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

component Label inherits Text {
    color: Theme.text-secondary;
    font-size: Script.text-size(11px);
    wrap: word-wrap;
    horizontal-alignment: Direction.start;
}

component Note inherits Text {
    in property <bool> error: false;
    in property <bool> warning: false;
    color: root.error ? #e57373 : (root.warning ? #e0b050 : Theme.text-secondary);
    font-size: Script.text-size(11px);
    wrap: word-wrap;
    horizontal-alignment: Direction.start;
}

// The label of a field. The labels line up the fields beside them, unless
// one is longer; a label too long for its row wraps.
component FieldLabel inherits Text {
    min-width: 86px;
    horizontal-stretch: 0;
    color: Theme.text-secondary;
    font-size: Script.text-size(11px);
    wrap: word-wrap;
    horizontal-alignment: Direction.start;
    vertical-alignment: center;
}

component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;

    FieldLabel { text: root.label; }

    @children
}

// A check box whose label wraps (the style's CheckBox keeps its label on one
// line, which made the panel wider than the sidebar). The box is the
// style's; it stays at the left in every language, and the label starts the
// line. Clicking the label toggles the box too.
component CheckRow inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled(bool);

    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    HorizontalLayout {
        spacing: 12px;

        // At the top of a label of several lines.
        VerticalLayout {
            alignment: start;

            CheckBox {
                enabled: root.enabled;
                checked <=> root.checked;
                accessible-label: root.text;
                toggled => { root.toggled(self.checked); }
            }
        }

        Text {
            // A word wider than the line breaks (see the top of the file).
            min-width: 0px;
            horizontal-stretch: 1;
            text: root.text;
            color: root.enabled ? Look.label : Look.label-disabled;
            horizontal-alignment: Direction.start;
            vertical-alignment: center;
            wrap: word-wrap;
            accessible-role: none;
        }
    }
}

// A drop-down list that looks like the style's ComboBox, except that:
// - its value starts the line (at the right in right-to-left languages; the
//   arrow stays at the right),
// - it shows the model's row also after the plugin rewrote the rows (a change
//   of language: eov updates them in place, and the style's ComboBox kept the
//   old text),
// - a long value wraps (a word wider than the field breaks, see the top of
//   the file), and the list is as wide as its widest item.
// As in the style's, assistive technology is told whether the list is open,
// the open list keeps the current row in view, and dragging its rows (with
// a finger or the mouse) scrolls it.
component Choice inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    // The user picked another row (in the list or with the arrow keys).
    callback selected(int);

    out property <string> current-value: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
    property <length> item-height: 40px;
    property <length> list-padding: 4px;
    // The open list shows at most ten rows; the others are scrolled to.
    property <int> list-rows: min(root.model.length, 10);
    // How far the open list is scrolled (0: its first row at the top).
    property <length> list-scroll: 0px;
    property <length> list-max-scroll: max(0px, (root.model.length - root.list-rows) * root.item-height);
    // The scroll as drawn, kept within the rows there are (the plugin can
    // change them while the list is open).
    property <length> list-offset: min(root.list-scroll, root.list-max-scroll);
    // Dragging the rows of a list that scrolls (a finger, or the mouse)
    // scrolls it, as the style's list does: where the press was, in the
    // list's rows, and the scroll then. A drag picks no row.
    property <length> drag-from;
    property <length> drag-scroll;
    property <bool> dragging;
    // The list is open (it has the focus then).
    property <bool> open;

    function pick(index: int) {
        if !root.enabled || index < 0 || index >= root.model.length || index == root.current-index {
            return;
        }
        root.current-index = index;
        root.selected(index);
    }

    // Scrolls the open list as little as needed to show the current row.
    function reveal() {
        root.list-scroll = max(0px, min(root.list-max-scroll, root.current-index * root.item-height, max(root.list-scroll, (root.current-index + 1 - root.list-rows) * root.item-height)));
    }

    function open-list() {
        if root.enabled {
            focus.focus();
            // As the style's list opens: from the top, unless the current
            // row would be below the last row shown.
            root.list-scroll = 0px;
            root.reveal();
            list.show();
        }
    }

    min-width: 64px;
    min-height: max(32px, layout.min-height);
    horizontal-stretch: 1;
    border-radius: 3px;
    border-width: 1px;
    border-color: !root.enabled || touch.pressed ? Palette.border : Look.control-border;
    background: !root.enabled ? Look.control-disabled : touch.pressed ? Look.control-pressed : touch.has-hover ? Look.control-hover : Palette.control-background;
    forward-focus: focus;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-value: root.current-value;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => { root.open-list(); }
    accessible-action-expand => { root.open-list(); }

    focus := FocusScope {
        enabled: root.enabled;
        // The focus comes back when the list closes.
        changed has-focus => {
            if self.has-focus {
                root.open = false;
            }
        }
        key-pressed(event) => {
            if event.text == Key.UpArrow {
                root.pick(root.current-index - 1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.pick(root.current-index + 1);
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                root.open-list();
                return accept;
            }
            reject
        }

        touch := TouchArea {
            enabled: root.enabled;
            clicked => { root.open-list(); }
        }
    }

    layout := HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 8px;

        Text {
            min-width: 0px;
            horizontal-stretch: 1;
            text: root.current-value;
            color: !root.enabled ? Look.text-disabled : touch.pressed ? Look.text-secondary : Palette.control-foreground;
            horizontal-alignment: Direction.start;
            vertical-alignment: center;
            wrap: word-wrap;
            accessible-role: none;
        }

        // The arrow, drawn as the style's.
        VerticalLayout {
            alignment: center;

            Path {
                width: 12px;
                height: 16px;
                viewbox-width: 12;
                viewbox-height: 16;
                commands: "M 0.5 5 L 6 10.5 L 11.5 5";
                stroke: !root.enabled ? Look.text-disabled : Look.text-secondary;
                stroke-width: 1px;
                stroke-line-cap: round;
                fill: transparent;
                opacity: 0.786;
                accessible-role: none;
            }
        }
    }

    // Also while the list is open, as the style's.
    if (focus.has-focus || root.open) && root.enabled: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Look.focus-outer;
    }

    list := PopupWindow {
        x: 0;
        // The first item over the field, as the style's list opens.
        y: -root.list-padding;
        width: max(root.width, items.preferred-width);
        height: root.list-rows * root.item-height + 2 * root.list-padding;
        close-policy: close-on-click-outside;
        forward-focus: keys;

        keys := FocusScope {
            focus-changed-event => {
                root.open = self.has-focus;
            }
            key-pressed(event) => {
                if event.text == Key.UpArrow {
                    root.pick(root.current-index - 1);
                    root.reveal();
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.pick(root.current-index + 1);
                    root.reveal();
                    return accept;
                }
                if event.text == Key.Return || event.text == Key.Escape {
                    list.close();
                    return accept;
                }
                reject
            }

            Rectangle {
                border-radius: 7px;
                background: Palette.alternate-background;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 8px;
                drop-shadow-color: Look.shadow;

                // The wheel scrolls the list (the rows pass it on).
                TouchArea {
                    scroll-event(event) => {
                        root.list-scroll = max(0px, min(root.list-max-scroll, root.list-offset - event.delta-y));
                        accept
                    }
                }

                // The rows, scrolled by `list-scroll`. (Not a ScrollView:
                // its position is `viewport-y` in Slint 1.17 and `content-y`
                // in 1.19, where `viewport-y` warns, and the sidebar is for
                // both.)
                Rectangle {
                    y: root.list-padding;
                    height: root.list-rows * root.item-height;
                    clip: true;

                    items := VerticalLayout {
                        y: -root.list-offset;
                        height: root.model.length * root.item-height;
                        alignment: start;
                        padding-left: root.list-padding;
                        padding-right: root.list-padding;

                        for value[index] in root.model: Rectangle {
                            height: root.item-height;
                            accessible-role: list-item;
                            accessible-label: value;
                            accessible-item-selectable: true;
                            accessible-item-selected: index == root.current-index;
                            accessible-item-index: index;
                            accessible-action-default => {
                                root.pick(index);
                                list.close();
                            }

                            Rectangle {
                                x: 3px;
                                y: 2px;
                                width: parent.width - 6px;
                                height: parent.height - 4px;
                                border-radius: 4px;
                                background: item-touch.has-hover || index == root.current-index ? Look.item-hover : transparent;

                                // The selected item's mark, at the left as
                                // in the style's list.
                                Rectangle {
                                    x: 0;
                                    y: (parent.height - self.height) / 2;
                                    width: 3px;
                                    height: index == root.current-index ? 16px : 0;
                                    border-radius: 1.5px;
                                    background: Palette.accent-background;
                                }
                            }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;

                                Text {
                                    text: value;
                                    color: Palette.control-foreground;
                                    horizontal-alignment: Direction.start;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                            }

                            item-touch := TouchArea {
                                // The pointer's height in the list: the
                                // rows move as the list scrolls.
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down {
                                        root.drag-from = index * root.item-height - root.list-offset + self.mouse-y;
                                        root.drag-scroll = root.list-offset;
                                        root.dragging = false;
                                    }
                                }
                                moved => {
                                    if self.pressed {
                                        let distance = index * root.item-height - root.list-offset + self.mouse-y - root.drag-from;
                                        // Only a list that can scroll is
                                        // dragged: in the others an unsteady
                                        // click still picks its row.
                                        if abs(distance) > 8px && root.list-max-scroll > 0 {
                                            root.dragging = true;
                                        }
                                        if root.dragging {
                                            root.list-scroll = max(0px, min(root.list-max-scroll, root.drag-scroll - distance));
                                        }
                                    }
                                }
                                clicked => {
                                    if !root.dragging {
                                        root.pick(index);
                                        list.close();
                                    }
                                }
                            }
                        }
                    }
                }

                // The scroll bar, drawn as the style's: a thin thumb at the
                // right, wider under the pointer, that can be dragged.
                if root.list-max-scroll > 0: Rectangle {
                    property <length> thumb-height: max(16px, self.height * self.height / (self.height + root.list-max-scroll));
                    x: parent.width - self.width;
                    y: root.list-padding;
                    width: 14px;
                    height: root.list-rows * root.item-height;

                    bar-touch := TouchArea {
                        property <length> scroll-at-press;
                        pointer-event(event) => {
                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                self.scroll-at-press = root.list-offset;
                            }
                        }
                        moved => {
                            if self.pressed {
                                root.list-scroll = max(0px, min(root.list-max-scroll, self.scroll-at-press + (self.mouse-y - self.pressed-y) * root.list-max-scroll / (parent.height - parent.thumb-height)));
                            }
                        }
                    }

                    Rectangle {
                        x: parent.width - 4px - self.width;
                        y: (parent.height - self.height) * root.list-offset / root.list-max-scroll;
                        width: bar-touch.has-hover || bar-touch.pressed ? 6px : 2px;
                        height: parent.thumb-height;
                        border-radius: self.width / 2;
                        background: Palette.border;

                        animate width { duration: 150ms; easing: ease-out; }
                    }
                }

                Rectangle {
                    border-radius: parent.border-radius;
                    border-width: 1px;
                    border-color: Look.flyout-border;
                }
            }
        }
    }
}

// A labelled drop-down list (see Choice).
component ChoiceField inherits HorizontalLayout {
    in property <string> label;
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    callback selected(int);
    spacing: 8px;

    FieldLabel { text: root.label; }

    Choice {
        accessible-label: root.label;
        model: root.model;
        current-index <=> root.current-index;
        enabled: root.enabled;
        selected(index) => { root.selected(index); }
    }
}

component RegionRow inherits Rectangle {
    in property <HotRegion> region;
    callback clicked();
    callback hovered(bool);

    height: 40px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.has-hover ? Theme.surface-hover : #ffffff08;

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover); }
    }

    VerticalLayout {
        padding: 5px;
        spacing: 2px;

        Text {
            text: root.region.label;
            color: Theme.text-primary;
            font-size: Script.text-size(11px);
            horizontal-alignment: Direction.start;
            overflow: elide;
        }

        Text {
            text: root.region.score;
            color: Theme.text-secondary;
            font-size: Script.text-size(10px);
            horizontal-alignment: Direction.start;
            overflow: elide;
        }
    }
}

export component EovaeSidebar inherits Rectangle {
    // Set by eov: the interface is written from right to left (see
    // Direction).
    in property <bool> eov-rtl;
    // Set by eov: the language of the interface (see Script).
    in property <string> eov-language;
    init => {
        Direction.rtl = root.eov-rtl;
        Script.language = root.eov-language;
    }
    changed eov-rtl => {
        Direction.rtl = root.eov-rtl;
    }
    changed eov-language => {
        Script.language = root.eov-language;
    }

    // Sections.
    in-out property <bool> model-expanded: true;
    in-out property <bool> analysis-expanded: true;
    in-out property <bool> results-expanded: true;
    in-out property <bool> cache-expanded: false;

    // Model.
    in property <int> model-state: 0;
    in property <string> model-name;
    in property <string> model-detail;
    in property <string> model-message: @tr("No model loaded.");
    in property <bool> model-message-error: false;
    in property <string> engine-label;
    in property <string> engine-note;
    in property <string> runtime-label;
    // Downloading a model through eov's model store (empty label: no button).
    in property <string> download-label;
    in property <string> download-note;
    in property <bool> download-note-error: false;
    in property <bool> download-busy: false;
    in-out property <string> download-url;
    in-out property <string> download-sha256;
    private property <bool> download-address: false;
    in property <string> input-text;
    in property <[string]> output-options;
    in-out property <int> output-index: 0;
    in property <string> latent-text;
    in property <[string]> warnings;
    in property <string> contract-source;
    in property <string> contract-summary;
    in property <[string]> scaling-options: ["[-1, 1]", "[0, 1]", "[0, 255]", @tr("Preprocessing" => "ImageNet mean/std")];
    in-out property <int> input-scaling-index: 0;
    in-out property <int> output-scaling-index: 0;
    in-out property <bool> composite-white: true;
    in-out property <bool> black-to-white: true;
    in property <bool> contract-overridden: false;

    // Analysis.
    // Translators: inference device: CUDA when it works, else the CPU
    in property <[string]> device-options: [@tr("Device" => "Auto"), "CPU", "CUDA"];
    in-out property <int> device-index: 0;
    in property <[string]> resolution-options: [@tr("Resolution" => "Auto")];
    in-out property <int> resolution-index: 0;
    in property <string> resolution-note;
    in property <bool> resolution-warning: false;
    // "auto" is typed as it is, in every language (the plugin reads it).
    in-out property <string> threads-text: "auto";
    in property <string> threads-hint;
    in-out property <string> batch-text: "16";
    in property <bool> batch-fixed: false;
    in-out property <bool> tf32: true;
    in-out property <bool> skip-background: true;
    in-out property <bool> auto-analyze: true;
    in property <bool> can-analyze: false;
    in property <bool> has-roi: false;
    in property <bool> job-running: false;
    in property <string> job-title;
    in property <string> job-status;
    in property <float> job-progress: 0;
    in property <string> job-detail;
    in property <string> last-result;
    in property <bool> last-result-error: false;
    in property <string> auto-hint;

    // Results.
    in property <string> slide-name;
    in property <[string]> view-options: [
        @tr("Overlay" => "Original"),
        @tr("Overlay" => "Reconstruction"),
        @tr("Overlay" => "Error map"),
        @tr("Overlay" => "Difference"),
    ];
    in-out property <int> view-index: 0;
    in property <string> adjustment-note;
    in property <bool> adjustment-warning: false;
    in property <string> coverage-text;
    in property <string> stats-text;
    in property <[HistogramBin]> histogram;
    in property <int> histogram-peak: 0;
    in property <string> histogram-lo;
    in property <string> histogram-hi;
    in property <bool> legend-visible: false;
    in property <string> legend-title;
    in property <string> legend-lo;
    in property <string> legend-hi;
    in property <[HotRegion]> hot-regions;
    in property <bool> can-export: false;

    // Cache.
    in property <string> cache-text;
    in property <string> cache-error;
    in property <bool> cache-enabled: true;
    in property <string> memory-text;
    in-out property <bool> keep-pixels: false;

    private property <string> hovered-bin;
    // The width of a section's content: the panel without its margins and
    // the sections' indent. Rows of buttons are laid out for it.
    private property <length> section-width: root.width - 2 * 8px - 12px;

    callback section-toggled(string, bool);
    callback load-model();
    callback clear-model();
    callback choose-runtime();
    callback download-model();
    callback download-url-committed(string) -> string;
    callback download-sha256-committed(string) -> string;
    callback output-selected(int) -> int;
    callback input-scaling-selected(int) -> int;
    callback output-scaling-selected(int) -> int;
    callback composite-white-toggled(bool);
    callback black-to-white-toggled(bool);
    callback reset-preprocessing();
    callback device-selected(int) -> int;
    callback resolution-selected(int) -> int;
    callback threads-committed(string) -> string;
    callback batch-committed(string) -> string;
    callback tf32-toggled(bool);
    callback skip-background-toggled(bool);
    callback auto-analyze-toggled(bool);
    callback analyze-viewport();
    callback analyze-slide();
    callback analyze-roi();
    callback cancel-job();
    callback view-selected(int) -> int;
    callback jump-to-region(string);
    callback hover-region(string);
    callback export-csv();
    callback keep-pixels-toggled(bool);
    callback clear-cache();

    // Whether `n` buttons whose labels need `total` together fit side by
    // side in a section. A row of buttons (`model-buttons`, `run-buttons`)
    // is laid out:
    // - side by side and as wide as each other when the widest label fits
    //   that way (as it does in English);
    // - else side by side, each as wide as its label;
    // - else in two columns, else one under the other.
    pure function fits(n: int, total: length) -> bool {
        return total + (n - 1) * 6px <= root.section-width;
    }

    background: Theme.surface;

    ScrollView {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            // Never wider than the sidebar, so that the panel never scrolls
            // sideways: the rows below get the sidebar's width, and a text
            // in them wraps (a word longer than the line too: directly in a
            // column it can always be narrowed; beside other items in a row
            // it has `min-width: 0px`, see the top of the file).
            min-width: 0px;
            padding: 8px;
            spacing: 6px;
            alignment: start;

            // ---------------------------------------------------------- Model
            SectionHeader {
                // Translators: the sidebar's section about the ONNX model
                title: @tr("Model");
                summary: root.model-name;
                expanded: root.model-expanded;
                toggled => {
                    root.model-expanded = !root.model-expanded;
                    root.section-toggled("model", root.model-expanded);
                }
            }

            if root.model-expanded: VerticalLayout {
                padding-left: 12px;
                spacing: 6px;

                Text {
                    text: root.model-name == "" ? @tr("No model") : root.model-name;
                    color: Theme.text-primary;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-alignment: Direction.start;
                }

                if root.model-detail != "": Label { text: root.model-detail; }

                if root.model-message != "": Note {
                    text: root.model-message;
                    error: root.model-message-error;
                }

                // Translators: {} is the inference device, e.g. CPU · 8 threads
                if root.engine-label != "": Label { text: @tr("Running on {}", root.engine-label); }
                if root.engine-note != "": Note { text: root.engine-note; warning: true; }

                model-buttons := GridLayout {
                    property <length> widest: max(load-button.natural-width, clear-button.natural-width, runtime-button.natural-width);
                    property <length> total: load-button.natural-width + clear-button.natural-width + runtime-button.natural-width;
                    property <bool> equal-row: root.fits(3, 3 * self.widest);
                    property <int> columns: self.equal-row || root.fits(3, self.total) ? 3 : root.fits(2, 2 * self.widest) ? 2 : 1;
                    property <bool> equal: self.equal-row || self.columns < 3;
                    spacing: 6px;

                    load-button := ActionButton {
                        row: 0;
                        col: 0;
                        preferred-width: model-buttons.equal ? 64px : self.natural-width;
                        text: @tr("Load ONNX…");
                        base: #2f6db5;
                        hover: #3f82d1;
                        enabled: root.model-state != 1;
                        clicked => { root.load-model(); }
                    }

                    clear-button := ActionButton {
                        row: Math.floor(1 / model-buttons.columns);
                        col: Math.mod(1, model-buttons.columns);
                        preferred-width: model-buttons.equal ? 64px : self.natural-width;
                        // Translators: unloads the model
                        text: @tr("Clear");
                        enabled: root.model-state != 0;
                        clicked => { root.clear-model(); }
                    }

                    runtime-button := ActionButton {
                        row: Math.floor(2 / model-buttons.columns);
                        col: Math.mod(2, model-buttons.columns);
                        preferred-width: model-buttons.equal ? 64px : self.natural-width;
                        // Translators: chooses the ONNX Runtime library
                        text: @tr("Runtime…");
                        clicked => { root.choose-runtime(); }
                    }
                }

                Label { text: root.runtime-label; }

                if root.download-label != "": VerticalLayout {
                    spacing: 4px;

                    // Side by side when both labels fit, else one under the
                    // other.
                    download-buttons := GridLayout {
                        property <bool> side-by-side: max(190px, download-button.natural-width) + 6px + max(64px, address-button.natural-width) <= root.section-width;
                        spacing: 6px;

                        download-button := ActionButton {
                            row: 0;
                            col: 0;
                            horizontal-stretch: 0;
                            preferred-width: max(190px, self.natural-width);
                            text: root.download-label;
                            base: #2f6db5;
                            hover: #3f82d1;
                            enabled: !root.download-busy;
                            clicked => { root.download-model(); }
                        }

                        address-button := ActionButton {
                            row: download-buttons.side-by-side ? 0 : 1;
                            col: download-buttons.side-by-side ? 1 : 0;
                            horizontal-stretch: 0;
                            preferred-width: max(64px, self.natural-width);
                            text: root.download-address ? @tr("Hide address") : @tr("Address…");
                            clicked => { root.download-address = !root.download-address; }
                        }

                        // The rest of the line.
                        Rectangle {
                            row: 0;
                            col: 2;
                            horizontal-stretch: 1;
                        }
                    }

                    if root.download-note != "": Note {
                        text: root.download-note;
                        error: root.download-note-error;
                    }

                    if root.download-address: VerticalLayout {
                        spacing: 4px;

                        Label {
                            text: @tr("Your site's copy of the model (the .onnx file; the reference model's .onnx.data comes from the same folder):");
                        }

                        LineEdit {
                            text <=> root.download-url;
                            placeholder-text: "https://…/HistoVae_reconstruct.onnx";
                            accepted(text) => { root.download-url = root.download-url-committed(text); }
                            changed has-focus => {
                                if !self.has-focus {
                                    root.download-url = root.download-url-committed(self.text);
                                }
                            }
                        }

                        Label {
                            text: @tr("SHA-256 of your own model at that address (empty: the reference model, checked against the SHA-256 eovae knows):");
                        }

                        LineEdit {
                            text <=> root.download-sha256;
                            placeholder-text: @tr("64 hex digits");
                            accepted(text) => { root.download-sha256 = root.download-sha256-committed(text); }
                            changed has-focus => {
                                if !self.has-focus {
                                    root.download-sha256 = root.download-sha256-committed(self.text);
                                }
                            }
                        }
                    }
                }

                if root.model-state == 2: VerticalLayout {
                    spacing: 6px;

                    // Translators: {} is the model's input: name · type · shape
                    Label { text: @tr("Input: {}", root.input-text); }

                    ChoiceField {
                        // Translators: the model's output the sidebar reads
                        label: @tr("Output");
                        model: root.output-options;
                        current-index <=> root.output-index;
                        enabled: root.output-options.length > 1;
                        selected(index) => {
                            root.output-index = root.output-selected(index);
                        }
                    }

                    if root.latent-text != "": Label { text: root.latent-text; }

                    for warning in root.warnings: Note {
                        text: "⚠ " + warning;
                        warning: true;
                    }

                    Rectangle { height: 1px; background: Theme.border; }

                    Text {
                        text: @tr("Preprocessing");
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                        wrap: word-wrap;
                        horizontal-alignment: Direction.start;
                    }

                    Label { text: root.contract-source; }

                    ChoiceField {
                        label: @tr("Input range");
                        model: root.scaling-options;
                        current-index <=> root.input-scaling-index;
                        selected(index) => {
                            root.input-scaling-index = root.input-scaling-selected(index);
                        }
                    }

                    ChoiceField {
                        label: @tr("Output range");
                        model: root.scaling-options;
                        current-index <=> root.output-scaling-index;
                        selected(index) => {
                            root.output-scaling-index = root.output-scaling-selected(index);
                        }
                    }

                    CheckRow {
                        text: @tr("Composite transparency onto white");
                        checked <=> root.composite-white;
                        toggled(checked) => { root.composite-white-toggled(checked); }
                    }

                    CheckRow {
                        text: @tr("Turn near-black pixels white");
                        checked <=> root.black-to-white;
                        toggled(checked) => { root.black-to-white-toggled(checked); }
                    }

                    if root.contract-overridden: HorizontalLayout {
                        alignment: start;
                        ActionButton {
                            horizontal-stretch: 0;
                            preferred-width: max(200px, self.natural-width);
                            text: @tr("Use the model's preprocessing");
                            clicked => { root.reset-preprocessing(); }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.border; }

            // ------------------------------------------------------- Analysis
            SectionHeader {
                title: @tr("Analysis");
                summary: root.job-running ? root.job-status : root.last-result;
                expanded: root.analysis-expanded;
                toggled => {
                    root.analysis-expanded = !root.analysis-expanded;
                    root.section-toggled("analysis", root.analysis-expanded);
                }
            }

            if root.analysis-expanded: VerticalLayout {
                padding-left: 12px;
                spacing: 6px;

                ChoiceField {
                    // Translators: the inference device (CPU or CUDA)
                    label: @tr("Device");
                    model: root.device-options;
                    current-index <=> root.device-index;
                    selected(index) => {
                        root.device-index = root.device-selected(index);
                    }
                }

                ChoiceField {
                    // Translators: the pyramid level tiles are read from
                    label: @tr("Resolution");
                    model: root.resolution-options;
                    current-index <=> root.resolution-index;
                    selected(index) => {
                        root.resolution-index = root.resolution-selected(index);
                    }
                }

                if root.resolution-note != "": Note {
                    text: root.resolution-note;
                    warning: root.resolution-warning;
                }

                Field {
                    // Translators: CPU inference threads
                    label: @tr("Threads");
                    threads := LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.threads-text;
                        placeholder-text: root.threads-hint;
                        accepted(text) => { root.threads-text = root.threads-committed(text); }
                        changed has-focus => {
                            if !self.has-focus {
                                root.threads-text = root.threads-committed(self.text);
                            }
                        }
                    }
                }

                Field {
                    // Translators: batch size (tiles per run); (model): the model fixes it
                    label: root.batch-fixed ? @tr("Batch (model)") : @tr("Batch");
                    LineEdit {
                        horizontal-stretch: 1;
                        enabled: !root.batch-fixed;
                        text <=> root.batch-text;
                        accepted(text) => { root.batch-text = root.batch-committed(text); }
                        changed has-focus => {
                            if !self.has-focus {
                                root.batch-text = root.batch-committed(self.text);
                            }
                        }
                    }
                }

                CheckRow {
                    // Translators: TF32 is a faster, less precise number format of NVIDIA GPUs (CUDA); the computed errors change slightly.
                    text: @tr("Allow TF32 on CUDA (faster, less precise)");
                    checked <=> root.tf32;
                    toggled(checked) => { root.tf32-toggled(checked); }
                }

                CheckRow {
                    text: @tr("Skip background tiles");
                    checked <=> root.skip-background;
                    toggled(checked) => { root.skip-background-toggled(checked); }
                }

                CheckRow {
                    text: @tr("Analyse visible tiles automatically");
                    checked <=> root.auto-analyze;
                    toggled(checked) => { root.auto-analyze-toggled(checked); }
                }

                // Laid out as `model-buttons`.
                run-buttons := GridLayout {
                    property <length> widest: max(viewport-button.natural-width, roi-button.natural-width, slide-button.natural-width, cancel-button.natural-width);
                    property <length> total: viewport-button.natural-width + roi-button.natural-width + slide-button.natural-width + cancel-button.natural-width;
                    property <bool> equal-row: root.fits(4, 4 * self.widest);
                    property <int> columns: self.equal-row || root.fits(4, self.total) ? 4 : root.fits(2, 2 * self.widest) ? 2 : 1;
                    property <bool> equal: self.equal-row || self.columns < 4;
                    spacing: 6px;

                    viewport-button := ActionButton {
                        row: 0;
                        col: 0;
                        preferred-width: run-buttons.equal ? 64px : self.natural-width;
                        // Translators: analyses the visible part of the slide
                        text: @tr("Viewport");
                        base: #206a5d;
                        hover: #2b8777;
                        enabled: root.can-analyze;
                        clicked => { root.analyze-viewport(); }
                    }

                    roi-button := ActionButton {
                        row: Math.floor(1 / run-buttons.columns);
                        col: Math.mod(1, run-buttons.columns);
                        preferred-width: run-buttons.equal ? 64px : self.natural-width;
                        // Translators: analyses the region of interest drawn on the slide
                        text: @tr("ROI");
                        base: #2e5e8a;
                        hover: #3b74a8;
                        enabled: root.can-analyze && root.has-roi;
                        clicked => { root.analyze-roi(); }
                    }

                    slide-button := ActionButton {
                        row: Math.floor(2 / run-buttons.columns);
                        col: Math.mod(2, run-buttons.columns);
                        preferred-width: run-buttons.equal ? 64px : self.natural-width;
                        text: @tr("Whole slide");
                        base: #8a5a12;
                        hover: #aa711d;
                        enabled: root.can-analyze;
                        clicked => { root.analyze-slide(); }
                    }

                    cancel-button := ActionButton {
                        row: Math.floor(3 / run-buttons.columns);
                        col: Math.mod(3, run-buttons.columns);
                        preferred-width: run-buttons.equal ? 64px : self.natural-width;
                        // Translators: stops the running analysis
                        text: @tr("Cancel");
                        base: #922f2f;
                        hover: #b33d3d;
                        enabled: root.job-running;
                        clicked => { root.cancel-job(); }
                    }
                }

                if root.job-running: VerticalLayout {
                    spacing: 4px;

                    Text {
                        text: root.job-title;
                        color: Theme.text-primary;
                        font-size: Script.text-size(11px);
                        wrap: word-wrap;
                        horizontal-alignment: Direction.start;
                    }

                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: #23282f;

                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.job-progress, 0, 1);
                            height: parent.height;
                            border-radius: 3px;
                            background: #2f6db5;
                        }
                    }

                    Label { text: root.job-status; }
                    if root.job-detail != "": Label { text: root.job-detail; }
                }

                if root.last-result != "": Note {
                    text: root.last-result;
                    error: root.last-result-error;
                }

                if root.auto-hint != "": Note { text: root.auto-hint; }
            }

            Rectangle { height: 1px; background: Theme.border; }

            // -------------------------------------------------------- Results
            SectionHeader {
                title: @tr("Results");
                summary: root.slide-name;
                expanded: root.results-expanded;
                toggled => {
                    root.results-expanded = !root.results-expanded;
                    root.section-toggled("results", root.results-expanded);
                }
            }

            if root.results-expanded: VerticalLayout {
                padding-left: 12px;
                spacing: 6px;

                ChoiceField {
                    // Translators: what the overlay shows: Original, Reconstruction, …
                    label: @tr("Overlay");
                    model: root.view-options;
                    current-index <=> root.view-index;
                    enabled: root.slide-name != "";
                    selected(index) => {
                        root.view-index = root.view-selected(index);
                    }
                }

                if root.adjustment-note != "": Note {
                    text: root.adjustment-note;
                    warning: root.adjustment-warning;
                }

                if root.legend-visible: VerticalLayout {
                    spacing: 2px;

                    Label { text: root.legend-title; }

                    Rectangle {
                        height: 10px;
                        border-radius: 2px;
                        background: @linear-gradient(90deg, #440154 0%, #46327e 14%, #365c8d 29%, #277f8e 43%, #1fa187 57%, #4ac16d 71%, #9fda3a 86%, #fde725 100%);
                    }

                    // The gradient runs left to right in every language.
                    HorizontalLayout {
                        Label { text: root.legend-lo; horizontal-alignment: left; }
                        Label { text: root.legend-hi; horizontal-alignment: right; }
                    }
                }

                Label { text: root.coverage-text; }

                if root.histogram.length > 0: VerticalLayout {
                    spacing: 2px;

                    Rectangle {
                        height: 64px;
                        border-radius: 4px;
                        background: #13181f;

                        HorizontalLayout {
                            padding: 4px;
                            spacing: 2px;

                            for bin in root.histogram: Rectangle {
                                horizontal-stretch: 1;

                                bar := Rectangle {
                                    y: parent.height - self.height;
                                    height: max(2px, parent.height * bin.normalized);
                                    border-radius: 2px;
                                    background: touch.has-hover ? #f0c850 : #d4aa33;
                                }

                                touch := TouchArea {
                                    changed has-hover => {
                                        if self.has-hover {
                                            root.hovered-bin = bin.label;
                                        } else if root.hovered-bin == bin.label {
                                            root.hovered-bin = "";
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // The bins run left to right in every language.
                    HorizontalLayout {
                        Label { text: root.histogram-lo; horizontal-alignment: left; }
                        Label {
                            text: root.hovered-bin;
                            horizontal-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Label { text: root.histogram-hi; horizontal-alignment: right; }
                    }
                }

                if root.stats-text != "": Label { text: root.stats-text; }

                if root.hot-regions.length > 0: Text {
                    text: @tr("Highest-error regions");
                    color: Theme.text-primary;
                    font-size: 12px;
                    font-weight: 600;
                    wrap: word-wrap;
                    horizontal-alignment: Direction.start;
                }

                for region in root.hot-regions: RegionRow {
                    region: region;
                    clicked => { root.jump-to-region(region.id); }
                    hovered(on) => { root.hover-region(on ? region.id : ""); }
                }

                HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        horizontal-stretch: 0;
                        preferred-width: max(110px, self.natural-width);
                        text: @tr("Export CSV…");
                        enabled: root.can-export;
                        clicked => { root.export-csv(); }
                    }
                }

                // Translators: the intended use: keep its meaning exactly
                Note { text: @tr("Research use only; not for diagnosis."); }
            }

            Rectangle { height: 1px; background: Theme.border; }

            // ---------------------------------------------------------- Cache
            SectionHeader {
                // Translators: the section about eovae's stored results
                title: @tr("Cache");
                summary: root.cache-text;
                expanded: root.cache-expanded;
                toggled => {
                    root.cache-expanded = !root.cache-expanded;
                    root.section-toggled("cache", root.cache-expanded);
                }
            }

            if root.cache-expanded: VerticalLayout {
                padding-left: 12px;
                spacing: 6px;

                Label { text: root.cache-text; }
                Label { text: root.memory-text; }
                if root.cache-error != "": Note { text: root.cache-error; error: true; }

                CheckRow {
                    text: @tr("Keep reconstructions on disk (large)");
                    enabled: root.cache-enabled;
                    checked <=> root.keep-pixels;
                    toggled(checked) => { root.keep-pixels-toggled(checked); }
                }

                HorizontalLayout {
                    alignment: start;
                    ActionButton {
                        horizontal-stretch: 0;
                        preferred-width: max(110px, self.natural-width);
                        text: @tr("Clear cache…");
                        enabled: root.cache-enabled;
                        clicked => { root.clear-cache(); }
                    }
                }
            }
        }
    }
}
