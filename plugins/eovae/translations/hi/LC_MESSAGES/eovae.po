msgid_plural ""
"{n} image outputs; using '{name}' (change it in the Model section)."
msgstr[0] "{n} छवि आउटपुट; '{name}' का उपयोग हो रहा है (इसे मॉडल अनुभाग में बदलें)।"
msgstr[1] "{n} छवि आउटपुट; '{name}' का उपयोग हो रहा है (इसे मॉडल अनुभाग में बदलें)।"

#: src/model.rs:183
msgid "Model metadata: {}."
msgstr "मॉडल मेटाडेटा: {}।"

#. Translators: the sidecar is a model's <model>.eovae.json file
#: src/model.rs:185
msgid "Sidecar: {}."
msgstr "साइडकार: {}।"

#: src/model.rs:187
msgid "Ignored {}: the sidecar must be a JSON object."
msgstr "{} को अनदेखा किया गया: साइडकार एक JSON ऑब्जेक्ट होना चाहिए।"

#: src/model.rs:191
msgid "Ignored {file}: {error}."
msgstr "{file} को अनदेखा किया गया: {error}।"

#: src/model.rs:196
msgid ""
"The model does not declare the resolution it was trained at (eovae.mpp); "
"errors depend on the level you choose."
msgstr ""
"मॉडल यह घोषित नहीं करता कि उसे किस रिज़ॉल्यूशन पर प्रशिक्षित किया गया था (eovae."
"mpp); त्रुटियाँ आपके चुने गए स्तर पर निर्भर करती हैं।"

#. Translators: "Preprocessing" is the sidebar's section of that name
#: src/model.rs:200
msgid ""
"No preprocessing declared: using HistoVAE's ([-1, 1], alpha on white). Check "
