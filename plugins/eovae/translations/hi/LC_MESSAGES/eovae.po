msgid ""
"the model needs {n} input ({names}); eovae feeds exactly one image input"
msgid_plural ""
"the model needs {n} inputs ({names}); eovae feeds exactly one image input"
msgstr[0] "मॉडल को {n} इनपुट ({names}) चाहिए; eovae ठीक एक छवि इनपुट देता है"
msgstr[1] "मॉडल को {n} इनपुट ({names}) चाहिए; eovae ठीक एक छवि इनपुट देता है"

#: src/model.rs:398
