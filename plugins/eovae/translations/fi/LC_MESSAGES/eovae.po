msgid "allow TF32 on CUDA (faster, slightly different results)"
msgstr "salli TF32 CUDA:ssa (nopeampi, hieman erilaiset tulokset)"

#. Translators: a batch parameter: keep auto, the value typed
#: src/batch.rs:126
msgid ""
"auto (tiles resampled to the model's µm/px) or a downsample, e.g. 4 (that "
"level's own pixels)"
msgstr ""
"auto (tiilet uudelleennäytteistetään mallin µm/px-arvoon) tai "
"pienennyskerroin, esim. 4 (kyseisen tason omat pikselit)"

#: src/batch.rs:132
msgid "skip glass tiles"
