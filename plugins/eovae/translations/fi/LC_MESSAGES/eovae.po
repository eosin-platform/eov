#: plugin.toml
msgctxt "plugin.toml"
msgid "EOV VAE"
msgstr "EOV VAE"

#: plugin.toml
msgctxt "plugin.toml"
msgid ""
"Reconstruction-error analysis with ONNX VAE models, showing how unlike the "
"training data the tissue looks: heat maps, reconstructions, error statistics "
"and highest-error regions. Research use only; not for diagnosis."
msgstr ""
"Rekonstruktiovirheanalyysi ONNX-muotoisilla VAE-malleilla. Näyttää, kuinka "
"paljon kudos poikkeaa opetusaineistosta: lämpökartat, rekonstruktiot, "
"virhetilastot ja suurimman virheen alueet. Vain tutkimuskäyttöön; ei saa "
"käyttää diagnostiikkaan."

#: src/batch.rs:89
msgid ""
"VAE reconstruction error of every tissue tile: tiles.csv, heatmap.png and "
"summary.json per slide"
msgstr ""
"Jokaisen kudostiilen VAE-rekonstruktiovirhe: tiles.csv, heatmap.png ja "
"summary.json näytelasia kohden"

#: src/batch.rs:94
msgid "the ONNX model (default: the one chosen in eov's VAE sidebar)"
msgstr "ONNX-malli (oletus: eov:n VAE-sivupalkissa valittu malli)"

#. Translators: a batch parameter: keep auto, cpu and cuda, the values typed
#: src/batch.rs:104
msgid "auto (CUDA, else the CPU), cpu or cuda"
msgstr "auto (CUDA, muuten CPU), cpu tai cuda"

#: src/batch.rs:109
msgid "tiles per inference batch, for models without a fixed batch"
msgstr "tiiliä päättelyerää kohden malleille, joilla ei ole kiinteää eräkokoa"

#: src/batch.rs:114
msgid "CPU inference threads (0: every core)"
msgstr "CPU-päättelyn säikeet (0: kaikki ytimet)"

