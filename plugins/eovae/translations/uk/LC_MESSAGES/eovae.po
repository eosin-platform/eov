msgstr "Авто: {mpp} моделі = рівень {level}"

#. Translators: a resolution choice
#: src/sidebar.rs:548
msgid "Auto (level 0)"
msgstr "Авто (рівень 0)"

#. Translators: a level of the slide's pyramid, in the resolution choices
#: src/sidebar.rs:558
msgid "Level {}"
msgstr "Рівень {}"

#. Translators: {mpp} and {model} are resolutions like "0.227 µm/px"
#: src/sidebar.rs:589
msgid ""
"The slide's finest level is {mpp}, coarser than the model's {model}: tiles "
"are interpolated and errors will be inflated."
msgstr ""
"Роздільна здатність найдетальнішого рівня препарату — {mpp}, нижча, ніж у "
"моделі ({model}): фрагменти інтерполюються, тож похибки будуть завищені."

#. Translators: {mpp} and {model} are resolutions like "0.23 µm/px"
#: src/sidebar.rs:598
msgid ""
"Level {level} is {mpp} but the model was trained at {model}; errors will be "
"inflated."
msgstr ""
"Рівень {level} має {mpp}, а модель навчено на {model}; похибки будуть "
"завищені."

#. Translators: {mpp} and {model} are resolutions like "0.227 µm/px"
#: src/sidebar.rs:608
msgid ""
"Tiles are read from level {level} ({mpp}) and resampled to the model's "
"{model}."
msgstr ""
"Фрагменти читаються з рівня {level} ({mpp}) і передискретизуються до {model} "
"моделі."

#. Translators: {mpp} and {model} are resolutions like "0.23 µm/px"
#: src/sidebar.rs:619
msgid "Level {level} at {mpp} (model {model})."
msgstr "Рівень {level}: {mpp} (модель {model})."

#. Translators: {mpp} is a resolution like "0.23 µm/px"
#: src/sidebar.rs:626
msgid "Level {level} at {mpp}."
msgstr "Рівень {level}: {mpp}."

#: src/sidebar.rs:631
msgid "Level {} (the slide is not calibrated)."
msgstr "Рівень {} (препарат не відкалібровано)."

#: src/sidebar.rs:642 ui/eovae-sidebar.slint:749
msgctxt "Resolution"
msgid "Auto"
msgstr "Авто"

